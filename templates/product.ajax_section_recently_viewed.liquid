{% layout none %}
{%- comment -%}
  Recently viewed card fragment — live product data only, shared mm-product-card.
{%- endcomment -%}
{%- if product != blank and product.published_at != blank -%}
  <div class="product mm-pdp-reco-grid__item" data-mm-rv-handle="{{ product.handle | escape }}">
    {% render 'mm-product-card',
      product: product,
      section_id: 'recently-viewed'
    %}
  </div>
{%- endif -%}
