{%- comment -%}
  Short description only: dedicated metafield. Do not fall back to full
  product.description (avoids duplicate copy with the Description tab).
{%- endcomment -%}
{%- liquid
    assign desc = product.metafields.c_f.short_description
    assign fontsize_text = block.settings.fontsize_text
    assign color_text = block.settings.color_text
-%}
{%- if desc != blank -%}
    <div class="productView-desc halo-text-format"
        style="--color-text: {{ color_text }};
        --fontsize-text: {{ fontsize_text | append: 'px' }}"
    >
        {{ desc | newline_to_br }}
    </div>
{%- endif -%}