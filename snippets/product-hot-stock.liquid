{%- liquid
    assign hot_stock_style = block.settings.hot_stock_style
    assign spacing_top = block.settings.spacing_top
    assign spacing_bottom = block.settings.spacing_bottom
    assign color_text = block.settings.color_text

    assign inventory_qty = current_variant.inventory_quantity | default: 0 | plus: 0
    assign has_tracked_stock = false
    if current_variant.inventory_management != blank
      assign has_tracked_stock = true
    endif

    # Only show scarcity when inventory is tracked AND a real positive quantity is known.
    if has_tracked_stock and inventory_qty > 0 and inventory_qty <= productMaxStock
        assign check_show_hot_stock = true
    else
        assign check_show_hot_stock = false
    endif
-%}

<div class="productView-moreItem{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}"
    style="--spacing-top: {{ spacing_top | append: 'px' }};
    --spacing-bottom: {{ spacing_bottom | append: 'px' }};
    --color-text: {{ color_text }}"
>
    <div class="productView-hotStock style-{{ hot_stock_style }}{% unless check_show_hot_stock %} is-hide{% endunless %}" data-hot-stock="{{ productMaxStock }}" {{variantCount}} {% if variantCount < 2 and check_show_hot_stock %} data-current-inventory="{{ inventory_qty }}"{% endif %}>
        {%- if check_show_hot_stock -%}
            {%- if hot_stock_style == '2' -%}
                <span class="hotStock-text">
                    {{ 'products.product.hot_stock_2' | t : inventory: inventory_qty }}
                </span>
                <div class="hotStock-progress">
                    <span class="hotStock-progress-item"></span>
                </div>
            {%- else -%}
                <span class="hotStock-text">
                    {{ 'products.product.hot_stock' | t : inventory: inventory_qty }}
                </span>
            {%- endif -%}
        {%- else -%}
            <span class="hotStock-text" hidden></span>
        {%- endif -%}
    </div>
</div>
