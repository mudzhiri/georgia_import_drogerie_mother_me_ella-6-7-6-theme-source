{%- comment -%}
  Supported sort options with Georgian locale labels.
  Accepts: sort_options, sort_by
{%- endcomment -%}
{%- comment -%}
  Georgian sort set. best-selling = Shopify sales order. created-ascending omitted.
{%- endcomment -%}
{%- liquid
  assign allowed = 'manual,best-selling,title-ascending,title-descending,price-ascending,price-descending,created-descending,relevance' | split: ','
-%}
{%- for option in sort_options -%}
  {%- if allowed contains option.value -%}
    {%- liquid
      assign sort_label = option.name
      case option.value
        when 'manual'
          assign sort_label = 'sections.collection_template.sort_options.manual' | t
        when 'best-selling'
          assign sort_label = 'sections.collection_template.sort_options.best-selling' | t
        when 'title-ascending'
          assign sort_label = 'sections.collection_template.sort_options.title-ascending' | t
        when 'title-descending'
          assign sort_label = 'sections.collection_template.sort_options.title-descending' | t
        when 'price-ascending'
          assign sort_label = 'sections.collection_template.sort_options.price-ascending' | t
        when 'price-descending'
          assign sort_label = 'sections.collection_template.sort_options.price-descending' | t
        when 'created-ascending'
          assign sort_label = 'sections.collection_template.sort_options.created-ascending' | t
        when 'created-descending'
          assign sort_label = 'sections.collection_template.sort_options.created-descending' | t
        when 'relevance'
          assign sort_label = 'sections.collection_template.sort_options.relevance' | t
      endcase
    -%}
    <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>
      {{ sort_label | escape }}
    </option>
  {%- endif -%}
{%- endfor -%}
