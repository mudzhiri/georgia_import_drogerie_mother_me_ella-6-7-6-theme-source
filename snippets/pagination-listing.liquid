{% comment %}
    Renders a set of links for paginated results. Must be used within paginate tags.

    Usage:
    {% paginate results by 2 %}
        {% render 'pagination', paginate: paginate, anchor: '#yourID' %}
    {% endpaginate %}

    Accepts:
    - paginate: {Object}
    - anchor: {String} (optional) This can be added so that on page reload it takes you to wherever you've placed your anchor tag.
    - class: {String} (optional) Appended to container element's class attribute
{% endcomment %}

{{ 'component-pagination.css' | asset_url | stylesheet_tag }}
{%- if show_infinite_scrolling == 'show_more' or show_infinite_scrolling == 'infinite' -%}
  {{ 'mm-load-more.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if paginate.parts.size > 0 -%}
    {%- liquid
      assign mm_shown_count = paginate.current_offset | plus: paginate.page_size
      if mm_shown_count > paginate.items or paginate.next == nil
        assign mm_shown_count = paginate.items
      endif
      # Infinite/load-more accumulates from page 1 — never show a trailing-page slice as the start.
      if show_infinite_scrolling == 'show_more' or show_infinite_scrolling == 'infinite'
        if paginate.current_page == 1
          assign mm_visible_for_label = mm_shown_count
        else
          # Server render of page 2+ alone is rare for infinite UI; still cap at total.
          assign mm_visible_for_label = mm_shown_count
        endif
      else
        assign mm_visible_for_label = mm_shown_count
      endif
    -%}
    <div class="{{ class | default: 'pagination-wrapper' }}{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}">
        <nav class="pagination style--{{ settings.pagination_style }} text-{{ settings.pagination_align }}{% if show_infinite_scrolling == 'infinite' %} pagination-infinite style-{{ settings.infinite_scroll_style }}{% endif %}" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
            <div
              class="pagination-page-item pagination-page-total"
              data-mm-total-items="{{ paginate.items }}"
              data-mm-count-template="{{ 'sections.collection_template.showing_of_total' | t: shown: '__SHOWN__', total: '__TOTAL__' | escape }}"
            >
                {%- if show_infinite_scrolling == 'show_more' or show_infinite_scrolling == 'infinite' -%}
                  <span data-mm-count-label>
                    {{ 'sections.collection_template.showing_of_total' | t: shown: mm_visible_for_label, total: paginate.items }}
                  </span>
                  <span class="visually-hidden">
                    <span data-total-start>1</span>
                    <span data-total-end>{{ mm_visible_for_label }}</span>
                  </span>
                {%- else -%}
                  <span>{{ 'sections.collection_template.start_count' | t }}</span>
                  <span data-total-start>{{ paginate.current_offset | plus: 1 }}</span>
                  <span>-</span>
                  {%- if paginate.next -%}
                      <span data-total-end>{{ paginate.current_offset | plus: paginate.page_size }}</span>
                  {%- else -%}
                      <span data-total-end>{{ paginate.items }}</span>
                  {%- endif -%}
                  <span>{{ 'sections.collection_template.end_count' | t : count : paginate.items }}</span>
                {%- endif -%}
                {%- if paginate.next -%}
                    {% liquid
                        assign pg_current = paginate.current_offset | plus: paginate.page_size
                        assign pg_total = paginate.items
                        assign total_progress = pg_current | times: 100 | divided_by: pg_total | append: '%'
                    %}
                {%- else -%}
                    {%- assign total_progress = '100%' -%}
                {%- endif -%}
                <div class="pagination-total-progress">
                    <span style="width: {{ total_progress }}" class="pagination-total-item"></span>
                </div>
            </div>
            {%- if show_infinite_scrolling == 'show_more' or show_infinite_scrolling == 'infinite' -%}
                {%- if paginate.next -%}
                    <div class="pagination-page-item pagination-page-infinite mm-load-more-wrap">
                        <a
                            class="mm-load-more"
                            href="{{ paginate.next.url }}"
                            data-href="{{ paginate.next.url }}"
                            data-infinite-scrolling
                            data-load-more="{{ 'sections.collection_template.show_more' | t | escape }}"
                            data-loading-more="{{ 'sections.collection_template.loading_more' | t | escape }}"
                            aria-busy="false"
                        >
                            <span class="mm-load-more__spinner" aria-hidden="true"></span>
                            <span class="mm-load-more__label">{{ 'sections.collection_template.show_more' | t }}</span>
                        </a>
                        <p class="mm-load-more__error" data-mm-load-more-error hidden role="alert"></p>
                        <button type="button" class="mm-load-more__retry" data-mm-load-more-retry hidden>
                            {{ 'sections.collection_template.load_retry' | t }}
                        </button>
                        <p class="visually-hidden" data-mm-load-more-status aria-live="polite" aria-atomic="true"></p>
                    </div>
                {%- endif -%}
            {%-else -%}
                <ul class="pagination__list list-unstyled" role="list">
                    {%- if paginate.previous -%}
                    <li class="pagination-arrow">
                        <a href="{{ paginate.previous.url }}{{ anchor }}" class="pagination__item pagination__item--prev pagination__item-arrow link motion-reduce" aria-label="{{ 'general.pagination.previous' | t }}">
                            {% if settings.pagination_style == '3' %}
                            {% render 'icon-arrow-left' %}
                            {% else %}
                            {% render 'icon-caret' %}
                            {% if settings.pagination_style == '1' %}
                            <span class="arrow-text">{{ 'general.pagination.prev' | t}}</span>
                            {% endif %}
                            {% endif %}
                        </a>
                    </li>
                    {%- endif -%}
                    {%- for part in paginate.parts -%}
                    <li class="pagination-num">
                        {%- if part.is_link -%}
                        <a href="{{ part.url }}{{ anchor }}" class="pagination__item link" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</a>
                        {%- else -%}
                        {%- if part.title == paginate.current_page -%}
                        <span class="pagination__item pagination__item--current" aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</span>
                        {%- else -%}
                        <span class="pagination__item">{{ part.title }}</span>
                        {%- endif -%}
                        {%- endif -%}
                    </li>
                    {%- endfor -%}
                    {%- if paginate.next -%}
                    <li class="pagination-arrow">
                        <a href="{{ paginate.next.url }}{{ anchor }}" class="pagination__item pagination__item--next pagination__item-arrow link motion-reduce" aria-label="{{ 'general.pagination.next' | t }}">
                            {% if settings.pagination_style == '3' %}
                            {% render 'icon-arrow-left' %}
                            {% else %}
                            {% if settings.pagination_style == '1' %}
                            <span class="arrow-text">{{ 'general.pagination.next' | t}}</span>
                            {% endif %}
                            {% render 'icon-caret' %}
                            {% endif %}
                        </a>
                    </li>
                    {%- endif -%}
                </ul>
            {%- endif -%}
        </nav>
    </div>
{%- endif -%}
