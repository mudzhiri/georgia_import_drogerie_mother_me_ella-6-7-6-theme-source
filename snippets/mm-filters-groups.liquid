{%- comment -%}
  Shared filter groups for desktop toolbar + mobile drawer.
  Accepts: filter_list, section, id_prefix, uses_comma_decimals, shop_money_format, results_count
  Shows only groups Shopify Search & Discovery actually exposes (no fake filters).
{%- endcomment -%}
{%- for filter in filter_list -%}
  {%- liquid
    assign filter_label = filter.label
    assign filter_param = filter.param_name | downcase
    assign is_availability = false
    assign is_vendor = false
    assign is_product_type = false
    assign is_age = false

    if filter_param contains 'availability' or filter.label == 'Availability'
      assign is_availability = true
      assign filter_label = 'sections.collection_template.availability' | t
    elsif filter_param contains 'vendor' or filter.label == 'Brand' or filter.label == 'Vendor' or filter.label == 'ბრენდი'
      assign is_vendor = true
      assign filter_label = 'sections.collection_template.filter_brand' | t
    elsif filter_param contains 'product_type' or filter_param contains 'product-type' or filter.label == 'Product type' or filter.label == 'Type' or filter.label == 'კატეგორია' or filter.label == 'პროდუქტის სახეობა'
      assign is_product_type = true
      assign filter_label = 'sections.collection_template.filter_product_type' | t
    elsif filter_param contains 'age' or filter.label == 'Age' or filter.label == 'ასაკი' or filter.label contains 'ასაკ'
      assign is_age = true
      assign filter_label = 'sections.collection_template.filter_age' | t
    endif

    assign show_filter_group = false
    assign visible_values = 0
    assign active_in_group = 0
    assign sorted_values = filter.values

    if filter.type == 'list' or filter.type == 'boolean'
      if is_vendor
        assign sorted_values = filter.values | sort: 'label'
      endif
    endif

    if filter.type == 'price_range'
      if filter.range_max != blank
        assign show_filter_group = true
      endif
      assign filter_label = 'sections.collection_template.price' | t
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_in_group = 1
      endif
    elsif is_availability
      # Availability is not offered in the customer toolbar.
      assign show_filter_group = false
    elsif filter.type == 'list' or filter.type == 'boolean'
      for value in sorted_values
        if value.count == 0 and value.active == false
          continue
        endif
        assign visible_values = visible_values | plus: 1
        if value.active
          assign active_in_group = active_in_group | plus: 1
        endif
      endfor

      if visible_values >= 2
        assign show_filter_group = true
      elsif visible_values == 1 and active_in_group > 0
        assign show_filter_group = true
      elsif visible_values == 1 and results_count != blank
        assign sole_count = 0
        for value in sorted_values
          if value.count == 0 and value.active == false
            continue
          endif
          assign sole_count = value.count
        endfor
        if sole_count > 0 and sole_count < results_count
          assign show_filter_group = true
        endif
      endif
    endif

    assign group_open = false
    if active_in_group > 0
      assign group_open = true
    endif

    assign show_list_search = false
    if visible_values > 6
      if is_vendor or is_product_type
        assign show_list_search = true
      endif
    endif
  -%}

  {%- if show_filter_group -%}
    <details
      class="mm-filters__group{% if is_vendor %} mm-filters__group--vendor{% endif %}{% if is_product_type %} mm-filters__group--type{% endif %}{% if is_age %} mm-filters__group--age{% endif %}"
      data-mm-filter-group
      data-mm-filter-param="{{ filter.param_name | escape }}"
      {% if is_vendor %}data-mm-filter-kind="vendor"{% endif %}
      {% if is_product_type %}data-mm-filter-kind="product_type"{% endif %}
      {% if is_age %}data-mm-filter-kind="age"{% endif %}
      {% if group_open %}open{% endif %}
    >
      <summary class="mm-filters__group-summary">
        <span class="mm-filters__group-label">{{ filter_label | escape }}</span>
        {%- if active_in_group > 0 -%}
          <span class="mm-filters__group-active" data-mm-group-active aria-hidden="true">{{ active_in_group }}</span>
        {%- endif -%}
        <span class="mm-filters__group-chevron" aria-hidden="true"></span>
      </summary>

      <div class="mm-filters__group-body">
        {%- case filter.type -%}
          {%- when 'list', 'boolean' -%}
            {%- if show_list_search -%}
              <label class="visually-hidden" for="{{ id_prefix }}-search-{{ section.id }}-{{ forloop.index }}">
                {%- if is_vendor -%}
                  {{ 'sections.collection_template.filter_search_brand' | t }}
                {%- else -%}
                  {{ filter_label | escape }}
                {%- endif -%}
              </label>
              <input
                id="{{ id_prefix }}-search-{{ section.id }}-{{ forloop.index }}"
                type="search"
                class="mm-filters__group-search"
                data-mm-filter-search
                placeholder="{% if is_vendor %}{{ 'sections.collection_template.filter_search_brand' | t | escape }}{% else %}{{ filter_label | escape }}{% endif %}"
                autocomplete="off"
              >
            {%- endif -%}
            <ul class="mm-filters__options" role="list">
              {%- for value in sorted_values -%}
                {%- if value.count == 0 and value.active == false -%}
                  {%- continue -%}
                {%- endif -%}
                <li data-mm-filter-option data-mm-filter-label="{{ value.label | downcase | escape }}">
                  <label class="mm-filters__option">
                    <input
                      type="checkbox"
                      name="{{ value.param_name }}"
                      value="{{ value.value }}"
                      {% if value.active %}checked{% endif %}
                    >
                    <span class="mm-filters__option-text">
                      <span class="mm-filters__option-name">{{ value.label | escape }}</span>
                      {%- if value.count -%}
                        <span class="mm-filters__option-count" aria-hidden="true">{{ value.count }}</span>
                      {%- endif -%}
                    </span>
                  </label>
                </li>
              {%- endfor -%}
            </ul>
            <div class="mm-filters__group-actions">
              <button type="submit" class="mm-filters__btn mm-filters__btn--primary mm-filters__btn--apply">
                {{ 'sections.collection_template.filter_apply' | t }}
              </button>
            </div>
          {%- when 'price_range' -%}
            {%- render 'mm-filters-price-fields',
              filter: filter,
              section: section,
              id_prefix: id_prefix,
              uses_comma_decimals: uses_comma_decimals,
              shop_money_format: shop_money_format
            -%}
            <div class="mm-filters__group-actions">
              <button type="submit" class="mm-filters__btn mm-filters__btn--primary mm-filters__btn--apply">
                {{ 'sections.collection_template.filter_apply' | t }}
              </button>
            </div>
        {%- endcase -%}
      </div>
    </details>
  {%- endif -%}
{%- endfor -%}
