{%- comment -%}
  MOTHER & ME product card — homepage, shared structure with collection cards.
  Accepts: product {Object}, section_id {String}
{%- endcomment -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign sold_out = false
  if product.available == false
    assign sold_out = true
  endif

  assign image = blank
  for media in product.media
    if media.media_type == 'image'
      assign image = media
      break
    endif
  endfor
  if image == blank and product.featured_image
    assign image = product.featured_image
  endif

  assign price = variant.price
  assign compare_at = variant.compare_at_price

  assign mm_image_count = 0
  for media in product.media
    if media.media_type == 'image'
      assign mm_image_count = mm_image_count | plus: 1
    endif
  endfor

  assign mm_prev_label = 'general.pagination.previous' | t
  assign mm_next_label = 'general.pagination.next' | t
-%}

<article
  class="mm-product-card product-item{% if sold_out %} mm-product-card--sold-out{% endif %}"
  data-product-id="{{ product.id }}"
  data-mm-product-card
>
  <div
    class="mm-product-card__media-wrap mm-card-media{% if mm_image_count > 1 %} mm-card-media--multi{% endif %}"
    {% if mm_image_count > 1 %}
      data-mm-card-gallery
      data-mm-gallery-index="0"
      data-mm-images='{% render 'mm-card-gallery-data', product: product %}'
    {% endif %}
  >
    <a
      class="mm-product-card__media mm-card-media__link"
      href="{{ product.url }}"
      aria-label="{{ product.title | escape }}"
    >
      {%- if image != blank -%}
        {{
          image
          | image_url: width: 800
          | image_tag:
            loading: 'lazy',
            widths: '200, 300, 400, 600, 800',
            sizes: '(min-width: 900px) 25vw, 50vw',
            class: 'mm-product-card__image mm-card-media__image',
            alt: product.title
        }}
      {%- else -%}
        <span class="mm-product-card__image-placeholder" aria-hidden="true"></span>
      {%- endif -%}
    </a>

    {% render 'mm-product-badges', product: product, badge_detail: false %}
    <div class="mm-card-actions">
      {% render 'mm-card-wishlist-btn', product: product %}
      {% render 'mm-card-share-btn', product: product %}
    </div>

    {%- if mm_image_count > 1 -%}
      <button
        type="button"
        class="mm-card-media__nav mm-card-media__nav--prev"
        data-mm-gallery-prev
        aria-label="{{ mm_prev_label | escape }}"
      >
        <span aria-hidden="true">‹</span>
      </button>
      <button
        type="button"
        class="mm-card-media__nav mm-card-media__nav--next"
        data-mm-gallery-next
        aria-label="{{ mm_next_label | escape }}"
      >
        <span aria-hidden="true">›</span>
      </button>
      <div class="mm-card-media__dots" data-mm-gallery-dots aria-hidden="true"></div>
      <span class="visually-hidden" data-mm-gallery-status aria-live="polite"></span>
    {%- endif -%}
  </div>

  <div class="mm-product-card__body">
    {% render 'mm-card-title-text',
      product: product,
      url: product.url,
      title_class: 'mm-product-card__title-link',
      vendor_class: 'mm-product-card__vendor'
    %}

    <div class="mm-product-card__price">
      {%- if compare_at != blank and compare_at > price -%}
        <span class="mm-product-card__price-sale">{{ price | money }}</span>
        <s class="mm-product-card__price-compare">{{ compare_at | money }}</s>
      {%- else -%}
        <span class="mm-product-card__price-regular">{{ price | money }}</span>
      {%- endif -%}
    </div>

    {% render 'mm-card-atc', product: product, section_id: section_id %}
  </div>
</article>
