{%- comment -%}
  MOTHER & ME product card for the homepage MM Products section only.
  Accepts: product {Object}, section_id {String}
{%- endcomment -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign sold_out = false
  if product.available == false
    assign sold_out = true
  endif

  assign needs_selection = false
  if product.has_only_default_variant == false
    assign needs_selection = true
  endif

  assign image = product.featured_media
  if image == blank and product.featured_image
    assign image = product.featured_image
  endif

  assign price = variant.price
  assign compare_at = variant.compare_at_price

  assign label_add = 'products.product.add_to_cart' | t
  assign label_adding = 'products.product.adding_to_cart' | t
  assign label_added = 'products.product.added_to_cart' | t
  assign label_error = 'general.cart.cart_error' | t
  assign label_sold_out = 'products.product.sold_out' | t
  assign label_select = 'products.product.select_variant' | t
-%}

<article
  class="mm-product-card product-item{% if sold_out %} mm-product-card--sold-out{% endif %}"
  data-product-id="{{ product.id }}"
>
  <a class="mm-product-card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- if image != blank -%}
      {{
        image
        | image_url: width: 800
        | image_tag:
          loading: 'lazy',
          widths: '200, 300, 400, 600, 800',
          sizes: '(min-width: 900px) 25vw, 50vw',
          class: 'mm-product-card__image',
          alt: product.title
      }}
    {%- else -%}
      <span class="mm-product-card__image-placeholder" aria-hidden="true"></span>
    {%- endif -%}

    {%- if sold_out -%}
      <span class="mm-product-card__badge">{{ label_sold_out }}</span>
    {%- endif -%}
  </a>

  <div class="mm-product-card__body">
    {%- if product.vendor != blank -%}
      <p class="mm-product-card__vendor">{{ product.vendor | escape }}</p>
    {%- endif -%}

    <h3 class="mm-product-card__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </h3>

    <div class="mm-product-card__price">
      {%- if compare_at != blank and compare_at > price -%}
        <span class="mm-product-card__price-sale">{{ price | money }}</span>
        <s class="mm-product-card__price-compare">{{ compare_at | money }}</s>
      {%- else -%}
        <span class="mm-product-card__price-regular">{{ price | money }}</span>
      {%- endif -%}
    </div>

    <div class="mm-product-card__actions">
      {%- if sold_out -%}
        <button
          type="button"
          class="mm-product-card__btn mm-product-card__btn--disabled"
          disabled
          aria-disabled="true"
        >
          {{ label_sold_out }}
        </button>
      {%- elsif needs_selection -%}
        <a
          class="mm-product-card__btn"
          href="{{ product.url }}"
        >
          {{ label_select }}
        </a>
      {%- else -%}
        <form
          action="{{ routes.cart_add_url }}"
          method="post"
          enctype="multipart/form-data"
          class="mm-product-card__form"
          data-mm-product-form
          data-product-id="{{ product.id }}"
        >
          <input type="hidden" name="id" value="{{ variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button
            type="submit"
            name="add"
            class="mm-product-card__btn"
            data-mm-add-to-cart
            data-label-add="{{ label_add | escape }}"
            data-label-adding="{{ label_adding | escape }}"
            data-label-added="{{ label_added | escape }}"
            data-label-error="{{ label_error | escape }}"
          >
            <span class="mm-product-card__btn-spinner" aria-hidden="true"></span>
            <span class="mm-product-card__btn-label">{{ label_add }}</span>
          </button>
        </form>
        <p class="mm-product-card__error" data-mm-card-error role="alert" hidden></p>
      {%- endif -%}
    </div>
  </div>
</article>
