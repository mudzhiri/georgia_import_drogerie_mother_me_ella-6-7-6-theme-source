{% comment %}
  Compact PDP shipping note under the buy button.
  Only confirmed flat rate from the live shipping policy / SETUP (8 GEL).
  Free-shipping thresholds are shown only when theme + policy both confirm them.
{% endcomment %}
{%- liquid
  assign mm_policy = shop.shipping_policy
  assign mm_flat_cents = 800
  assign mm_flat_price = mm_flat_cents | money
  assign mm_show_free_threshold = false
  assign mm_free_threshold_price = blank

  comment
    Live shipping policy confirms Georgia delivery at 8 GEL.
    It does not mention free shipping over 200 GEL.
    Theme free-shipping calculator threshold is also unset.
    Keep mm_show_free_threshold false until both agree.
  endcomment
-%}

{%- if mm_policy != blank and mm_policy.url != blank -%}
  {{ 'mm-product-shipping-note.css' | asset_url | stylesheet_tag }}
  <p class="mm-product-shipping-note" data-mm-shipping-note>
    <span class="mm-product-shipping-note__icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" focusable="false">
        <path d="M3 7.5h11.5v9H8.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M14.5 10.5H19l2 3v3h-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="7" cy="17.5" r="1.75" stroke="currentColor" stroke-width="1.5"/>
        <circle cx="17.25" cy="17.5" r="1.75" stroke="currentColor" stroke-width="1.5"/>
      </svg>
    </span>
    <span class="mm-product-shipping-note__text">
      {%- if mm_show_free_threshold -%}
        {{ 'products.product.shipping_note.text_with_free_html' | t: price: mm_flat_price, threshold: mm_free_threshold_price, link: mm_policy.url, policy: mm_policy.title }}
      {%- else -%}
        {{ 'products.product.shipping_note.text_html' | t: price: mm_flat_price, link: mm_policy.url, policy: mm_policy.title }}
      {%- endif -%}
    </span>
  </p>
{%- endif -%}
