{% comment %}
  PDP trust notes under buy button.
  Aligned to Admin: Georgia delivery 8 GEL active; no free-from-200 rate.
  Bank Deposit not configured — do not promise bank-transfer details here.
{% endcomment %}
{{ 'mm-product-shipping-note.css' | asset_url | stylesheet_tag }}

<ul class="mm-pdp-trust" data-mm-pdp-trust role="list">
  <li class="mm-pdp-trust__item">
    <span class="mm-pdp-trust__icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" focusable="false">
        <path d="M3 7.5h11.5v9H8.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M14.5 10.5H19l2 3v3h-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="7" cy="17.5" r="1.75" stroke="currentColor" stroke-width="1.5"/>
        <circle cx="17.25" cy="17.5" r="1.75" stroke="currentColor" stroke-width="1.5"/>
      </svg>
    </span>
    <span class="mm-pdp-trust__text">{{ 'products.product.trust.free_shipping' | t }}</span>
  </li>
  <li class="mm-pdp-trust__item">
    <span class="mm-pdp-trust__icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" focusable="false">
        <path d="M4 9.5 12 4l8 5.5V20a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
        <path d="M9.5 21v-7h5v7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
    <span class="mm-pdp-trust__text">{{ 'products.product.trust.order_pickup' | t }}</span>
  </li>
  <li class="mm-pdp-trust__item">
    <span class="mm-pdp-trust__icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" focusable="false">
        <rect x="3.5" y="6" width="17" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/>
        <path d="M3.5 10h17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M7 15h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </span>
    <span class="mm-pdp-trust__text">{{ 'products.product.trust.bank_transfer' | t }}</span>
  </li>
</ul>
