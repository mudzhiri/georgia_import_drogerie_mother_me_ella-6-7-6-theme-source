{%- comment -%}
  PDP media overlay: wishlist only (top-right).
  Share lives next to the product title (see product-title / mm-pdp-title-share).
{%- endcomment -%}
{%- liquid
  assign mm_wl_add = 'wishlist.general.add' | t
  assign mm_wl_remove = 'wishlist.general.remove' | t
-%}
<div class="mm-pdp-actions" data-mm-pdp-actions>
  <button
    type="button"
    class="mm-pdp-actions__btn mm-pdp-actions__wishlist"
    data-wishlist
    data-wishlist-handle="{{ product.handle | escape }}"
    data-product-id="{{ product.id }}"
    aria-label="{{ mm_wl_add | escape }}"
    title="{{ mm_wl_add | escape }}"
    aria-pressed="false"
    data-mm-wl-add="{{ mm_wl_add | escape }}"
    data-mm-wl-remove="{{ mm_wl_remove | escape }}"
  >
    <span class="mm-pdp-actions__icon mm-pdp-actions__icon--outline" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" focusable="false">
        <path
          d="M12 20.5S4.5 15.4 4.5 9.9A3.9 3.9 0 0 1 12 7.2a3.9 3.9 0 0 1 7.5 2.7c0 5.5-7.5 10.6-7.5 10.6Z"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linejoin="round"
        />
      </svg>
    </span>
    <span class="mm-pdp-actions__icon mm-pdp-actions__icon--filled" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="26" height="26" focusable="false">
        <path
          d="M12 20.5S4.5 15.4 4.5 9.9A3.9 3.9 0 0 1 12 7.2a3.9 3.9 0 0 1 7.5 2.7c0 5.5-7.5 10.6-7.5 10.6Z"
          fill="currentColor"
        />
      </svg>
    </span>
    <span class="visually-hidden text">{{ mm_wl_add }}</span>
  </button>
</div>
