{%- comment -%}
  Shared responsive image attributes for product cards and theme media.
  Always emits real src + srcset so images work without JavaScript.
  Native loading="lazy|eager" replaces lazysizes data-src / .lazyload opacity hide.
  Optional: sizes, loading, fetchpriority, width, height, class (motion-reduce).
{%- endcomment -%}
{%- if preview_img != blank -%}
{%- liquid
  assign mm_img = preview_img

  assign mm_loading = loading | default: ''
  if mm_loading == blank
    if settings.enable_lazyload
      assign mm_loading = 'lazy'
    else
      assign mm_loading = 'eager'
    endif
  endif

  assign mm_sizes = sizes | default: ''
  if mm_sizes == blank
    assign mm_sizes = '(min-width: 1100px) 320px, (min-width: 750px) calc((100vw - 60px) / 3), calc((100vw - 40px) / 2)'
  endif

  assign mm_w = width | default: mm_img.width
  assign mm_h = height | default: blank
  if mm_h == blank and mm_img.aspect_ratio != blank and mm_img.aspect_ratio != 0
    assign mm_h = mm_w | divided_by: mm_img.aspect_ratio | round
  endif

  assign mm_src = mm_img | image_url: width: 533
  if mm_img.width != blank and mm_img.width < 533
    assign mm_src = mm_img | image_url: width: mm_img.width
  endif

  assign mm_class = ''
  if class
    assign mm_class = 'motion-reduce'
  endif
-%}
src="{{ mm_src }}"
srcset="{%- if mm_img.width >= 165 -%}{{ mm_img | image_url: width: 165 }} 165w{%- endif -%}{%- if mm_img.width >= 360 -%},{{ mm_img | image_url: width: 360 }} 360w{%- endif -%}{%- if mm_img.width >= 533 -%},{{ mm_img | image_url: width: 533 }} 533w{%- endif -%}{%- if mm_img.width >= 720 -%},{{ mm_img | image_url: width: 720 }} 720w{%- endif -%}{%- if mm_img.width >= 900 -%},{{ mm_img | image_url: width: 900 }} 900w{%- endif -%}{%- if mm_img.width >= 1200 -%},{{ mm_img | image_url: width: 1200 }} 1200w{%- endif -%}{%- if mm_img.width != blank and mm_img.width < 165 -%}{{ mm_img | image_url: width: mm_img.width }} {{ mm_img.width }}w{%- endif -%}"
sizes="{{ mm_sizes }}"
{%- if mm_w != blank %} width="{{ mm_w }}"{% endif -%}
{%- if mm_h != blank %} height="{{ mm_h }}"{% endif %}
alt="{{ mm_img.alt | escape }}"
loading="{{ mm_loading }}"
decoding="async"
{%- if fetchpriority != blank %} fetchpriority="{{ fetchpriority }}"{% endif %}
class="{{ mm_class }}"
{%- endif -%}
