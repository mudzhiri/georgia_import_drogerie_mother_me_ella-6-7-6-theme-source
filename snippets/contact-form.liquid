{%- assign contact_form_id = 'ContactForm-' | append: section.id -%}

{%- form 'contact', id: contact_form_id, class: 'contact-form' -%}
    {%- if form.posted_successfully? -%}
        <div class="form-message" data-form-message="contact" role="status" aria-live="polite">
            <div class="alertBox alertBox--success">
                <p class="alertBox-message">
                    {{ 'templates.contact.form.post_success' | t }}
                </p>
            </div>
        </div>
    {%- elsif form.errors -%}
        <div class="form-message" data-form-message="contact" role="alert" aria-live="assertive" tabindex="-1">
            <div class="alertBox alertBox--error">
                <p class="alertBox-message">
                    <ul>
                        {% for field in form.errors %}
                            <li>
                                {%- liquid
                                  assign error_anchor = ''
                                  if field == 'email'
                                    assign error_anchor = 'contactFormEmail-' | append: section.id
                                  elsif field == 'body'
                                    assign error_anchor = 'contactFormMessage-' | append: section.id
                                  elsif field == 'name'
                                    assign error_anchor = 'contactFormName-' | append: section.id
                                  elsif field == 'phone'
                                    assign error_anchor = 'ContactFormPhone-' | append: section.id
                                  endif
                                -%}
                                {%- if error_anchor != blank -%}
                                  <a href="#{{ error_anchor }}">
                                    {{ form.errors.translated_fields[field] | capitalize }} — {{ form.errors.messages[field] }}
                                  </a>
                                {%- else -%}
                                  {{ form.errors.translated_fields[field] | capitalize }} — {{ form.errors.messages[field] }}
                                {%- endif -%}
                            </li>
                        {% endfor %}
                    </ul>
                </p>
            </div>
        </div>
    {%- endif -%}
    <div class="form-field{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}">
        <label class="form-label" for="contactFormName-{{ section.id }}">
            {{ 'templates.contact.form.name' | t }}
        </label>
        <input class="form-input form-input-placeholder"
            type="text"
            id="contactFormName-{{ section.id }}"
            name="contact[name]"
            autocomplete="name"
            autocapitalize="words"
            value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}"
            aria-required="false"
        >
    </div>
    <div class="form-field{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}">
        <label class="form-label" for="ContactFormPhone-{{ section.id }}">
            {{ 'templates.contact.form.phone' | t }}
        </label>
        <input class="form-input form-input-placeholder"
            type="tel"
            id="ContactFormPhone-{{ section.id }}"
            name="contact[phone]"
            autocomplete="tel"
            pattern="[0-9]*"
            value="{% if form.phone %}{{ form.phone | escape }}{% elsif customer %}{{ customer.phone | escape }}{% endif %}"
            aria-required="false"
        >
    </div>
    <div class="form-field{% if form.errors contains "email" %} form-field--error{% endif %}{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}">
        <label class="form-label" for="contactFormEmail-{{ section.id }}">
            {{ 'templates.contact.form.email' | t }} <span class="red-asterisk">*</span>
        </label>
        <input class="form-input form-input-placeholder{% if form.errors contains "email" %} error{% endif %}"
            type="email"
            name="contact[email]"
            id="contactFormEmail-{{ section.id }}"
            spellcheck="false"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"
            aria-required="true"
            {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="ContactForm-email-error-{{ section.id }}"
            {% endif %}
            required
        >
        {%- if form.errors contains 'email' -%}
            <p id="ContactForm-email-error-{{ section.id }}" class="form-field-error">
                {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </p>
        {%- endif -%}
    </div>
    <div class="form-field{% if form.errors contains 'body' %} form-field--error{% endif %}{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}">
        <label class="form-label" for="contactFormMessage-{{ section.id }}">
            {{ 'templates.contact.form.comment' | t }}  <span class="red-asterisk">*</span>
        </label>
        <textarea
            class="form-input form-input-hiddenPlaceholder{% if form.errors contains 'body' %} error{% endif %}"
            rows="8"
            name="contact[body]"
            id="contactFormMessage-{{ section.id }}"
            aria-required="true"
            required
            {% if form.errors contains 'body' %}
                aria-invalid="true"
                aria-describedby="ContactForm-body-error-{{ section.id }}"
            {% endif %}
        >{{- form.body -}}</textarea>
        {%- if form.errors contains 'body' -%}
            <p id="ContactForm-body-error-{{ section.id }}" class="form-field-error" role="alert">
                {{ form.errors.translated_fields.body | capitalize }} {{ form.errors.messages.body }}
            </p>
        {%- endif -%}
    </div>
    <div class="form-actions{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}">
        <input type="submit" class="button button--primary" value="{{ 'templates.contact.form.send' | t }}" role="button" data-button-message="contact">
    </div>
{%- endform -%}
