{%- liquid
  assign mm_card_sizes = sizes | default: '(min-width: 1100px) 280px, (min-width: 750px) calc((100vw - 80px) / 3), calc((100vw - 48px) / 2)'
  # `loading` from product-card is the Ella spinner flag, not HTML loading.
  # Use optional eager: true for above-the-fold cards only.
  assign mm_primary_loading = 'lazy'
  if eager == true
    assign mm_primary_loading = 'eager'
  endif
  # MM gallery cards: first image only (no hover-swap second image)
  assign mm_use_gallery = false
  if mm_gallery == true
    assign mm_use_gallery = true
  endif
-%}
{%- if product_card_product.featured_media -%}
    {%- if variant_img != blank and mm_use_gallery == false -%}
        {%- if settings.quick_shop_type == '2' -%}
            {%- assign width = product_card_product.featured_media.width -%}
            {%- assign height = product_card_product.featured_media.width | divided_by: product_card_product.featured_media.aspect_ratio | round -%}
            <img
              width="{{ width }}"
              height="{{ height }}"
              {% render 'lazyload', preview_img: product_card_product.featured_media, class: true, skip_dimensions: true, sizes: mm_card_sizes, loading: mm_primary_loading, enable_rtl: settings.enable_layout_rtl %}
              onerror="this.setAttribute('data-mm-broken','1'); this.removeAttribute('src'); this.removeAttribute('srcset');"
            >
        {%- else -%}
            {%- assign width = variant_img.width -%}
            {%- assign height = variant_img.width | divided_by: variant_img.aspect_ratio | round -%}
            <img
              width="{{ width }}"
              height="{{ height }}"
              {% render 'lazyload', preview_img: variant_img, class: true, skip_dimensions: true, sizes: mm_card_sizes, loading: mm_primary_loading, enable_rtl: settings.enable_layout_rtl %}
              onerror="this.setAttribute('data-mm-broken','1'); this.removeAttribute('src'); this.removeAttribute('srcset');"
            >
        {%- endif -%}
    {%- else -%}
        {%- assign width = product_card_product.featured_media.width -%}
        {%- assign height = product_card_product.featured_media.width | divided_by: product_card_product.featured_media.aspect_ratio | round -%}
        <img
          width="{{ width }}"
          height="{{ height }}"
          {% render 'lazyload', preview_img: product_card_product.featured_media, class: true, skip_dimensions: true, sizes: mm_card_sizes, loading: mm_primary_loading, enable_rtl: settings.enable_layout_rtl %}
          onerror="this.setAttribute('data-mm-broken','1'); this.removeAttribute('src'); this.removeAttribute('srcset');"
        >
    {%- endif -%}
    {%- if mm_use_gallery == false and product_card_product.media[1] != nil and settings.show_image_swap -%}
        {%- if has_video != blank and settings.enable_hover_video_product_items -%}
            {{ has_video[0] | video_tag: muted: true, loop: true, image_size: '50x' }}
        {%- else -%}
            {%- assign width = product_card_product.media[1].width -%}
            {%- assign height = product_card_product.media[1].width | divided_by: product_card_product.media[1].aspect_ratio | round -%}
            <img
              width="{{ width }}"
              height="{{ height }}"
              {% render 'lazyload', preview_img: product_card_product.media[1], class: true, skip_dimensions: true, sizes: mm_card_sizes, loading: 'lazy', enable_rtl: settings.enable_layout_rtl %}
              onerror="this.setAttribute('data-mm-broken','1'); this.removeAttribute('src'); this.removeAttribute('srcset');"
            >
        {%- endif -%}
    {%- endif -%}
{%- else -%}
    {%- comment -%} Branded empty state — no fashion/apparel demo art, no foreign product photos. {%- endcomment -%}
    <span class="mm-product-card-placeholder" role="img" aria-label="{{ product_card_product.title | default: shop.name | escape }}">
      <svg class="mm-product-card-placeholder__svg placeholder-svg" viewBox="0 0 160 160" width="160" height="160" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
        <rect width="160" height="160" fill="#f4f7f5"/>
        <rect x="28" y="36" width="104" height="88" rx="8" fill="#ffffff" stroke="#dee5df" stroke-width="2"/>
        <path d="M52 98l18-22 14 16 12-10 20 16" fill="none" stroke="#c5d0c9" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="68" cy="64" r="8" fill="#dee5df"/>
      </svg>
    </span>
{%- endif -%}
