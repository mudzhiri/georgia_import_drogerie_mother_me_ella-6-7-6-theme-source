{%- comment -%}
  Visible header search trigger. Opens existing #mm-search-panel (mm-search.js).
  Do not add a second predictive stack here.
{%- endcomment -%}
<button
  type="button"
  class="mm-header-search-bar{% if class != blank %} {{ class }}{% endif %}"
  data-mm-search-open
  aria-haspopup="dialog"
  aria-controls="mm-search-panel"
  aria-expanded="false"
  aria-label="{{ 'general.search.search' | t }}"
>
  <span class="mm-header-search-bar__icon" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" focusable="false">
      <path fill="currentColor" d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
    </svg>
  </span>
  <span class="mm-header-search-bar__text">{{ 'general.search.search_a_product' | t }}</span>
</button>
