{%- comment -%}
  MOTHER & ME — shipping/payment note for cart drawer + cart page.
  Tbilisi 6 ₾ is informational only until address is known at checkout.
  Bank transfer: order first, pay with order number; not marked paid in-browser.
{%- endcomment -%}
{%- liquid
  assign note_context = context | default: 'drawer'
-%}
<div class="mm-cart-cost-note" data-mm-cart-cost-note="{{ note_context | escape }}">
  <p class="mm-cart-cost-note__shipping">
    {{ 'sections.cart.mm_shipping_note' | t }}
  </p>
  <p class="mm-cart-cost-note__payment">
    {{ 'sections.cart.mm_payment_note' | t }}
  </p>
</div>
