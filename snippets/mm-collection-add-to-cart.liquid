{% comment %}
  Quick cart icon under product photo (dm-style).
  Uses the same cart glyph as the header (icon-cart-06).
{% endcomment %}
{%- liquid
  assign mm_product = product
  assign mm_variant = mm_product.selected_or_first_available_variant
  assign mm_sold_out = false
  if mm_product.available == false
    assign mm_sold_out = true
  endif

  assign mm_needs_selection = false
  if mm_product.has_only_default_variant == false
    assign mm_needs_selection = true
  endif

  assign mm_is_preorder = false
  if mm_sold_out == false and mm_needs_selection == false
    if mm_variant.inventory_management != blank and mm_variant.inventory_quantity <= 0 and mm_variant.inventory_policy == 'continue'
      assign mm_is_preorder = true
    endif
  endif

  assign mm_form_id = 'mm-coll-atc-' | append: mm_product.id | append: '-' | append: sectionId
  assign mm_label_add = 'products.product.add_to_cart' | t
  if mm_is_preorder
    assign mm_label_add = 'products.product.pre_order' | t
  endif
-%}

<div class="mm-card-quick-cart">
  {%- if mm_sold_out -%}
    <button
      type="button"
      class="mm-card-quick-cart__btn mm-card-quick-cart__btn--disabled"
      disabled
      aria-disabled="true"
      aria-label="{{ 'products.product.sold_out' | t | escape }}"
      title="{{ 'products.product.sold_out' | t | escape }}"
    >
      <span class="mm-card-quick-cart__icon" aria-hidden="true">{% render 'icon-cart-06' %}</span>
      <span class="visually-hidden">{{ 'products.product.sold_out' | t }}</span>
    </button>
  {%- elsif mm_needs_selection -%}
    <a
      class="mm-card-quick-cart__btn"
      href="{{ mm_product.url }}"
      aria-label="{{ 'products.product.select_variant' | t | escape }}"
      title="{{ 'products.product.select_variant' | t | escape }}"
    >
      <span class="mm-card-quick-cart__icon" aria-hidden="true">{% render 'icon-cart-06' %}</span>
      <span class="visually-hidden">{{ 'products.product.select_variant' | t }}</span>
    </a>
  {%- else -%}
    <form
      action="{{ routes.cart_add_url }}"
      method="post"
      enctype="multipart/form-data"
      class="mm-card-quick-cart__form variants"
      id="{{ mm_form_id }}"
      data-product-id="{{ mm_product.id }}"
    >
      <input type="hidden" name="id" value="{{ mm_variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <button
        type="submit"
        name="add"
        class="mm-card-quick-cart__btn{% if mm_is_preorder %} mm-card-quick-cart__btn--preorder{% endif %}"
        data-btn-addToCart
        data-form-id="#{{ mm_form_id }}"
        aria-label="{{ mm_label_add | escape }}"
        title="{{ mm_label_add | escape }}"
      >
        <span class="mm-card-quick-cart__icon" aria-hidden="true">{% render 'icon-cart-06' %}</span>
        <span class="visually-hidden">{{ mm_label_add }}</span>
      </button>
    </form>
  {%- endif -%}
</div>
