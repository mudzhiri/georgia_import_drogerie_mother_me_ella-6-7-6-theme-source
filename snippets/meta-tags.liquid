{%- liquid
  assign mm_shop_name = shop.name | strip | replace: '&amp;', '&' | replace: '&#38;', '&'
  assign og_title = page_title | default: mm_shop_name | strip | replace: '&amp;', '&' | replace: '&#38;', '&'
  assign og_url = canonical_url | default: shop.url
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: '' | strip | replace: '&amp;', '&' | replace: '&#38;', '&'
  assign mm_shop_cmp = mm_shop_name | downcase
  assign mm_shop_norm = mm_shop_cmp | replace: '&', '' | replace: ' ', ''
  assign mm_og_title_cmp = og_title | downcase
  assign mm_og_title_norm = mm_og_title_cmp | replace: '&', '' | replace: ' ', ''
  assign mm_og_title_is_brand_only = false
  if og_title == blank or mm_og_title_cmp == mm_shop_cmp or mm_og_title_norm == mm_shop_norm
    assign mm_og_title_is_brand_only = true
  endif

  if request.page_type == 'index'
    assign mm_home_title = 'general.meta.homepage_title' | t | replace: '&amp;', '&' | replace: '&#38;', '&'
    assign mm_home_desc = 'general.meta.homepage_description' | t | replace: '&amp;', '&' | replace: '&#38;', '&'
    if mm_home_title contains 'Translation missing' or mm_home_title == 'general.meta.homepage_title'
      assign mm_home_title = ''
    endif
    if mm_home_desc contains 'Translation missing' or mm_home_desc == 'general.meta.homepage_description'
      assign mm_home_desc = ''
    endif

    if mm_og_title_is_brand_only
      if mm_home_title != blank
        assign og_title = mm_home_title
      else
        assign og_title = mm_shop_name
      endif
    endif

    if og_description == blank and mm_home_desc != blank
      assign og_description = mm_home_desc
    endif
    if og_description == blank
      assign og_description = mm_shop_name
    endif
  else
    if og_description == blank
      assign og_description = mm_shop_name
    endif
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'collection'
    assign og_type = 'product.group'
  elsif request.page_type == 'password'
    assign og_url = shop.url
  endif

  assign og_image = page_image
-%}

<meta property="og:site_name" content="{{ mm_shop_name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if og_image != blank -%}
  <meta property="og:image" content="http:{{ og_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url }}">
  {%- if og_image.width != blank -%}
    <meta property="og:image:width" content="{{ og_image.width }}">
  {%- endif -%}
  {%- if og_image.height != blank -%}
    <meta property="og:image:height" content="{{ og_image.height }}">
  {%- endif -%}
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank and settings.social_twitter_link contains 'twitter.com/' -%}
  {%- assign mm_twitter_handle = settings.social_twitter_link | split: 'twitter.com/' | last | strip -%}
  {%- if mm_twitter_handle != blank and mm_twitter_handle != 'shopify' -%}
    <meta name="twitter:site" content="{{ mm_twitter_handle | prepend: '@' | escape }}">
  {%- endif -%}
{%- endif -%}
<meta name="twitter:card" content="{% if og_image != blank %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if og_image != blank -%}
  <meta name="twitter:image" content="https:{{ og_image | image_url }}">
{%- endif -%}
