{%- comment -%}
  MOTHER & ME header language switcher.
  Uses Shopify localization.available_languages only — no hard-coded locale URLs.
  Accepts: id_suffix {String} unique form/button ids (desktop|mobile)
{%- endcomment -%}

{%- liquid
  assign id_suffix = id_suffix | default: 'header'
  assign available = localization.available_languages
  assign current = localization.language
  assign form_id = 'mm-lang-form-' | append: id_suffix
  assign trigger_id = 'mm-lang-trigger-' | append: id_suffix
  assign list_id = 'mm-lang-list-' | append: id_suffix
-%}

{%- if available.size > 1 -%}
  {%- liquid
    assign code = current.iso_code | upcase
    case current.iso_code
      when 'ka'
        assign current_label = 'ქართული'
        assign aria_language = 'ენა: ქართული'
      when 'ru'
        assign current_label = 'Русский'
        assign aria_language = 'Язык: Русский'
      when 'de'
        assign current_label = 'Deutsch'
        assign aria_language = 'Sprache: Deutsch'
      when 'en'
        assign current_label = 'English'
        assign aria_language = 'Language: English'
      else
        assign current_label = current.endonym_name | default: current.name
        assign aria_language = current_label
    endcase
  -%}

  <div class="mm-lang" data-mm-lang>
    {%- form 'localization', id: form_id, class: 'mm-lang__form' -%}
      <input type="hidden" name="locale_code" value="{{ current.iso_code }}" data-mm-lang-input>

      <button
        type="button"
        class="mm-lang__trigger"
        id="{{ trigger_id }}"
        aria-label="{{ aria_language | escape }}"
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-controls="{{ list_id }}"
        data-mm-lang-trigger
      >
        <span class="mm-lang__globe" aria-hidden="true">
          {%- comment -%} Outline globe only — fill forced none (base.css sets svg { fill: currentColor }) {%- endcomment -%}
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            focusable="false"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.75"/>
            <path d="M3 12h18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
            <path d="M12 3c2.7 2.6 4 5.4 4 9s-1.3 6.4-4 9c-2.7-2.6-4-5.4-4-9s1.3-6.4 4-9z" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
            <path d="M5.2 7.5h13.6M5.2 16.5h13.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="mm-lang__code" aria-hidden="true">{{ code }}</span>
      </button>

      <div
        class="mm-lang__dropdown"
        id="{{ list_id }}"
        role="listbox"
        aria-labelledby="{{ trigger_id }}"
        hidden
        data-mm-lang-dropdown
      >
        {%- for language in available -%}
          {%- liquid
            assign option_label = language.endonym_name | default: language.name
            case language.iso_code
              when 'ka'
                assign option_label = 'ქართული'
              when 'ru'
                assign option_label = 'Русский'
              when 'de'
                assign option_label = 'Deutsch'
              when 'en'
                assign option_label = 'English'
            endcase
            assign is_current = false
            if language.iso_code == current.iso_code
              assign is_current = true
            endif
          -%}
          <button
            type="button"
            class="mm-lang__option{% if is_current %} mm-lang__option--current{% endif %}"
            role="option"
            lang="{{ language.iso_code }}"
            hreflang="{{ language.iso_code }}"
            data-value="{{ language.iso_code }}"
            aria-selected="{% if is_current %}true{% else %}false{% endif %}"
            {% if is_current %}aria-current="true"{% endif %}
            data-mm-lang-option
          >
            <span class="mm-lang__option-name">{{ option_label }}</span>
            <span class="mm-lang__option-code">{{ language.iso_code | upcase }}</span>
          </button>
        {%- endfor -%}
      </div>
    {%- endform -%}
  </div>
{%- endif -%}
