{%- comment -%}
  MOTHER & ME header lockup:
  - "mother" from brand wordmark asset (mm-logo-mother.png)
  - "& me" as elegant display type beside it
  Params: width (px), alt, class, loading
{%- endcomment -%}
{%- liquid
  assign mark_width = width | default: 210
  assign mark_alt = alt | default: shop.name
  assign mark_class = class | default: ''
  assign mark_loading = loading | default: 'eager'
  assign mother_h = mark_width | times: 144 | divided_by: 600
  if mother_h < 1
    assign mother_h = 28
  endif
-%}
<span
  class="mm-logo-mark mm-logo {{ mark_class | escape }}"
  role="img"
  aria-label="{{ mark_alt | escape }}"
  style="--mm-logo-mark-width: {{ mark_width }}px;"
>
  <img
    src="{{ 'mm-logo-mother.png' | asset_url }}"
    alt=""
    class="mm-logo-mark__mother"
    width="{{ mark_width }}"
    height="{{ mother_h }}"
    loading="{{ mark_loading }}"
    decoding="async"
  >
  <span class="mm-logo-mark__me" aria-hidden="true">
    <span class="mm-logo-mark__amp">&amp;</span><span class="mm-logo-mark__word">me</span>
  </span>
</span>
