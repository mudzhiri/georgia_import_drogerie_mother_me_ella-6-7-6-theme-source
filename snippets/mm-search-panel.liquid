{%- comment -%}
  MOTHER & ME — header search overlay (icon trigger + Shopify predictive products)
  Locale-aware: form action + predictive URLs use Shopify routes for the active language.
{%- endcomment -%}
<div
  id="mm-search-panel"
  class="mm-search-panel"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="mm-search-panel-title"
  hidden
>
  <div class="mm-search-panel__backdrop" data-mm-search-close tabindex="-1"></div>
  <div class="mm-search-panel__sheet">
    <div class="mm-search-panel__bar">
      <h2 id="mm-search-panel-title" class="visually-hidden">{{ 'general.search.search' | t }}</h2>
      <form
        action="{{ routes.search_url }}"
        method="get"
        role="search"
        class="mm-search-panel__form"
        data-mm-search-form
      >
        <label class="mm-search-panel__label" for="mm-search-input">
          {{ 'general.search.label' | t }}
        </label>
        <div class="mm-search-panel__field">
          <input
            id="mm-search-input"
            class="mm-search-panel__input"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'general.search.search_a_product' | t }}"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            enterkeyhint="search"
            data-mm-search-input
            role="combobox"
            aria-autocomplete="list"
            aria-controls="mm-search-results"
            aria-expanded="false"
            aria-haspopup="listbox"
          >
          <input type="hidden" name="options[prefix]" value="last">
          <input type="hidden" name="type" value="product">
          <button type="submit" class="mm-search-panel__submit" aria-label="{{ 'general.search.submit' | t }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
            </svg>
          </button>
        </div>
      </form>
      <button
        type="button"
        class="mm-search-panel__close"
        data-mm-search-close
        aria-label="{{ 'general.search.close' | t }}"
      >
        <span class="mm-search-panel__close-text">{{ 'general.search.close' | t }}</span>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M18.3 5.71 12 12l6.3 6.29-1.41 1.42L10.59 13.4 4.3 19.71 2.89 18.3 9.17 12 2.89 5.71 4.3 4.29l6.29 6.3 6.3-6.3z"/>
        </svg>
      </button>
    </div>

    <div
      id="mm-search-results"
      class="mm-search-panel__results"
      data-mm-search-results
      role="listbox"
      aria-label="{{ 'general.search.mm_results' | t }}"
      hidden
    ></div>

    <p class="mm-search-panel__status visually-hidden" data-mm-search-status role="status" aria-live="polite"></p>
  </div>
</div>

<script type="application/json" id="mm-search-i18n">
  {
    "noResults": {{ 'general.search.mm_no_results' | t | json }},
    "viewAll": {{ 'general.search.mm_view_all' | t | json }},
    "loading": {{ 'accessibility.loading' | t | json }},
    "error": {{ 'general.search.mm_error' | t | json }},
    "retry": {{ 'general.search.mm_retry' | t | json }},
    "results": {{ 'general.search.mm_results' | t | json }},
    "suggestions": {{ 'general.search.mm_suggestions' | t | json }},
    "searchUrl": {{ routes.search_url | json }},
    "predictiveUrl": {{ routes.predictive_search_url | json }},
    "root": {{ routes.root_url | default: '/' | json }},
    "locale": {{ request.locale.iso_code | json }},
    "moneyFormat": {{ shop.money_format | json }}
  }
</script>
