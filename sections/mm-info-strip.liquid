{{ 'mm-info-strip.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_heading = section.settings.heading
  if section_heading == blank
    assign section_heading = 'mm_home.info.heading' | t
  endif
-%}
{%- if section.blocks.size > 0 -%}
  <aside
    id="mm-info-strip-{{ section.id }}"
    class="mm-info-strip mm-reveal"
    aria-label="{{ section_heading | escape }}"
  >
    <div class="mm-info-strip__inner">
      {%- if section_heading != blank -%}
        <h2 class="visually-hidden">{{ section_heading | escape }}</h2>
      {%- endif -%}

      <ul class="mm-info-strip__list" role="list">
        {%- for block in section.blocks -%}
          {%- assign item_text = block.settings.text -%}
          {%- if item_text != blank -%}
            <li class="mm-info-strip__item" data-mm-reveal-item {{ block.shopify_attributes }}>
              <span class="mm-info-strip__icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'heart' -%}
                    <svg viewBox="0 0 24 24" focusable="false" fill="none">
                      <path d="M12 20s-6.2-3.8-8.4-7.2C1.8 9.8 2.9 6.6 5.8 5.6c1.7-.6 3.6 0 4.7 1.5 1.1-1.5 3-2.1 4.7-1.5 2.9 1 4 4.2 2.2 7.2C18.2 16.2 12 20 12 20z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {%- when 'bag' -%}
                    <svg viewBox="0 0 24 24" focusable="false" fill="none">
                      <path d="M6.5 8.5h11l-.8 10.8a1.6 1.6 0 0 1-1.6 1.4H9a1.6 1.6 0 0 1-1.6-1.4L6.5 8.5z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                      <path d="M9 8.5V7a3 3 0 0 1 6 0v1.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                    </svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" focusable="false" fill="none">
                      <path d="M4.5 9h15v9.2a1.8 1.8 0 0 1-1.8 1.8H6.3A1.8 1.8 0 0 1 4.5 18.2V9z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
                      <path d="M9 9V7.4A3 3 0 0 1 12 4.4a3 3 0 0 1 3 3V9" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                      <path d="M4.5 12h15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                    </svg>
                {%- endcase -%}
              </span>
              <p class="mm-info-strip__text">{{ item_text | escape }}</p>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </aside>
{%- endif -%}

{% schema %}
{
  "name": "MM Info strip",
  "tag": "section",
  "class": "section-mm-info-strip",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (screen reader)",
      "default": "ინფორმაცია"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Info point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "package", "label": "Package" },
            { "value": "heart", "label": "Heart" },
            { "value": "bag", "label": "Shopping bag" }
          ],
          "default": "package"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "გერმანიიდან ჩამოტანილი",
          "info": "Only confirmed shop facts. Do not invent shipping thresholds or certificates."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MM Info strip",
      "blocks": [
        {
          "type": "point",
          "settings": {
            "icon": "package",
            "text": "გერმანიიდან ჩამოტანილი"
          }
        },
        {
          "type": "point",
          "settings": {
            "icon": "heart",
            "text": "ბავშვებისთვის და დედებისთვის"
          }
        },
        {
          "type": "point",
          "settings": {
            "icon": "bag",
            "text": "მარტივი ონლაინ შეკვეთა"
          }
        }
      ]
    }
  ]
}
{% endschema %}
