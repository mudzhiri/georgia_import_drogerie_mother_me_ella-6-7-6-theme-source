{{ 'mm-info-strip.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <aside
    id="mm-info-strip-{{ section.id }}"
    class="mm-info-strip"
    aria-label="{{ section.settings.heading | default: 'Information' | escape }}"
  >
    <div class="mm-info-strip__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="visually-hidden">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <ul class="mm-info-strip__list" role="list">
        {%- for block in section.blocks -%}
          {%- assign item_text = block.settings.text -%}
          {%- if item_text != blank -%}
            <li class="mm-info-strip__item" {{ block.shopify_attributes }}>
              <span class="mm-info-strip__icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'heart' -%}
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path d="M12 20.5s-6.5-4.1-8.7-7.8C1.4 9.7 2.4 6.2 5.4 5c1.9-.8 4-.2 5.2 1.4C11.8 4.8 13.9 4.2 15.8 5c3 1.2 4 4.7 2.1 7.7C18.5 16.4 12 20.5 12 20.5z"/>
                    </svg>
                  {%- when 'bag' -%}
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path d="M6.5 8.5h11l-.8 11.2a1.5 1.5 0 0 1-1.5 1.3H8.8a1.5 1.5 0 0 1-1.5-1.3L6.5 8.5z"/>
                      <path d="M9 8.5V7a3 3 0 0 1 6 0v1.5"/>
                    </svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path d="M4.5 8.5h15v10.2a1.8 1.8 0 0 1-1.8 1.8H6.3a1.8 1.8 0 0 1-1.8-1.8V8.5z"/>
                      <path d="M9 8.5V7.2A3 3 0 0 1 12 4.2a3 3 0 0 1 3 3v1.3"/>
                      <path d="M4.5 11.5h15"/>
                    </svg>
                  {%- endcase -%}
              </span>
              <p class="mm-info-strip__text">{{ item_text | escape }}</p>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </aside>
{%- endif -%}

{% schema %}
{
  "name": "MM Info strip",
  "tag": "section",
  "class": "section-mm-info-strip",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (screen reader)",
      "default": "Information"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Info point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "package", "label": "Package" },
            { "value": "heart", "label": "Heart" },
            { "value": "bag", "label": "Shopping bag" }
          ],
          "default": "package"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "გერმანიიდან ჩამოტანილი"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MM Info strip",
      "blocks": [
        {
          "type": "point",
          "settings": {
            "icon": "package",
            "text": "გერმანიიდან ჩამოტანილი"
          }
        },
        {
          "type": "point",
          "settings": {
            "icon": "heart",
            "text": "ბავშვებისთვის და დედებისთვის"
          }
        },
        {
          "type": "point",
          "settings": {
            "icon": "bag",
            "text": "მარტივი ონლაინ შეკვეთა"
          }
        }
      ]
    }
  ]
}
{% endschema %}
