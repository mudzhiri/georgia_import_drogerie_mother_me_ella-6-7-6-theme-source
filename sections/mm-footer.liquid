{{ 'mm-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  if section.settings.brand_text != blank
    assign brand_text = section.settings.brand_text
  else
    assign brand_text = 'sections.mm_footer.brand_text' | t
  endif

  if section.settings.customers_heading != blank
    assign customers_heading = section.settings.customers_heading
  else
    assign customers_heading = 'sections.mm_footer.customers_heading' | t
  endif

  if section.settings.info_heading != blank
    assign info_heading = section.settings.info_heading
  else
    assign info_heading = 'sections.mm_footer.info_heading' | t
  endif

  assign customers_menu = section.settings.menu_customers
  assign info_menu = section.settings.menu_info
  assign show_contact = section.settings.show_contact
  assign show_social = section.settings.show_social
  assign show_payments = section.settings.show_payments
  assign show_policies_customers = section.settings.show_policies_customers
  assign show_policies_info = section.settings.show_policies_info
  assign logo = section.settings.logo
  assign logo_width = section.settings.logo_width | default: 180

  assign has_customers_menu = false
  if customers_menu != blank and customers_menu.links.size > 0
    assign has_customers_menu = true
  endif

  assign has_info_menu = false
  if info_menu != blank and info_menu.links.size > 0
    assign has_info_menu = true
  endif

  assign shipping_policy = shop.shipping_policy
  assign refund_policy = shop.refund_policy
  assign privacy_policy = shop.privacy_policy
  assign terms_policy = shop.terms_of_service

  assign show_shipping = false
  assign show_refund = false
  if show_policies_customers
    if shipping_policy != blank and shipping_policy.url != blank
      assign show_shipping = true
    endif
    if refund_policy != blank and refund_policy.url != blank
      assign show_refund = true
    endif
  endif

  assign show_privacy = false
  assign show_terms = false
  if show_policies_info
    if privacy_policy != blank and privacy_policy.url != blank
      assign show_privacy = true
    endif
    if terms_policy != blank and terms_policy.url != blank
      assign show_terms = true
    endif
  endif

  # Suppress policy links that already appear in the selected menus.
  if has_customers_menu
    for link in customers_menu.links
      if show_shipping and link.url == shipping_policy.url
        assign show_shipping = false
      endif
      if show_refund and link.url == refund_policy.url
        assign show_refund = false
      endif
    endfor
  endif

  if has_info_menu
    for link in info_menu.links
      if show_privacy and link.url == privacy_policy.url
        assign show_privacy = false
      endif
      if show_terms and link.url == terms_policy.url
        assign show_terms = false
      endif
    endfor
  endif

  # Fallback page targets when menus are empty — only real published pages.
  assign contact_page = pages['contact']
  if contact_page == empty
    assign contact_page = pages['contact-us']
  endif
  if contact_page == empty
    assign contact_page = pages['kontakt']
  endif

  assign about_page = pages['about']
  if about_page == empty
    assign about_page = pages['about-us']
  endif
  if about_page == empty
    assign about_page = pages['uber-uns']
  endif
  if about_page == empty
    assign about_page = pages['about-mother-me']
  endif

  assign show_contact_page = false
  if has_customers_menu == false and contact_page != empty and contact_page.url != blank
    assign show_contact_page = true
  endif

  assign show_about_page = false
  if has_info_menu == false and about_page != empty and about_page.url != blank
    assign show_about_page = true
  endif

  # Theme-rendered B2B link — does not edit shared Shopify navigation menus.
  # New checkbox can be nil on existing section instances; only explicit false hides it.
  assign business_page = pages['business']
  assign show_business_page = false
  if section.settings.show_business_link == false
    assign show_business_page = false
  elsif business_page != empty and business_page.url != blank
    assign show_business_page = true
  endif

  assign has_customers_links = false
  if has_customers_menu or show_shipping or show_refund or show_contact_page
    assign has_customers_links = true
  endif

  assign has_info_links = false
  if has_info_menu or show_privacy or show_terms or show_about_page or show_business_page
    assign has_info_links = true
  endif

  if section.settings.contact_email != blank
    assign contact_email = section.settings.contact_email | strip
  elsif shop.email != blank
    assign contact_email = shop.email | strip
  else
    assign contact_email = ''
  endif

  assign email_down = contact_email | downcase
  if email_down contains 'email@domain.com' or email_down contains 'example@domain.com' or email_down contains '@domain.com'
    assign contact_email = ''
  endif

  assign contact_phone = shop.phone | strip
  assign phone_down = contact_phone | downcase
  if contact_phone != blank
    if phone_down contains 'ella' or phone_down contains '555-5555' or phone_down contains '091-123' or phone_down contains '090-123' or phone_down contains '(090)' or phone_down contains '(415) 555'
      assign contact_phone = ''
    endif
  endif

  assign has_address = false
  if shop.address != blank
    if shop.address.address1 != blank or shop.address.city != blank or shop.address.company != blank
      assign address_blob = shop.address.company | append: ' ' | append: shop.address.address1 | append: ' ' | append: shop.address.address2 | append: ' ' | append: shop.address.city | append: ' ' | append: shop.address.zip | append: ' ' | append: shop.address.country
      assign address_down = address_blob | downcase
      if address_down contains 'san francisco' or address_down contains 'market street' or address_down contains 'divamus' or address_down contains "ella's garden" or address_down contains 'ellas garden' or address_down contains 'city name'
        assign has_address = false
      else
        assign has_address = true
      endif
    endif
  endif

  assign has_contact = false
  if show_contact
    if contact_email != blank or contact_phone != blank or has_address
      assign has_contact = true
    endif
  endif

  # Social: only real profiles. Reject blank and Shopify demo placeholders.
  assign social_facebook = settings.social_facebook_link | strip
  assign social_instagram = settings.social_instagram_link | strip
  assign social_pinterest = settings.social_pinterest_link | strip
  assign social_tiktok = settings.social_tiktok_link | strip
  assign social_youtube = settings.social_youtube_link | strip
  assign social_twitter = settings.social_twitter_link | strip
  assign social_vimeo = settings.social_vimeo_link | strip
  assign social_tumblr = settings.social_tumblr_link | strip
  assign social_snapchat = settings.social_snapchat_link | strip

  assign show_facebook = false
  assign show_instagram = false
  assign show_pinterest = false
  assign show_tiktok = false
  assign show_youtube = false
  assign show_twitter = false
  assign show_vimeo = false
  assign show_tumblr = false
  assign show_snapchat = false

  if show_social
    if social_facebook != blank
      assign social_facebook_lc = social_facebook | downcase
      unless social_facebook_lc contains 'facebook.com/shopify'
        assign show_facebook = true
      endunless
    endif
    if social_instagram != blank
      assign social_instagram_lc = social_instagram | downcase
      unless social_instagram_lc contains 'instagram.com/shopify'
        assign show_instagram = true
      endunless
    endif
    if social_pinterest != blank
      assign social_pinterest_lc = social_pinterest | downcase
      unless social_pinterest_lc contains 'pinterest.com/shopify'
        assign show_pinterest = true
      endunless
    endif
    if social_tiktok != blank
      assign social_tiktok_lc = social_tiktok | downcase
      unless social_tiktok_lc contains 'tiktok.com/@shopify' or social_tiktok_lc contains 'tiktok.com/shopify'
        assign show_tiktok = true
      endunless
    endif
    if social_youtube != blank
      assign social_youtube_lc = social_youtube | downcase
      unless social_youtube_lc contains 'youtube.com/shopify' or social_youtube_lc contains 'youtube.com/@shopify'
        assign show_youtube = true
      endunless
    endif
    if social_twitter != blank
      assign social_twitter_lc = social_twitter | downcase
      unless social_twitter_lc contains 'twitter.com/shopify' or social_twitter_lc contains 'x.com/shopify'
        assign show_twitter = true
      endunless
    endif
    if social_vimeo != blank
      assign show_vimeo = true
    endif
    if social_tumblr != blank
      assign show_tumblr = true
    endif
    if social_snapchat != blank
      assign show_snapchat = true
    endif
  endif

  assign has_social = false
  if show_facebook or show_instagram or show_pinterest or show_tiktok or show_youtube or show_twitter or show_vimeo or show_tumblr or show_snapchat
    assign has_social = true
  endif

  assign payment_types = shop.enabled_payment_types
  assign has_payments = false
  if show_payments and payment_types.size > 0
    assign has_payments = true
  endif

  assign year_now = 'now' | date: '%Y'
-%}

<footer
  id="mm-footer-{{ section.id }}"
  class="mm-footer"
  data-mm-footer
  role="contentinfo"
>
  <div class="mm-footer__inner">
    <div class="mm-footer__grid{% unless has_customers_links %} mm-footer__grid--no-customers{% endunless %}{% unless has_info_links %} mm-footer__grid--no-info{% endunless %}">
      <div class="mm-footer__brand">
        <a class="mm-footer__logo-link" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          {%- if logo != blank -%}
            {{
              logo
              | image_url: width: logo_width
              | image_tag:
                class: 'mm-footer__logo-img',
                widths: '120, 180, 240, 360',
                sizes: '(max-width: 767px) 160px, 180px',
                alt: shop.name,
                loading: 'lazy'
            }}
          {%- else -%}
            {%- comment -%}
              Same brand mark as header. Inline SVG so it always renders on dark footer
              (external SVG <text> logos often look “missing” as <img>).
            {%- endcomment -%}
            <span class="mm-footer__logo-img mm-footer__logo-mark" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 180" focusable="false">
                <text
                  x="450"
                  y="100"
                  text-anchor="middle"
                  fill="currentColor"
                  font-family="Georgia, 'Times New Roman', Times, serif"
                  font-size="78"
                  font-weight="600"
                  letter-spacing="14"
                >MOTHER &amp; ME</text>
                <line x1="330" y1="132" x2="570" y2="132" stroke="#F3D5C3" stroke-width="3" stroke-linecap="round"/>
              </svg>
            </span>
          {%- endif -%}
        </a>

        {%- if brand_text != blank -%}
          <p class="mm-footer__tagline">{{ brand_text | escape }}</p>
        {%- endif -%}

        {%- if has_contact -%}
          <ul class="mm-footer__contact">
            {%- if contact_email != blank -%}
              <li>
                <a class="mm-footer__contact-link" href="mailto:{{ contact_email | escape }}">
                  {{ contact_email | escape }}
                </a>
              </li>
            {%- endif -%}
            {%- if contact_phone != blank -%}
              <li>
                <a class="mm-footer__contact-link" href="tel:{{ contact_phone | replace: ' ', '' | escape }}">
                  {{ contact_phone | escape }}
                </a>
              </li>
            {%- endif -%}
            {%- if has_address -%}
              <li>
                <span class="mm-footer__contact-text">
                  {%- if shop.address.company != blank -%}{{ shop.address.company | escape }}{%- if shop.address.address1 != blank or shop.address.city != blank -%}, {% endif %}{%- endif -%}
                  {%- if shop.address.address1 != blank -%}{{ shop.address.address1 | escape }}{%- endif -%}
                  {%- if shop.address.address2 != blank -%}, {{ shop.address.address2 | escape }}{%- endif -%}
                  {%- if shop.address.city != blank -%}{%- if shop.address.address1 != blank or shop.address.address2 != blank -%}, {% endif %}{{ shop.address.city | escape }}{%- endif -%}
                  {%- if shop.address.country != blank -%}, {{ shop.address.country | escape }}{%- endif -%}
                </span>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        {%- if has_social -%}
          <ul class="mm-footer__social" role="list">
            {%- if show_facebook -%}
              <li>
                <a
                  class="mm-footer__social-link"
                  href="{{ social_facebook }}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {%- render 'icon-facebook' -%}
                  <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if show_instagram -%}
              <li>
                <a
                  class="mm-footer__social-link"
                  href="{{ social_instagram }}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {%- render 'icon-instagram' -%}
                  <span class="visually-hidden">{{ 'general.social.links.instagram' | t }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if show_pinterest -%}
              <li>
                <a
                  class="mm-footer__social-link"
                  href="{{ social_pinterest }}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {%- render 'icon-pinterest' -%}
                  <span class="visually-hidden">{{ 'general.social.links.pinterest' | t }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if show_tiktok -%}
              <li>
                <a
                  class="mm-footer__social-link"
                  href="{{ social_tiktok }}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {%- render 'icon-tiktok' -%}
                  <span class="visually-hidden">{{ 'general.social.links.tiktok' | t }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if show_youtube -%}
              <li>
                <a
                  class="mm-footer__social-link"
                  href="{{ social_youtube }}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {%- render 'icon-youtube' -%}
                  <span class="visually-hidden">{{ 'general.social.links.youtube' | t }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if show_twitter -%}
              <li>
                <a
                  class="mm-footer__social-link"
                  href="{{ social_twitter }}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {%- render 'icon-twitter' -%}
                  <span class="visually-hidden">{{ 'general.social.links.twitter' | t }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if show_vimeo -%}
              <li>
                <a
                  class="mm-footer__social-link"
                  href="{{ social_vimeo }}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {%- render 'icon-vimeo' -%}
                  <span class="visually-hidden">{{ 'general.social.links.vimeo' | t }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if show_tumblr -%}
              <li>
                <a
                  class="mm-footer__social-link"
                  href="{{ social_tumblr }}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {%- render 'icon-tumblr' -%}
                  <span class="visually-hidden">{{ 'general.social.links.tumblr' | t }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if show_snapchat -%}
              <li>
                <a
                  class="mm-footer__social-link"
                  href="{{ social_snapchat }}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {%- render 'icon-snapchat' -%}
                  <span class="visually-hidden">{{ 'general.social.links.snapchat' | t }}</span>
                </a>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>

      {%- if has_customers_links -%}
        <details class="mm-footer__accordion" data-mm-footer-accordion>
          <summary class="mm-footer__summary">
            <span>{{ customers_heading | escape }}</span>
            <svg class="mm-footer__chevron" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4Z"/>
            </svg>
          </summary>
          <ul class="mm-footer__nav-list" role="list">
            {%- if has_customers_menu -%}
              {%- for link in customers_menu.links -%}
                <li>
                  <a class="mm-footer__nav-link" href="{{ link.url }}">{{ link.title | escape }}</a>
                </li>
              {%- endfor -%}
            {%- elsif show_contact_page -%}
              <li>
                <a class="mm-footer__nav-link" href="{{ contact_page.url }}">{{ 'sections.mm_footer.link_contact' | t }}</a>
              </li>
            {%- endif -%}
            {%- if show_shipping -%}
              <li>
                <a class="mm-footer__nav-link" href="{{ shipping_policy.url }}">
                  {%- if shipping_policy.title != blank -%}
                    {{ shipping_policy.title | escape }}
                  {%- else -%}
                    {{ 'sections.mm_footer.link_shipping' | t }}
                  {%- endif -%}
                </a>
              </li>
            {%- endif -%}
            {%- if show_refund -%}
              <li>
                <a class="mm-footer__nav-link" href="{{ refund_policy.url }}">
                  {%- if refund_policy.title != blank -%}
                    {{ refund_policy.title | escape }}
                  {%- else -%}
                    {{ 'sections.mm_footer.link_refund' | t }}
                  {%- endif -%}
                </a>
              </li>
            {%- endif -%}
          </ul>
        </details>
      {%- endif -%}

      {%- if has_info_links -%}
        <details class="mm-footer__accordion" data-mm-footer-accordion>
          <summary class="mm-footer__summary">
            <span>{{ info_heading | escape }}</span>
            <svg class="mm-footer__chevron" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4Z"/>
            </svg>
          </summary>
          <ul class="mm-footer__nav-list" role="list">
            {%- if has_info_menu -%}
              {%- for link in info_menu.links -%}
                <li>
                  <a class="mm-footer__nav-link" href="{{ link.url }}">{{ link.title | escape }}</a>
                </li>
              {%- endfor -%}
            {%- elsif show_about_page -%}
              <li>
                <a class="mm-footer__nav-link" href="{{ about_page.url }}">{{ 'sections.mm_footer.link_about' | t }}</a>
              </li>
            {%- endif -%}
            {%- if show_business_page -%}
              <li>
                <a class="mm-footer__nav-link" href="{{ business_page.url }}">{{ 'mm_pages.business.nav_label' | t }}</a>
              </li>
            {%- endif -%}
            {%- if show_privacy -%}
              <li>
                <a class="mm-footer__nav-link" href="{{ privacy_policy.url }}">
                  {%- if privacy_policy.title != blank -%}
                    {{ privacy_policy.title | escape }}
                  {%- else -%}
                    {{ 'sections.mm_footer.link_privacy' | t }}
                  {%- endif -%}
                </a>
              </li>
            {%- endif -%}
            {%- if show_terms -%}
              <li>
                <a class="mm-footer__nav-link" href="{{ terms_policy.url }}">
                  {%- if terms_policy.title != blank -%}
                    {{ terms_policy.title | escape }}
                  {%- else -%}
                    {{ 'sections.mm_footer.link_terms' | t }}
                  {%- endif -%}
                </a>
              </li>
            {%- endif -%}
          </ul>
        </details>
      {%- endif -%}
    </div>

    <div class="mm-footer__bottom">
      <p class="mm-footer__copyright">
        &copy; {{ year_now }} {{ shop.name | escape }}
      </p>

      {%- if has_payments -%}
        <ul class="mm-footer__payments" role="list">
          <li class="visually-hidden">{{ 'sections.footer.payment' | t }}</li>
          {%- for type in payment_types -%}
            <li class="mm-footer__payment-item">
              {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

<script src="{{ 'mm-footer.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "MM Footer",
  "tag": "section",
  "class": "section-mm-footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Optional. Falls empty, the theme MOTHER & ME logo is used."
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 100,
      "max": 280,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 180
    },
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Brand text",
      "info": "Leave blank to use localized theme text (KA / EN / DE / RU)."
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "Show shop contact details",
      "default": true,
      "info": "Shows the public contact email below, plus phone and address from Store details when available. Nothing is invented."
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Public contact email",
      "default": "info@motherandme.ge",
      "info": "Shown to customers in the footer. Falls back to shop email when blank."
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true,
      "info": "Icons appear only for real profiles under Theme settings → Social media. Shopify demo URLs are ignored; empty strip is hidden."
    },
    {
      "type": "header",
      "content": "For customers"
    },
    {
      "type": "text",
      "id": "customers_heading",
      "label": "Heading",
      "info": "Leave blank to use localized theme text."
    },
    {
      "type": "link_list",
      "id": "menu_customers",
      "label": "Menu",
      "info": "Recommended links: contact, delivery, returns."
    },
    {
      "type": "checkbox",
      "id": "show_policies_customers",
      "label": "Include shipping and refund policies",
      "default": true,
      "info": "Adds published Shopify shipping and refund policies when they exist."
    },
    {
      "type": "header",
      "content": "Information"
    },
    {
      "type": "text",
      "id": "info_heading",
      "label": "Heading",
      "info": "Leave blank to use localized theme text."
    },
    {
      "type": "link_list",
      "id": "menu_info",
      "label": "Menu",
      "info": "Recommended links: about us and other info pages."
    },
    {
      "type": "checkbox",
      "id": "show_policies_info",
      "label": "Include privacy and terms policies",
      "default": true,
      "info": "Adds published Shopify privacy and terms policies when they exist."
    },
    {
      "type": "checkbox",
      "id": "show_business_link",
      "label": "Show B2B / business page link",
      "default": true,
      "info": "Adds a theme-rendered link to /pages/business when that page exists. Does not edit shared Shopify menus."
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "checkbox",
      "id": "show_payments",
      "label": "Show enabled payment icons",
      "default": false,
      "info": "Only shows payment methods actually enabled in Shopify Payments / checkout. Leave off until confirmed."
    }
  ]
}
{% endschema %}
