{{ 'mm-faq.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mm-faq.js' | asset_url }}" defer></script>

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'mm_home.faq.heading' | t
  endif
  assign visible = 0
  for block in section.blocks
    if block.settings.question != blank and block.settings.answer != blank
      assign visible = visible | plus: 1
    endif
  endfor
-%}

{%- if visible > 0 -%}
  <section
    id="mm-faq-{{ section.id }}"
    class="mm-faq mm-reveal"
    aria-labelledby="mm-faq-heading-{{ section.id }}"
  >
    <div class="mm-faq__inner">
      {%- if heading != blank -%}
        <h2 id="mm-faq-heading-{{ section.id }}" class="mm-faq__heading" data-mm-reveal-item>
          {{ heading | escape }}
        </h2>
      {%- endif -%}

      <div class="mm-faq__list">
        {%- for block in section.blocks -%}
          {%- if block.settings.question != blank and block.settings.answer != blank -%}
            {%- assign item_id = 'mm-faq-item-' | append: section.id | append: '-' | append: block.id -%}
            <div class="mm-faq__item" data-mm-reveal-item data-mm-faq-item {{ block.shopify_attributes }}>
              <h3 class="mm-faq__question-wrap">
                <button
                  type="button"
                  class="mm-faq__question"
                  id="{{ item_id }}-button"
                  aria-expanded="false"
                  aria-controls="{{ item_id }}-panel"
                  data-mm-faq-trigger
                >
                  <span class="mm-faq__question-text">{{ block.settings.question | escape }}</span>
                  <span class="mm-faq__icon" aria-hidden="true">
                    <svg class="mm-faq__icon-plus" viewBox="0 0 24 24" width="20" height="20" fill="none" focusable="false">
                      <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                    </svg>
                    <svg class="mm-faq__icon-minus" viewBox="0 0 24 24" width="20" height="20" fill="none" focusable="false">
                      <path d="M5 12h14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                    </svg>
                  </span>
                </button>
              </h3>
              <div
                class="mm-faq__panel"
                id="{{ item_id }}-panel"
                role="region"
                aria-labelledby="{{ item_id }}-button"
                hidden
                data-mm-faq-panel
              >
                <div class="mm-faq__answer">
                  <p>{{ block.settings.answer | escape | newline_to_br }}</p>
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "MM FAQ",
  "tag": "section",
  "class": "section-mm-faq",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ხშირად დასმული კითხვები"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "info": "Only confirmed shop facts. Incomplete pairs stay hidden."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MM FAQ",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "question": "როგორ ხდება შეკვეთა?",
            "answer": "აირჩიე პროდუქტები, დაამატე კალათაში და დაასრულე შეკვეთა ონლაინ. ფასები მითითებულია ლარში (₾). შეკვეთა დასტურდება გადახდის შემდეგ."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "რა ღირს მიწოდება?",
            "answer": "მიწოდება საქართველოში: 8 ₾. თვითგატანა თბილისში უფასოა. შეკვეთები მუშავდება სამუშაო დღეებში."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "როგორ მუშაობს გადახდა?",
            "answer": "შეკვეთა დასტურდება გადახდის შემდეგ. ფასები ნაჩვენებია ლარში (₾)."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "შეიძლება პროდუქტის დაბრუნება?",
            "answer": "თუ პროდუქტი დაზიანებულია ან არასწორია, დაგვიკავშირდით 7 დღის განმავლობაში შეკვეთის მიღებიდან. გახსნილი ჰიგიენური პროდუქტები დაბრუნებას არ ექვემდებარება."
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "საიდან მოდის პროდუქტები?",
            "answer": "MOTHER & ME გთავაზობს გერმანიიდან ჩამოტანილ მოვლისა და ჰიგიენის პროდუქტებს ბავშვებისთვის და დედებისთვის."
          }
        }
      ]
    }
  ]
}
{% endschema %}
