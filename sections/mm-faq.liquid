{{ 'mm-faq.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mm-faq.js' | asset_url }}" defer></script>

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'mm_home.faq.heading' | t
  endif
-%}

{%- capture mm_faq_items -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign topic = block.settings.topic | default: 'order'
      case topic
        when 'shipping'
          assign question = 'mm_home.faq.q_shipping' | t
          assign answer = 'mm_home.faq.a_shipping' | t
        when 'payment'
          assign question = 'mm_home.faq.q_payment' | t
          assign answer = 'mm_home.faq.a_payment' | t
        when 'returns'
          assign question = 'mm_home.faq.q_returns' | t
          assign answer = 'mm_home.faq.a_returns' | t
        when 'origin'
          assign question = 'mm_home.faq.q_origin' | t
          assign answer = 'mm_home.faq.a_origin' | t
        else
          assign question = 'mm_home.faq.q_order' | t
          assign answer = 'mm_home.faq.a_order' | t
      endcase
      if block.settings.question != blank
        assign question = block.settings.question
      endif
      if block.settings.answer != blank
        assign answer = block.settings.answer
      endif
      # Decode a stored &amp; once before | escape (avoids visible "MOTHER &amp; ME").
      if question contains '&amp;'
        assign question = question | replace: '&amp;', '&' | replace: '&#38;', '&'
      endif
      if answer contains '&amp;'
        assign answer = answer | replace: '&amp;', '&' | replace: '&#38;', '&'
      endif
    -%}
    {%- if question != blank and answer != blank -%}
      {%- assign item_id = 'mm-faq-item-' | append: section.id | append: '-' | append: block.id -%}
      <div class="mm-faq__item" data-mm-reveal-item data-mm-faq-item {{ block.shopify_attributes }}>
        <h3 class="mm-faq__question-wrap">
          <button
            type="button"
            class="mm-faq__question"
            id="{{ item_id }}-button"
            aria-expanded="false"
            aria-controls="{{ item_id }}-panel"
            data-mm-faq-trigger
          >
            <span class="mm-faq__question-text">{{ question | escape }}</span>
            <span class="mm-faq__icon" aria-hidden="true">
              <svg class="mm-faq__icon-plus" viewBox="0 0 24 24" width="20" height="20" fill="none" focusable="false">
                <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
              </svg>
              <svg class="mm-faq__icon-minus" viewBox="0 0 24 24" width="20" height="20" fill="none" focusable="false">
                <path d="M5 12h14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
              </svg>
            </span>
          </button>
        </h3>
        <div
          class="mm-faq__panel"
          id="{{ item_id }}-panel"
          role="region"
          aria-labelledby="{{ item_id }}-button"
          data-mm-faq-panel
        >
          <div class="mm-faq__answer">
            <p>{{ answer | escape | newline_to_br }}</p>
          </div>
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if mm_faq_items != blank -%}
  <section
    id="mm-faq-{{ section.id }}"
    class="mm-faq mm-reveal"
    aria-labelledby="mm-faq-heading-{{ section.id }}"
  >
    <div class="mm-faq__inner">
      {%- if heading != blank -%}
        <h2 id="mm-faq-heading-{{ section.id }}" class="mm-faq__heading" data-mm-reveal-item>
          {{ heading | escape }}
        </h2>
      {%- endif -%}
      <div class="mm-faq__list">
        {{ mm_faq_items }}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "MM FAQ",
  "tag": "section",
  "class": "section-mm-faq",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override (optional)",
      "info": "Leave blank for locale text (KA/EN/DE/RU)."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        {
          "type": "select",
          "id": "topic",
          "label": "Topic (locale text)",
          "default": "order",
          "options": [
            { "value": "order", "label": "Order" },
            { "value": "shipping", "label": "Delivery" },
            { "value": "payment", "label": "Payment" },
            { "value": "returns", "label": "Returns" },
            { "value": "origin", "label": "Product origin" }
          ]
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question override (optional)",
          "info": "Leave blank for translated locale text."
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer override (optional)",
          "info": "Leave blank for translated locale text. Only confirmed shop facts."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MM FAQ",
      "blocks": [
        { "type": "item", "settings": { "topic": "order" } },
        { "type": "item", "settings": { "topic": "shipping" } },
        { "type": "item", "settings": { "topic": "payment" } },
        { "type": "item", "settings": { "topic": "returns" } },
        { "type": "item", "settings": { "topic": "origin" } }
      ]
    }
  ]
}
{% endschema %}
