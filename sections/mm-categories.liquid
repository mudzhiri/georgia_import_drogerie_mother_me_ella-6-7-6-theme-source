{{ 'mm-categories.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_heading = section.settings.heading
  if section_heading == blank
    assign section_heading = 'mm_home.categories.heading' | t
  endif

  assign view_all_label = section.settings.view_all_label
  if view_all_label == blank
    assign view_all_label = 'mm_home.categories.view_all' | t
  endif
  assign view_all_link = section.settings.view_all_link
  if view_all_link == blank
    assign view_all_link = routes.collections_url
  endif

  assign primary_count = 0
  assign secondary_count = 0

  for block in section.blocks
    assign tone = block.settings.tone | default: 'sage'
    assign role = block.settings.role | default: 'auto'
    if role != 'primary' and role != 'secondary'
      if tone == 'kids' or tone == 'mamas'
        assign role = 'primary'
      else
        assign role = 'secondary'
      endif
    endif

    assign link = block.settings.link
    assign tile_collection = block.settings.collection
    assign label = block.settings.label
    assign skip = false

    if tile_collection != blank
      if link == blank
        assign link = tile_collection.url
      endif
      if tile_collection.products_count == 0 and block.settings.link == blank and role != 'primary'
        assign skip = true
      endif
    endif

    if label == blank
      if tone == 'mamas'
        assign label = 'mm_home.categories.mamas_label' | t
      elsif tone == 'kids'
        assign label = 'mm_home.categories.kids_label' | t
      elsif tile_collection != blank
        assign label = tile_collection.title
      endif
    endif

    unless skip or label == blank or link == blank
      if role == 'primary'
        assign primary_count = primary_count | plus: 1
      else
        assign secondary_count = secondary_count | plus: 1
      endif
    endunless
  endfor

  assign visible_tiles = primary_count | plus: secondary_count
-%}

{%- if visible_tiles > 0 -%}
  <section
    id="mm-categories-{{ section.id }}"
    class="mm-categories mm-categories--primary-{{ primary_count }} mm-categories--secondary-{{ secondary_count }} mm-reveal"
    aria-label="{{ section_heading | escape }}"
  >
    <div class="mm-categories__inner">
      <div class="mm-categories__header">
        {%- if section_heading != blank -%}
          <h2 class="mm-categories__heading">{{ section_heading | escape }}</h2>
        {%- endif -%}
        {%- if view_all_label != blank and view_all_link != blank -%}
          <a class="mm-categories__view-all" href="{{ view_all_link }}">{{ view_all_label | escape }}</a>
        {%- endif -%}
      </div>

      {%- if primary_count > 0 -%}
        <div class="mm-categories__row mm-categories__row--primary">
          {%- for block in section.blocks -%}
            {%- render 'mm-category-tile', block: block, force_role: 'primary' -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if secondary_count > 0 -%}
        <div class="mm-categories__row mm-categories__row--secondary">
          {%- for block in section.blocks -%}
            {%- render 'mm-category-tile', block: block, force_role: 'secondary' -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "MM Categories",
  "tag": "section",
  "class": "section-mm-categories",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading override (optional)",
      "info": "Leave blank to use locale file."
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all categories label (optional)"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all categories link",
      "info": "Defaults to /collections when empty."
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        {
          "type": "select",
          "id": "role",
          "label": "Hierarchy",
          "default": "auto",
          "options": [
            { "value": "auto", "label": "Auto (Kids/Mamas = primary)" },
            { "value": "primary", "label": "Primary audience entry" },
            { "value": "secondary", "label": "Secondary product-area entry" }
          ],
          "info": "Primary tiles are larger. Secondary tiles sit in a compact row below."
        },
        {
          "type": "select",
          "id": "tone",
          "label": "Tile color",
          "default": "sage",
          "options": [
            { "value": "kids", "label": "Kids / sage (audience)" },
            { "value": "mamas", "label": "Mamas / apricot (audience)" },
            { "value": "sage", "label": "Sage" },
            { "value": "cream", "label": "Cream" }
          ]
        },
        {
          "type": "text",
          "id": "label",
          "label": "Title override (optional)",
          "info": "Leave blank for collection title or audience locale text."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description (optional)",
          "info": "Only when it adds new information. Leave blank to avoid repeating the title."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Empty secondary collections are hidden. Primary audience hubs stay visible with a link. Image uses collection image when picker is empty."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Lifestyle image (optional)",
          "info": "Preferred. Overrides collection image. Swap anytime in the theme editor."
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Theme asset fallback filename",
          "info": "Optional. Example: mm-cat-kids.jpg — used when picker and collection image are empty."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MM Categories",
      "blocks": [
        { "type": "tile", "settings": { "tone": "kids", "role": "primary" } },
        { "type": "tile", "settings": { "tone": "mamas", "role": "primary" } }
      ]
    }
  ]
}
{% endschema %}
