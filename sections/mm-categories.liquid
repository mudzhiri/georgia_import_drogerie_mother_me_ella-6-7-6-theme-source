<section class="mm-cats">
  <div class="mm-cats__inner">
    <header class="mm-cats__head">
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p>{{ section.settings.subheading }}</p>
      {% endif %}
    </header>
    <ul class="mm-cats__grid" role="list">
      {% for block in section.blocks %}
        {% assign col = collections[block.settings.collection] %}
        {% if col != blank %}
          <li {{ block.shopify_attributes }}>
            <a class="mm-cats__card" href="{{ col.url }}">
              <span class="mm-cats__visual">
                {% if col.image %}
                  {{ col.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: col.title }}
                {% elsif col.products.first and col.products.first.featured_image %}
                  {{ col.products.first.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: col.title }}
                {% else %}
                  <span class="mm-cats__fallback"></span>
                {% endif %}
              </span>
              <span class="mm-cats__title">{{ col.title }}</span>
            </a>
          </li>
        {% elsif block.settings.label != blank %}
          <li {{ block.shopify_attributes }}>
            <a class="mm-cats__card" href="{{ block.settings.link | default: '/collections/all' }}">
              <span class="mm-cats__visual"><span class="mm-cats__fallback"></span></span>
              <span class="mm-cats__title">{{ block.settings.label }}</span>
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</section>

{% stylesheet %}
  .mm-cats {
    background: #eef3f0;
    padding: clamp(3rem, 7vw, 5.5rem) clamp(1.25rem, 4vw, 3rem);
  }
  .mm-cats__inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .mm-cats__head {
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
    max-width: 36rem;
  }
  .mm-cats__head h2 {
    margin: 0;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    line-height: 1.05;
    color: #14201c;
    letter-spacing: -0.02em;
  }
  .mm-cats__head p {
    margin: 0.7rem 0 0;
    font-family: Manrope, system-ui, sans-serif;
    color: #3d4a45;
    line-height: 1.55;
  }
  .mm-cats__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.85rem, 2vw, 1.35rem);
  }
  .mm-cats__card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .mm-cats__visual {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 18px;
    background: #f7faf8;
  }
  .mm-cats__visual img,
  .mm-cats__fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .mm-cats__fallback {
    background:
      radial-gradient(circle at 30% 20%, rgba(168, 107, 116, 0.28), transparent 55%),
      linear-gradient(160deg, #d7e6df, #1f4d42);
  }
  .mm-cats__card:hover .mm-cats__visual img,
  .mm-cats__card:hover .mm-cats__fallback {
    transform: scale(1.05);
  }
  .mm-cats__title {
    display: block;
    margin-top: 0.85rem;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    color: #14201c;
    letter-spacing: -0.01em;
  }
  @media (max-width: 989px) {
    .mm-cats__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 549px) {
    .mm-cats__grid { grid-template-columns: 1fr 1fr; gap: 0.7rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MM Categories",
  "tag": "section",
  "class": "section-mm-cats",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "კატეგორიები"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "ყველაფერი დედისა და ბავშვის ყოველდღიური მოვლისთვის."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Fallback label" },
        { "type": "url", "id": "link", "label": "Fallback link" }
      ]
    }
  ],
  "presets": [{ "name": "MM Categories" }]
}
{% endschema %}
