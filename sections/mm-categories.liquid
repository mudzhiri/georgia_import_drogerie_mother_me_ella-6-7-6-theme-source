{{ 'mm-categories.css' | asset_url | stylesheet_tag }}

<section
  id="mm-categories-{{ section.id }}"
  class="mm-categories"
  aria-label="{{ section.settings.heading | default: 'Categories' | escape }}"
>
  <div class="mm-categories__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="visually-hidden">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="mm-categories__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign label = block.settings.label
          assign link = block.settings.link
          assign image = block.settings.image
          assign image_alt = block.settings.image_alt | default: label
          assign has_image = false
          if image != blank
            assign has_image = true
          endif
        -%}
        <a
          class="mm-categories__tile"
          {% if link == blank %}
            role="link"
            aria-disabled="true"
          {% else %}
            href="{{ link }}"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if has_image -%}
            <div class="mm-categories__media">
              {{
                image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000, 1200',
                  sizes: '(min-width: 768px) 40vw, 100vw',
                  alt: image_alt,
                  class: 'mm-categories__image'
              }}
            </div>
          {%- endif -%}
          {%- if label != blank -%}
            <p class="mm-categories__label">{{ label | escape }}</p>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MM Categories",
  "tag": "section",
  "class": "section-mm-categories",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading (screen reader)",
      "default": "Categories"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Without an image a clean text tile is shown."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MM Categories",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "label": "ბავშვებისთვის"
          }
        },
        {
          "type": "tile",
          "settings": {
            "label": "დედებისთვის"
          }
        }
      ]
    }
  ]
}
{% endschema %}
