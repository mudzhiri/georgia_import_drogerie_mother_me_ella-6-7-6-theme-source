{{ 'mm-categories.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mm-categories.js' | asset_url }}" defer></script>

<section
  id="mm-categories-{{ section.id }}"
  class="mm-categories"
  aria-label="{{ section.settings.heading | default: 'Categories' | escape }}"
>
  <div class="mm-categories__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="visually-hidden">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="mm-categories__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign label = block.settings.label
          assign link = block.settings.link
          assign image = block.settings.image
          assign tone = block.settings.tone | default: 'kids'
          if tone != 'kids' and tone != 'mamas'
            assign tone = 'kids'
          endif
          assign has_image = false
          if image != blank
            assign has_image = true
          endif
          assign focal_point = 'center'
          if has_image and image.presentation.focal_point != blank
            assign focal_point = image.presentation.focal_point
          endif
        -%}
        <a
          class="mm-categories__tile mm-categories__tile--{{ tone }}{% if has_image %} mm-categories__tile--with-image{% else %} mm-categories__tile--text-only{% endif %}"
          {% if link == blank %}
            role="link"
            aria-disabled="true"
            tabindex="0"
          {% else %}
            href="{{ link }}"
          {% endif %}
          {% if has_image %}style="--mm-cat-focal: {{ focal_point }};"{% endif %}
          {{ block.shopify_attributes }}
        >
          <div class="mm-categories__body">
            {%- if label != blank -%}
              <p class="mm-categories__label">{{ label | escape }}</p>
            {%- endif -%}
          </div>

          {%- if has_image -%}
            <div class="mm-categories__media" aria-hidden="true">
              {{
                image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '320, 480, 640, 800, 1000, 1200',
                  sizes: '(min-width: 768px) 22vw, 80vw',
                  alt: '',
                  class: 'mm-categories__image'
              }}
            </div>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MM Categories",
  "tag": "section",
  "class": "section-mm-categories",
  "max_blocks": 2,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading (screen reader)",
      "default": "Categories"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "tone",
          "label": "Tile color",
          "default": "kids",
          "options": [
            {
              "value": "kids",
              "label": "Kids (sage)"
            },
            {
              "value": "mamas",
              "label": "Mamas (apricot)"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Without an image a compact text tile is shown. Focal point from the image editor is respected. Images are decorative because the tile label is visible."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MM Categories",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "label": "ბავშვებისთვის",
            "tone": "kids"
          }
        },
        {
          "type": "tile",
          "settings": {
            "label": "დედებისთვის",
            "tone": "mamas"
          }
        }
      ]
    }
  ]
}
{% endschema %}
