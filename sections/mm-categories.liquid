{{ 'mm-categories.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_heading = section.settings.heading
  if section_heading == blank
    assign section_heading = 'mm_home.categories.heading' | t
  endif
-%}
<section
  id="mm-categories-{{ section.id }}"
  class="mm-categories mm-reveal"
  aria-label="{{ section_heading | escape }}"
>
  <div class="mm-categories__inner">
    {%- if section_heading != blank -%}
      <h2 class="visually-hidden">{{ section_heading | escape }}</h2>
    {%- endif -%}

    <div class="mm-categories__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tone = block.settings.tone | default: 'kids'
          if tone != 'kids' and tone != 'mamas'
            assign tone = 'kids'
          endif

          if tone == 'mamas'
            assign label = 'mm_home.categories.mamas_label' | t
            assign description = 'mm_home.categories.mamas_desc' | t
          else
            assign label = 'mm_home.categories.kids_label' | t
            assign description = 'mm_home.categories.kids_desc' | t
          endif

          if block.settings.label != blank
            assign label = block.settings.label
          endif
          if block.settings.description != blank
            assign description = block.settings.description
          endif

          assign link = block.settings.link
          assign image = block.settings.image
          assign tile_collection = block.settings.collection
          if tile_collection != blank
            if link == blank
              assign link = tile_collection.url
            endif
            if image == blank and tile_collection.featured_image != blank
              assign image = tile_collection.featured_image
            elsif image == blank and tile_collection.image != blank
              assign image = tile_collection.image
            endif
            if image == blank
              for product in tile_collection.products limit: 1
                if product.featured_media != blank
                  assign image = product.featured_media.preview_image
                elsif product.featured_image != blank
                  assign image = product.featured_image
                endif
              endfor
            endif
          endif

          assign has_image = false
          if image != blank
            assign has_image = true
          endif
          assign focal_point = 'center'
          if has_image and image.presentation.focal_point != blank
            assign focal_point = image.presentation.focal_point
          endif
        -%}
        {%- if label != blank -%}
          <a
            class="mm-categories__tile mm-categories__tile--{{ tone }}{% if has_image %} mm-categories__tile--with-image{% else %} mm-categories__tile--text-only{% endif %}"
            data-mm-reveal-item
            {% if link == blank %}
              role="link"
              aria-disabled="true"
              tabindex="0"
            {% else %}
              href="{{ link }}"
            {% endif %}
            {% if has_image %}style="--mm-cat-focal: {{ focal_point }};"{% endif %}
            {{ block.shopify_attributes }}
          >
            <div class="mm-categories__body">
              <p class="mm-categories__label">{{ label | escape }}</p>
              {%- if description != blank -%}
                <p class="mm-categories__desc">{{ description | escape }}</p>
              {%- endif -%}
              <span class="mm-categories__arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" focusable="false">
                  <path d="M5 12h12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                  <path d="M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>

            {%- if has_image -%}
              <div class="mm-categories__media" aria-hidden="true">
                {{
                  image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '320, 480, 640, 800, 1000, 1200',
                    sizes: '(min-width: 768px) min(360px, 30vw), 80vw',
                    alt: '',
                    class: 'mm-categories__image'
                }}
              </div>
            {%- endif -%}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MM Categories",
  "tag": "section",
  "class": "section-mm-categories",
  "max_blocks": 2,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading override (optional)",
      "info": "Leave blank to use locale file (KA/EN/DE/RU via theme locales / Translate & Adapt)."
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        {
          "type": "select",
          "id": "tone",
          "label": "Tile (drives locale text + color)",
          "default": "kids",
          "options": [
            { "value": "kids", "label": "Kids / sage" },
            { "value": "mamas", "label": "Mamas / apricot" }
          ]
        },
        {
          "type": "text",
          "id": "label",
          "label": "Title override (optional)",
          "info": "Leave blank for translated locale text."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description override (optional)",
          "info": "Leave blank for translated locale text."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Optional. Image fallback + link when URL is empty."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Falls back to collection / first product image."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MM Categories",
      "blocks": [
        { "type": "tile", "settings": { "tone": "kids" } },
        { "type": "tile", "settings": { "tone": "mamas" } }
      ]
    }
  ]
}
{% endschema %}
