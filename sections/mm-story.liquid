<section class="mm-story">
  <div class="mm-story__media">
    <img
      src="{{ 'mm-apothecary-still.jpg' | asset_url }}"
      alt="{{ section.settings.image_alt }}"
      width="1600"
      height="900"
      loading="lazy"
    >
  </div>
  <div class="mm-story__copy">
    <p class="mm-story__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <p class="mm-story__text">{{ section.settings.text }}</p>
    {% if section.settings.cta_label != blank %}
      <a class="mm-btn mm-btn--primary" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
    {% endif %}
  </div>
</section>

<style>
  .mm-story {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    min-height: min(72vh, 640px);
    background: #f7faf8;
  }
  .mm-story__media {
    min-height: 320px;
    overflow: hidden;
  }
  .mm-story__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .mm-story__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4rem);
    background:
      radial-gradient(600px 320px at 90% 10%, rgba(168, 107, 116, 0.12), transparent 60%),
      #f7faf8;
  }
  .mm-story__eyebrow {
    margin: 0 0 0.75rem;
    font-family: Manrope, system-ui, sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #a86b74;
  }
  .mm-story__copy h2 {
    margin: 0;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(2.2rem, 4vw, 3.3rem);
    line-height: 1.05;
    color: #14201c;
    letter-spacing: -0.02em;
  }
  .mm-story__text {
    margin: 1rem 0 1.5rem;
    max-width: 32rem;
    font-family: Manrope, system-ui, sans-serif;
    color: #3d4a45;
    line-height: 1.65;
  }
  .mm-story .mm-btn--primary {
    align-self: flex-start;
    background: #1f4d42;
    color: #fff;
    border-radius: 999px;
    padding: 0.85rem 1.5rem;
    text-decoration: none;
    font-family: Manrope, system-ui, sans-serif;
    font-weight: 600;
  }
  @media (max-width: 899px) {
    .mm-story {
      grid-template-columns: 1fr;
    }
    .mm-story__media {
      min-height: 42vh;
    }
  }
</style>

{% schema %}
{
  "name": "MM Story",
  "tag": "section",
  "class": "section-mm-story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ჩვენს შესახებ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "დედის სიმშვიდე, ბავშვის კომფორტი"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "MOTHER & ME არის ქართული ოჯახური დროგერია: ევროპიდან შერჩეული მოვლის საშუალებები, გამჭვირვალე ფასები ლარში და მიწოდება მთელ საქართველოში."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA",
      "default": "ბავშვის კანის მოვლა"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt",
      "default": "MOTHER & ME მოვლის პროდუქტები"
    }
  ],
  "presets": [{ "name": "MM Story" }]
}
{% endschema %}
