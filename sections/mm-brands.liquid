{{ 'mm-brands.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'mm_home.brands.heading' | t
  endif
  assign visible = 0
  for block in section.blocks
    if block.settings.name != blank or block.settings.logo != blank
      assign visible = visible | plus: 1
    endif
  endfor
-%}

{%- if visible > 0 -%}
  <section
    id="mm-brands-{{ section.id }}"
    class="mm-brands mm-reveal"
    aria-labelledby="mm-brands-heading-{{ section.id }}"
  >
    <div class="mm-brands__inner">
      {%- if heading != blank -%}
        <h2 id="mm-brands-heading-{{ section.id }}" class="mm-brands__heading">
          {{ heading | escape }}
        </h2>
      {%- endif -%}

      <ul class="mm-brands__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign name = block.settings.name
            assign logo = block.settings.logo
            assign link = block.settings.link
            assign label = name
            if label == blank and logo != blank
              assign label = logo.alt | default: 'Brand'
            endif
          -%}
          {%- if name != blank or logo != blank -%}
            <li class="mm-brands__item" data-mm-reveal-item {{ block.shopify_attributes }}>
              {%- if link != blank -%}
                <a class="mm-brands__mark" href="{{ link }}" aria-label="{{ label | escape }}">
                  {%- if logo != blank -%}
                    {{
                      logo
                      | image_url: width: 320
                      | image_tag:
                        loading: 'lazy',
                        widths: '120, 160, 240, 320',
                        sizes: '120px',
                        alt: label,
                        class: 'mm-brands__logo'
                    }}
                  {%- else -%}
                    <span class="mm-brands__name">{{ name | escape }}</span>
                  {%- endif -%}
                </a>
              {%- else -%}
                <span class="mm-brands__mark">
                  {%- if logo != blank -%}
                    {{
                      logo
                      | image_url: width: 320
                      | image_tag:
                        loading: 'lazy',
                        widths: '120, 160, 240, 320',
                        sizes: '120px',
                        alt: label,
                        class: 'mm-brands__logo'
                    }}
                  {%- else -%}
                    <span class="mm-brands__name">{{ name | escape }}</span>
                  {%- endif -%}
                </span>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      <p class="visually-hidden">{{ 'mm_home.brands.note' | t }}</p>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "MM Brands",
  "tag": "section",
  "class": "section-mm-brands",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ბრენდები ჩვენს ასორტიმენტში"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Brand name",
          "default": "Brand"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo",
          "info": "Optional. Without a logo the brand name is shown."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional. Only set a real brand/collection page — never invent partnerships."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MM Brands",
      "blocks": [
        { "type": "brand", "settings": { "name": "babylove" } },
        { "type": "brand", "settings": { "name": "Balea" } },
        { "type": "brand", "settings": { "name": "LILLYDOO" } },
        { "type": "brand", "settings": { "name": "dmBio" } },
        { "type": "brand", "settings": { "name": "Schaebens" } },
        { "type": "brand", "settings": { "name": "CD" } }
      ]
    }
  ]
}
{% endschema %}
