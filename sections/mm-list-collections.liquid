{{ 'mm-list-collections.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign mm_heading = section.settings.heading | strip
  if mm_heading == blank
    assign mm_heading = 'general.categories' | t
  endif
  assign mm_hide_empty = section.settings.hide_empty
-%}
<section
  id="mm-list-collections-{{ section.id }}"
  class="mm-list-collections"
  aria-labelledby="mm-list-collections-heading-{{ section.id }}"
>
  <div class="mm-list-collections__inner">
    <h1 id="mm-list-collections-heading-{{ section.id }}" class="mm-list-collections__heading">
      {{ mm_heading | escape }}
    </h1>

    {%- for block in section.blocks -%}
      {%- if block.type == 'group' -%}
        {%- assign mm_group_title = block.settings.title | strip -%}
        {%- if mm_group_title != blank -%}
          <h2 class="mm-list-collections__group" {{ block.shopify_attributes }}>
            {{ mm_group_title | escape }}
          </h2>
        {%- endif -%}
      {%- elsif block.type == 'collection' -%}
        {%- assign mm_col = block.settings.collection -%}
        {%- if mm_col != blank -%}
          {%- liquid
            assign mm_role = block.settings.role | default: 'standard'
            if mm_role != 'featured' and mm_role != 'standard'
              assign mm_role = 'standard'
            endif
            assign mm_count = mm_col.all_products_count
            if mm_count == blank
              assign mm_count = mm_col.products_count
            endif
            assign mm_skip = false
            if mm_hide_empty and mm_count == 0 and mm_role != 'featured'
              assign mm_skip = true
            endif
          -%}
          {%- unless mm_skip -%}
            {%- liquid
              assign mm_title = block.settings.label | strip
              if mm_title == blank
                assign mm_title = mm_col.title
              endif
              assign mm_desc = block.settings.description | strip
              assign mm_img = block.settings.image
              if mm_img == blank
                assign mm_img = mm_col.image
              endif
              assign mm_fallback = block.settings.fallback_asset | strip
              if mm_fallback == blank
                case mm_col.handle
                  when 'ბავშვი'
                    assign mm_fallback = 'mm-cat-kids.jpg'
                  when 'დედა'
                    assign mm_fallback = 'mm-cat-mamas.jpg'
                  when 'ბავშვი-0-3-წლამდე'
                    assign mm_fallback = 'mm-cat-baby03.jpg'
                  when 'ბავშვის-ჰიგიენა-0-3-წლამდე'
                    assign mm_fallback = 'mm-cat-bath.jpg'
                  when 'ბავშვის-ჰიგიენა-3-წლიდან'
                    assign mm_fallback = 'mm-cat-bath.jpg'
                  when 'საბავშვო-კოსმეტიკა-3'
                    assign mm_fallback = 'mm-cat-kids.jpg'
                  when 'ბავშვის-კვება-0-3-წლამდე'
                    assign mm_fallback = 'mm-cat-feed.jpg'
                  when 'სახის-მოვლა'
                    assign mm_fallback = 'mm-cat-face.jpg'
                  when 'დეოდორანტები'
                    assign mm_fallback = 'mm-cat-deo.jpg'
                endcase
              endif
              assign mm_use_asset = false
              if mm_img == blank and mm_fallback != blank
                assign mm_use_asset = true
              endif
              assign mm_show_count = false
              if section.settings.show_counts and mm_count > 0
                assign mm_show_count = true
              endif
              assign mm_count_label = 'mm_home.categories.products_count' | t: count: mm_count
              if mm_count_label contains 'Translation missing'
                assign mm_count_label = mm_count | append: ' პროდუქტი'
              endif
            -%}
            <a
              class="mm-list-collections__card mm-list-collections__card--{{ mm_role }}"
              href="{{ mm_col.url }}"
              {{ block.shopify_attributes }}
            >
              <span class="mm-list-collections__media">
                {%- if mm_img != blank -%}
                  {{
                    mm_img
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '200, 300, 400, 600, 800',
                      sizes: '(min-width: 1100px) 25vw, (min-width: 750px) 33vw, 50vw',
                      class: 'mm-list-collections__image',
                      alt: mm_title
                  }}
                {%- elsif mm_use_asset -%}
                  <img
                    class="mm-list-collections__image"
                    src="{{ mm_fallback | asset_img_url: '600x' }}"
                    srcset="{{ mm_fallback | asset_img_url: '300x' }} 300w, {{ mm_fallback | asset_img_url: '400x' }} 400w, {{ mm_fallback | asset_img_url: '600x' }} 600w, {{ mm_fallback | asset_img_url: '800x' }} 800w"
                    sizes="(min-width: 1100px) 25vw, (min-width: 750px) 33vw, 50vw"
                    width="600"
                    height="600"
                    loading="lazy"
                    decoding="async"
                    alt="{{ mm_title | escape }}"
                  >
                {%- else -%}
                  <span class="mm-list-collections__placeholder" aria-hidden="true">
                    <svg class="mm-list-collections__placeholder-icon" viewBox="0 0 48 48" width="40" height="40" focusable="false" aria-hidden="true">
                      <rect x="6" y="10" width="36" height="28" rx="4" fill="none" stroke="currentColor" stroke-width="2"/>
                      <circle cx="18" cy="20" r="3" fill="currentColor"/>
                      <path d="M8 34l10-10 6 6 8-10 8 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                {%- endif -%}
              </span>
              <span class="mm-list-collections__meta">
                <span class="mm-list-collections__title">{{ mm_title | escape }}</span>
                {%- if mm_desc != blank -%}
                  <span class="mm-list-collections__desc">{{ mm_desc | escape }}</span>
                {%- endif -%}
                {%- if mm_show_count -%}
                  <span class="mm-list-collections__count">{{ mm_count_label | escape }}</span>
                {%- endif -%}
              </span>
              <span class="mm-list-collections__arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" focusable="false">
                  <path d="M5 12h12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                  <path d="M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          {%- endunless -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "MM list collections",
  "tag": "section",
  "class": "section-mm-list-collections",
  "max_blocks": 40,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Page heading",
      "info": "Leave blank for Georgian default (კატეგორიები)."
    },
    {
      "type": "checkbox",
      "id": "hide_empty",
      "label": "Hide empty standard collections",
      "default": true,
      "info": "Featured hub collections stay visible even with 0 products so customers can still open the audience entry."
    },
    {
      "type": "checkbox",
      "id": "show_counts",
      "label": "Show live product counts",
      "default": true,
      "info": "Uses the current collection product count. Hidden when the count is 0."
    }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Group heading",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Group title",
          "info": "Georgian group label shown above the following cards."
        }
      ]
    },
    {
      "type": "collection",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "select",
          "id": "role",
          "label": "Card weight",
          "default": "standard",
          "options": [
            { "value": "featured", "label": "Featured audience hub" },
            { "value": "standard", "label": "Standard product area" }
          ],
          "info": "Featured hubs stay visible when empty and use a larger card."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Title override",
          "info": "Optional. Defaults to the collection title."
        },
        {
          "type": "text",
          "id": "description",
          "label": "Short description (optional)",
          "info": "Only when it adds clarity. Do not repeat the title."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Lifestyle image override",
          "info": "Optional. Overrides the Shopify collection image. Swap without code."
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Theme asset fallback filename",
          "info": "Optional. Example: mm-cat-bath.jpg"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MM list collections"
    }
  ]
}
{% endschema %}
