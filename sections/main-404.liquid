{{ 'mm-404.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign kids_collection = collections['ბავშვი']
  assign mamas_collection = collections['დედა']
  assign show_kids = false
  assign show_mamas = false
  if kids_collection != blank and kids_collection.url != blank
    assign show_kids = true
  endif
  if mamas_collection != blank and mamas_collection.url != blank
    assign show_mamas = true
  endif
-%}

<section
  id="mm-404-{{ section.id }}"
  class="mm-404"
  aria-labelledby="mm-404-heading-{{ section.id }}"
>
  <div class="mm-404__inner">
    <h1 id="mm-404-heading-{{ section.id }}" class="mm-404__heading">
      {{ 'templates.404.title' | t }}
    </h1>

    <p class="mm-404__hint">
      {{ 'templates.404.description' | t }}
    </p>

    <div class="mm-404__actions">
      <a class="mm-404__button" href="{{ routes.root_url }}">
        {{ 'templates.404.button' | t }}
      </a>
    </div>

    {%- if show_kids or show_mamas -%}
      <ul class="mm-404__links">
        {%- if show_kids -%}
          <li>
            <a class="mm-404__link" href="{{ kids_collection.url }}">
              {{ 'templates.404.kids' | t }}
            </a>
          </li>
        {%- endif -%}
        {%- if show_mamas -%}
          <li>
            <a class="mm-404__link" href="{{ mamas_collection.url }}">
              {{ 'templates.404.mamas' | t }}
            </a>
          </li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "MM 404",
  "tag": "div",
  "class": "section-mm-404",
  "settings": [
    {
      "type": "paragraph",
      "content": "Uses Shopify 404 template status. Home link via routes.root_url. Kids/Mamas links use existing collections when available."
    }
  ]
}
{% endschema %}
