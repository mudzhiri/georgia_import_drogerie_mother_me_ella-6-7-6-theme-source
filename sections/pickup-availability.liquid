{%- assign pick_up_availabilities = product_variant.store_availabilities | where: 'pick_up_enabled', true -%}

{%- comment -%}
  Soften internal location labels (e.g. GEO WAREHOUSE) for storefront copy.
  Do not invent hours or addresses — only rename known warehouse codes.
{%- endcomment -%}
{%- capture mm_pickup_label_tbilisi -%}{{ 'products.product.trust.pickup_location_tbilisi' | t }}{%- endcapture -%}
{%- if mm_pickup_label_tbilisi == blank or mm_pickup_label_tbilisi contains 'Translation missing' -%}
  {%- assign mm_pickup_label_tbilisi = 'თბილისი' -%}
{%- endif -%}

{%- if pick_up_availabilities.size > 0 -%}
    <pickup-availability-preview class="pickup-availability-preview">
        <div class="pickup-availability-info">
            {%- assign closest_location = pick_up_availabilities.first -%}
            {%- liquid
              assign mm_loc_name = closest_location.location.name | strip
              assign mm_loc_down = mm_loc_name | downcase
              if mm_loc_down contains 'warehouse' or mm_loc_down == 'geo warehouse' or mm_loc_down contains 'geo ware'
                assign mm_loc_name = mm_pickup_label_tbilisi
              endif
            -%}

            {%- if closest_location.available -%}
                <p class="caption caption-text">
                    {% render 'icon-tick' %}
                    <span class="text">
                        {{ 'products.product.pickup_availability.pick_up_available_at_html' | t: location_name: mm_loc_name }}
                    </span>
                </p>
                <div class="pickup-availability-content">
                    <p class="caption">{{ closest_location.pick_up_time }}</p>
                    <button id="ShowPickupAvailabilityDrawer" class="pickup-availability-button link link-underline" aria-haspopup="dialog">
                        {%- if pick_up_availabilities.size == 1 -%}
                            {{ 'products.product.pickup_availability.view_store_info' | t }}
                        {%- else -%}
                            {{ 'products.product.pickup_availability.check_other_stores' | t }}
                        {%- endif -%}
                    </button>
                </div>
            {%- else -%}
                <p class="caption">
                    <span class="text">
                        {{ 'products.product.pickup_availability.pick_up_unavailable_at_html' | t: location_name: mm_loc_name }}
                    </span>
                </p>
                {%- if pick_up_availabilities.size > 1 -%}
                    <div class="pickup-availability-content">
                        <button id="ShowPickupAvailabilityDrawer" class="pickup-availability-button link link-underline" aria-haspopup="dialog">
                            {{ 'products.product.pickup_availability.check_other_stores' | t }}
                        </button>
                    </div>
                {%- endif -%}
            {%- endif -%}
        </div>
    </pickup-availability-preview>
    <pickup-availability-drawer tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="PickupAvailabilityHeading">
        <div class="pickup-availability-header text-left">
            <button class="pickup-availability-drawer-button" type="button" aria-label="{{ 'accessibility.close' | t }}">
                {%- render 'icon-close' -%}
            </button>
            <div class="pickup-availability-drawer-title" id="PickupAvailabilityHeading">
                {{ product_variant.product.title | escape }}
            </div>
        </div>
        <div class="pickup-availability-wrapper custom-scrollbar">
            <div class="pickup-availability-body">
                {%- unless product_variant.product.has_only_default_variant -%}
                    <p class="pickup-availability-variant">
                        {%- for product_option in product_variant.product.options_with_values -%}
                            {{ product_option.name | escape }}:&nbsp;
                            {%- for value in product_option.values -%}
                                {%- if product_option.selected_value == value -%}
                                  <span>{{ value | escape }}</span>
                                {%- endif -%}
                            {%- endfor -%}
                            {%- unless forloop.last -%},&nbsp;{%- endunless forloop.last -%}
                        {%- endfor -%}
                    </p>
                {%- endunless -%}
                <ul class="pickup-availability-list list-unstyled" role="list" data-store-availability-drawer-content>
                    {%- for availability in pick_up_availabilities -%}
                        {%- liquid
                          assign mm_item_name = availability.location.name | strip
                          assign mm_item_down = mm_item_name | downcase
                          if mm_item_down contains 'warehouse' or mm_item_down == 'geo warehouse' or mm_item_down contains 'geo ware'
                            assign mm_item_name = mm_pickup_label_tbilisi
                          endif
                        -%}
                        <li class="pickup-availability-list__item">
                            <h3 class="pickup-availability-heading">{{ mm_item_name | escape }}</h3>
                                <p class="pickup-availability-preview">
                                    {%- if availability.available -%}
                                        {% render 'icon-tick' %} {{ 'products.product.pickup_availability.pick_up_available' | t }}, {{ availability.pick_up_time | downcase }}
                                    {%- endif -%}
                                </p>
                            {%- assign address = availability.location.address -%}
                            <address class="pickup-availability-address">
                                {{ address | format_address }}

                                {%- if address.phone.size > 0 -%}
                                    <p>{{ address.phone }}</p>
                                {%- endif -%}
                            </address>
                        </li>
                    {%- endfor -%}
                </ul>
            </div>
        </div>
    </pickup-availability-drawer>
{%- endif -%}
