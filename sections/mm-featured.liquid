<section class="mm-featured">
  <div class="mm-featured__inner">
    <header class="mm-featured__head">
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p>{{ section.settings.subheading }}</p>
      {% endif %}
    </header>
    {% assign col = collections[section.settings.collection] %}
    <ul class="mm-featured__grid" role="list">
      {% if col != blank %}
        {% for product in col.products limit: section.settings.limit %}
          <li>
            <a class="mm-featured__card" href="{{ product.url }}">
              <span class="mm-featured__media">
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.title }}
                {% endif %}
              </span>
              <span class="mm-featured__meta">
                <span class="mm-featured__title">{{ product.title }}</span>
                <span class="mm-featured__price">{{ product.price | money }}</span>
              </span>
            </a>
          </li>
        {% endfor %}
      {% else %}
        {% for product in collections.all.products limit: section.settings.limit %}
          <li>
            <a class="mm-featured__card" href="{{ product.url }}">
              <span class="mm-featured__media">
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.title }}
                {% endif %}
              </span>
              <span class="mm-featured__meta">
                <span class="mm-featured__title">{{ product.title }}</span>
                <span class="mm-featured__price">{{ product.price | money }}</span>
              </span>
            </a>
          </li>
        {% endfor %}
      {% endif %}
    </ul>
    {% if section.settings.cta_label != blank %}
      <div class="mm-featured__cta">
        <a class="mm-btn mm-btn--primary" href="{{ section.settings.cta_link | default: '/collections/all' }}">{{ section.settings.cta_label }}</a>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .mm-featured {
    background: #eef3f0;
    padding: clamp(3rem, 7vw, 5.5rem) clamp(1.25rem, 4vw, 3rem);
  }
  .mm-featured__inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .mm-featured__head {
    margin-bottom: 2rem;
    max-width: 36rem;
  }
  .mm-featured__head h2 {
    margin: 0;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    color: #14201c;
    line-height: 1.05;
  }
  .mm-featured__head p {
    margin: 0.7rem 0 0;
    font-family: Manrope, system-ui, sans-serif;
    color: #3d4a45;
  }
  .mm-featured__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.85rem, 2vw, 1.35rem);
  }
  .mm-featured__card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .mm-featured__card:hover {
    transform: translateY(-6px);
  }
  .mm-featured__media {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 18px;
    background: #f7faf8;
  }
  .mm-featured__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .mm-featured__card:hover img {
    transform: scale(1.05);
  }
  .mm-featured__meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 0.85rem;
  }
  .mm-featured__title {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: 1.15rem;
    line-height: 1.25;
    color: #14201c;
  }
  .mm-featured__price {
    font-family: Manrope, system-ui, sans-serif;
    font-size: 0.92rem;
    font-weight: 600;
    color: #1f4d42;
  }
  .mm-featured__cta {
    margin-top: 2rem;
  }
  .mm-featured .mm-btn--primary {
    display: inline-flex;
    background: #1f4d42;
    color: #fff;
    border-radius: 999px;
    padding: 0.85rem 1.5rem;
    text-decoration: none;
    font-family: Manrope, system-ui, sans-serif;
    font-weight: 600;
  }
  @media (max-width: 989px) {
    .mm-featured__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>

{% schema %}
{
  "name": "MM Featured",
  "tag": "section",
  "class": "section-mm-featured",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "რჩეული პროდუქტები"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "ყველაზე მოთხოვნადი მოვლის საშუალებები."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Products",
      "default": 8
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA",
      "default": "ყველას ნახვა"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    }
  ],
  "presets": [{ "name": "MM Featured" }]
}
{% endschema %}
