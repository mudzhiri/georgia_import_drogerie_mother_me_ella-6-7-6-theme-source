{{ 'mm-about.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'mm_home.about.heading' | t
  endif
  assign text = section.settings.text
  if text == blank
    assign text = 'mm_home.about.text' | t
  endif
  # Decode a stored &amp; entity once before the single | escape (avoids visible "MOTHER &amp; ME").
  if text contains '&amp;'
    assign text = text | replace: '&amp;', '&'
  endif
  if heading contains '&amp;'
    assign heading = heading | replace: '&amp;', '&'
  endif
  assign image = section.settings.image
  assign image_alt = section.settings.image_alt
  if image_alt == blank and heading != blank
    assign image_alt = heading
  endif
  assign button_label = section.settings.button_label
  if button_label == blank
    assign button_label = 'mm_home.about.link' | t
  endif
  assign button_link = section.settings.button_link
  assign has_image = false
  if image != blank
    assign has_image = true
  endif
  assign has_button = false
  if button_link != blank and button_label != blank
    assign has_button = true
  endif
  assign has_content = false
  if heading != blank or text != blank or has_image or has_button
    assign has_content = true
  endif
  assign focal_point = 'center'
  if has_image and image.presentation.focal_point != blank
    assign focal_point = image.presentation.focal_point
  endif
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  if heading_tag != 'h1' and heading_tag != 'h2'
    assign heading_tag = 'h2'
  endif

  assign trust_assortment = 'mm_home.about.trust_assortment' | t
  assign trust_shipping = 'mm_home.about.trust_shipping' | t
  assign trust_contact = 'mm_home.about.trust_contact' | t
  assign trust_payment = 'mm_home.about.trust_payment' | t
  assign contact_label = 'mm_home.about.link_contact' | t
  assign panel_kicker = 'mm_home.about.panel_kicker' | t
  assign panel_fact_select = 'mm_home.about.panel_fact_select' | t
  assign panel_fact_import = 'mm_home.about.panel_fact_import' | t
  assign panel_fact_reach = 'mm_home.about.panel_fact_reach' | t

  assign shipping_policy = shop.shipping_policy
  assign shipping_url = ''
  if shipping_policy != blank and shipping_policy.url != blank
    assign shipping_url = shipping_policy.url
  endif

  assign contact_page = pages['contact']
  if contact_page == empty
    assign contact_page = pages['contact-us']
  endif
  if contact_page == empty
    assign contact_page = pages['kontakt']
  endif
  if contact_page == empty
    assign contact_page = pages['კონტაქტი']
  endif
  assign contact_url = ''
  if contact_page != empty and contact_page.url != blank
    assign contact_url = contact_page.url
  endif

  assign about_url = button_link
  if about_url == blank
    assign about_page = pages['about']
    if about_page == empty
      assign about_page = pages['about-us']
    endif
    if about_page == empty
      assign about_page = pages['ჩვენს-შესახებ']
    endif
    if about_page != empty and about_page.url != blank
      assign about_url = about_page.url
    endif
  endif

  if contact_label == blank or contact_label contains 'Translation missing'
    assign contact_label = 'კონტაქტი'
  endif
-%}

{%- if has_content -%}
  <section
    id="mm-about-{{ section.id }}"
    class="mm-about mm-reveal"
    {% if heading != blank %}aria-labelledby="mm-about-heading-{{ section.id }}"{% endif %}
  >
    <div class="mm-about__inner">
      <div class="mm-about__layout{% if has_image %} mm-about__layout--with-image{% else %} mm-about__layout--with-placeholder{% endif %}" data-mm-reveal-item>
        {%- comment -%} Desktop: media left, copy right. Mobile: copy first, then media. {%- endcomment -%}
        <div class="mm-about__copy">
          {%- if heading != blank -%}
            <{{ heading_tag }} id="mm-about-heading-{{ section.id }}" class="mm-about__heading">
              {{ heading | escape }}
            </{{ heading_tag }}>
          {%- endif -%}
          {%- if text != blank -%}
            <div class="mm-about__text">{{ text | escape | newline_to_br }}</div>
          {%- endif -%}

          <ul class="mm-about__trust" role="list">
            {%- unless trust_assortment == blank or trust_assortment contains 'Translation missing' -%}
              <li class="mm-about__trust-item">
                {%- if about_url != blank -%}
                  <a class="mm-about__trust-chip" href="{{ about_url }}">{{ trust_assortment | escape }}</a>
                {%- else -%}
                  <span class="mm-about__trust-chip">{{ trust_assortment | escape }}</span>
                {%- endif -%}
              </li>
            {%- endunless -%}
            {%- unless trust_shipping == blank or trust_shipping contains 'Translation missing' -%}
              <li class="mm-about__trust-item">
                {%- if shipping_url != blank -%}
                  <a class="mm-about__trust-chip" href="{{ shipping_url }}">{{ trust_shipping | escape }}</a>
                {%- else -%}
                  <span class="mm-about__trust-chip">{{ trust_shipping | escape }}</span>
                {%- endif -%}
              </li>
            {%- endunless -%}
            {%- unless trust_payment == blank or trust_payment contains 'Translation missing' -%}
              <li class="mm-about__trust-item">
                <span class="mm-about__trust-chip">{{ trust_payment | escape }}</span>
              </li>
            {%- endunless -%}
            {%- unless trust_contact == blank or trust_contact contains 'Translation missing' -%}
              <li class="mm-about__trust-item">
                {%- if contact_url != blank -%}
                  <a class="mm-about__trust-chip" href="{{ contact_url }}">{{ trust_contact | escape }}</a>
                {%- else -%}
                  <span class="mm-about__trust-chip">{{ trust_contact | escape }}</span>
                {%- endif -%}
              </li>
            {%- endunless -%}
          </ul>

          <div class="mm-about__actions">
            {%- if has_button -%}
              <a class="mm-about__link" href="{{ button_link }}">
                {{ button_label | escape }}
                <span class="mm-about__link-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" focusable="false">
                    <path d="M5 12h12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                    <path d="M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </a>
            {%- elsif about_url != blank -%}
              <a class="mm-about__link" href="{{ about_url }}">
                {{ button_label | escape }}
                <span class="mm-about__link-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" focusable="false">
                    <path d="M5 12h12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                    <path d="M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </a>
            {%- endif -%}
            {%- if contact_url != blank -%}
              <a class="mm-about__link mm-about__link--secondary" href="{{ contact_url }}">
                {{ contact_label | escape }}
              </a>
            {%- endif -%}
          </div>
        </div>

        {%- if has_image -%}
          <figure class="mm-about__media" style="--mm-about-focal: {{ focal_point }};">
            {{
              image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200, 1400',
                sizes: '(min-width: 900px) 40vw, 100vw',
                alt: image_alt,
                class: 'mm-about__image'
            }}
          </figure>
        {%- else -%}
          {%- comment -%}
            No authentic photo yet: compact facts panel (not a fake warehouse/team image).
            Replace with a real selection/packing photo in the theme editor when available.
          {%- endcomment -%}
          <div class="mm-about__media mm-about__media--panel" aria-hidden="true">
            <div class="mm-about__panel">
              {%- unless panel_kicker == blank or panel_kicker contains 'Translation missing' -%}
                <p class="mm-about__panel-kicker">{{ panel_kicker | escape }}</p>
              {%- endunless -%}
              <ul class="mm-about__panel-facts">
                {%- unless panel_fact_select == blank or panel_fact_select contains 'Translation missing' -%}
                  <li>{{ panel_fact_select | escape }}</li>
                {%- endunless -%}
                {%- unless panel_fact_import == blank or panel_fact_import contains 'Translation missing' -%}
                  <li>{{ panel_fact_import | escape }}</li>
                {%- endunless -%}
                {%- unless panel_fact_reach == blank or panel_fact_reach contains 'Translation missing' -%}
                  <li>{{ panel_fact_reach | escape }}</li>
                {%- endunless -%}
              </ul>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "MM About",
  "tag": "section",
  "class": "section-mm-about",
  "settings": [
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "default": "h2",
      "options": [
        { "value": "h2", "label": "H2 (homepage section)" },
        { "value": "h1", "label": "H1 (standalone page)" }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "გერმანიიდან — შენი ოჯახისთვის",
      "info": "Leave blank to use the Georgian locale string."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "MOTHER & ME-ში ბავშვებისა და დედებისთვის მოვლისა და ჰიგიენის პროდუქტებს ვარჩევთ. პროდუქცია გერმანიიდან ჩამოგვაქვს და საქართველოში ვთავაზობთ მომხმარებლებს.\n\nჩვენთვის მნიშვნელოვანია გასაგები ინფორმაცია, ყურადღებიანი მომსახურება და მარტივი შეკვეთა.",
      "info": "Use a blank line between paragraphs. Only confirmed facts — import from Germany ≠ made in Germany."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link label",
      "default": "ჩვენს შესახებ",
      "info": "Shown only when a link target is set."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "About page link",
      "info": "Select the existing About us page. The button stays hidden until a valid URL is set."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Authentic photo",
      "info": "Real photo only (selection, packing, shipping prep, or people who consented). No stock photos as team/warehouse. Without a photo a quiet brand plane is shown — replace this in the theme editor."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Describe what the photo actually shows."
    }
  ],
  "presets": [
    {
      "name": "MM About"
    }
  ]
}
{% endschema %}
