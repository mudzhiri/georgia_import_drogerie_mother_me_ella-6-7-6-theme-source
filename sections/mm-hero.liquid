{{ 'mm-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'mm_home.hero.eyebrow' | t
  endif

  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'mm_home.hero.heading' | t
  endif

  assign text = section.settings.text
  if text == blank
    assign text = 'mm_home.hero.text' | t
  endif

  assign btn1_label = section.settings.button_1_label
  if btn1_label == blank
    assign btn1_label = 'mm_home.hero.button_kids' | t
  endif

  assign btn2_label = section.settings.button_2_label
  if btn2_label == blank
    assign btn2_label = 'mm_home.hero.button_mamas' | t
  endif

  assign btn1_link = section.settings.button_1_link
  assign btn2_link = section.settings.button_2_link

  assign image = section.settings.image
  assign image_alt = section.settings.image_alt
  if image_alt == blank
    assign image_alt = 'mm_home.hero.image_alt' | t
  endif
  # Decode a stored &amp; entity once before the single | escape.
  if eyebrow contains '&amp;'
    assign eyebrow = eyebrow | replace: '&amp;', '&'
  endif
  if heading contains '&amp;'
    assign heading = heading | replace: '&amp;', '&'
  endif
  if text contains '&amp;'
    assign text = text | replace: '&amp;', '&'
  endif
  if image_alt contains '&amp;'
    assign image_alt = image_alt | replace: '&amp;', '&'
  endif

  assign has_picker_image = false
  if image != blank
    assign has_picker_image = true
  endif

  assign has_fallback_image = false
  if has_picker_image == false
    assign has_fallback_image = true
  endif

  assign has_image = false
  if has_picker_image or has_fallback_image
    assign has_image = true
  endif

  assign focal_point = 'center'
  if has_picker_image and image.presentation.focal_point != blank
    assign focal_point = image.presentation.focal_point
  endif
-%}

<section
  id="mm-hero-{{ section.id }}"
  class="mm-hero"
  aria-labelledby="mm-hero-heading-{{ section.id }}"
  {% if has_image %}style="--mm-hero-focal: {{ focal_point }};"{% endif %}
>
  <div class="mm-hero__inner{% if has_image %} mm-hero__inner--with-image{% else %} mm-hero__inner--text-only{% endif %}">
    <div class="mm-hero__content">
      {%- if eyebrow != blank -%}
        <p class="mm-hero__eyebrow">{{ eyebrow | escape }}</p>
      {%- endif -%}

      {%- if heading != blank -%}
        <h1 id="mm-hero-heading-{{ section.id }}" class="mm-hero__heading">{{ heading | escape }}</h1>
      {%- endif -%}

      {%- if text != blank -%}
        <p class="mm-hero__text">{{ text | escape }}</p>
      {%- endif -%}

      {%- if btn1_label != blank or btn2_label != blank -%}
        <div class="mm-hero__actions">
          {%- if btn1_label != blank -%}
            {%- if btn1_link != blank -%}
              <a class="mm-hero__btn mm-hero__btn--primary" href="{{ btn1_link }}">
                <span class="mm-hero__btn-label">{{ btn1_label | escape }}</span>
                <span class="mm-hero__btn-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" focusable="false">
                    <path d="M5 12h12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                    <path d="M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </a>
            {%- else -%}
              <span class="mm-hero__btn mm-hero__btn--primary" aria-disabled="true">
                <span class="mm-hero__btn-label">{{ btn1_label | escape }}</span>
              </span>
            {%- endif -%}
          {%- endif -%}

          {%- if btn2_label != blank -%}
            {%- if btn2_link != blank -%}
              <a class="mm-hero__btn mm-hero__btn--secondary" href="{{ btn2_link }}">
                <span class="mm-hero__btn-label">{{ btn2_label | escape }}</span>
                <span class="mm-hero__btn-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" focusable="false">
                    <path d="M5 12h12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                    <path d="M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </a>
            {%- else -%}
              <span class="mm-hero__btn mm-hero__btn--secondary" aria-disabled="true">
                <span class="mm-hero__btn-label">{{ btn2_label | escape }}</span>
              </span>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if has_image -%}
      <div class="mm-hero__media">
        {%- if has_picker_image -%}
          {{
            image
            | image_url: width: 1600
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '480, 720, 960, 1200, 1600',
              sizes: '(min-width: 900px) min(660px, 55vw), calc(100vw - 32px)',
              alt: image_alt,
              class: 'mm-hero__image',
              width: image.width,
              height: image.height
          }}
        {%- else -%}
          <img
            class="mm-hero__image"
            src="{{ 'mm-hero-mother-child.jpg' | asset_url }}"
            srcset="{{ 'mm-hero-mother-child.jpg' | asset_url }} 1600w"
            sizes="(min-width: 900px) min(660px, 55vw), calc(100vw - 32px)"
            width="1600"
            height="1068"
            alt="{{ image_alt | escape }}"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          >
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "MM Hero",
  "tag": "section",
  "class": "section-mm-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow override (optional)",
      "info": "Leave blank for locale text (KA/EN/DE/RU)."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override (optional)",
      "info": "Leave blank for locale text (KA/EN/DE/RU)."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description override (optional)",
      "info": "Leave blank for locale text (KA/EN/DE/RU)."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary button override (optional)",
      "info": "Leave blank for locale text."
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary button link",
      "info": "Kids category — keep language-aware collection URL."
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary button override (optional)",
      "info": "Leave blank for locale text."
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary button link",
      "info": "Mamas category — keep language-aware collection URL."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Optional. Leave empty to use the theme default photo (theme asset). Set focal point in the media editor. Desktop: right. Mobile: below text."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt override (optional)",
      "info": "Leave blank for locale alt text. Do not describe stock people as our team or customers."
    }
  ],
  "presets": [
    {
      "name": "MM Hero"
    }
  ]
}
{% endschema %}
