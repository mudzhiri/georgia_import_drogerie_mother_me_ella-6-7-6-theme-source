{{ 'mm-brand.css' | asset_url | stylesheet_tag }}

<section class="mm-hero" data-mm-hero>
  <div class="mm-hero__media" aria-hidden="true">
    <img
      src="{{ 'mm-hero-mother-baby.jpg' | asset_url }}"
      alt=""
      width="1920"
      height="1080"
      fetchpriority="high"
      loading="eager"
    >
  </div>
  <div class="mm-hero__veil" aria-hidden="true"></div>
  <div class="mm-hero__content">
    <p class="mm-hero__eyebrow" style="color:#fff !important;">{{ section.settings.eyebrow }}</p>
    <h1 class="mm-hero__brand" style="color:#fff !important;-webkit-text-fill-color:#fff !important;">{{ section.settings.brand }}</h1>
    <p class="mm-hero__lead" style="color:rgba(255,255,255,.95) !important;">{{ section.settings.lead }}</p>
    <div class="mm-hero__actions">
      {% if section.settings.cta_label != blank %}
        <a class="mm-btn mm-btn--primary" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
      {% endif %}
      {% if section.settings.cta2_label != blank %}
        <a class="mm-btn mm-btn--ghost" href="{{ section.settings.cta2_link }}">{{ section.settings.cta2_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .mm-hero {
    position: relative;
    min-height: calc(100svh - 4.5rem);
    display: grid;
    place-items: stretch;
    overflow: hidden;
    color: #fff;
    isolation: isolate;
  }
  .mm-hero__media,
  .mm-hero__veil,
  .mm-hero__content {
    grid-area: 1 / 1;
  }
  .mm-hero__media img {
    width: 100%;
    height: 100%;
    min-height: calc(100svh - 4.5rem);
    object-fit: cover;
    object-position: 62% center;
    display: block;
    transform: scale(1.02);
    animation: mmHeroZoom 18s ease-out both;
  }
  .mm-hero__veil {
    background:
      linear-gradient(105deg, rgba(8, 14, 12, 0.78) 0%, rgba(8, 14, 12, 0.52) 38%, rgba(8, 14, 12, 0.22) 68%, rgba(8, 14, 12, 0.18) 100%),
      linear-gradient(180deg, rgba(8, 14, 12, 0.28) 0%, rgba(8, 14, 12, 0.12) 48%, rgba(8, 14, 12, 0.55) 100%);
    pointer-events: none;
  }
  .mm-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    max-width: 38rem;
    padding: clamp(1.5rem, 5vw, 4.5rem);
    padding-bottom: clamp(2.5rem, 8vh, 5.5rem);
    animation: mmHeroIn 1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .mm-hero__eyebrow {
    margin: 0 0 0.75rem;
    font-family: Manrope, system-ui, sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.88);
  }
  .mm-hero__brand {
    margin: 0;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 600;
    font-size: clamp(3.4rem, 9vw, 6.8rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.4);
  }
  .mm-hero__lead {
    margin: 1.1rem 0 0;
    max-width: 28rem;
    font-family: Manrope, system-ui, sans-serif;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.94);
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.35);
  }
  .mm-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.6rem;
  }
  .mm-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.85rem 1.55rem;
    border-radius: 999px;
    font-family: Manrope, system-ui, sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease, background 0.25s ease;
  }
  .mm-btn--primary {
    background: #1f4d42;
    color: #fff;
    box-shadow: 0 10px 28px rgba(10, 18, 15, 0.3);
  }
  .mm-btn--primary:hover {
    background: #163832;
    transform: translateY(-2px);
    color: #fff;
  }
  .mm-btn--ghost {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(8px);
  }
  .mm-btn--ghost:hover {
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
    transform: translateY(-2px);
  }
  @keyframes mmHeroIn {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes mmHeroZoom {
    from { transform: scale(1.08); }
    to { transform: scale(1.02); }
  }
  @media (max-width: 749px) {
    .mm-hero,
    .mm-hero__media img {
      min-height: calc(100svh - 3.75rem);
    }
    .mm-hero__media img {
      object-position: 70% center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mm-hero__media img,
    .mm-hero__content {
      animation: none;
    }
  }
</style>

{% schema %}
{
  "name": "MM Hero",
  "tag": "section",
  "class": "section-mm-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "თბილისი · დედა და ბავშვი"
    },
    {
      "type": "text",
      "id": "brand",
      "label": "Brand",
      "default": "MOTHER & ME"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead",
      "default": "შერჩეული ევროპული მოვლის პროდუქტები დედებისა და ბავშვებისთვის — ნაზი, სანდო, ყოველდღიური."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary CTA",
      "default": "ყველა პროდუქტი"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Secondary CTA",
      "default": "კატეგორიები"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Secondary link"
    }
  ],
  "presets": [{ "name": "MM Hero" }]
}
{% endschema %}
