{{ 'mm-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading
  assign text = section.settings.text
  assign btn1_label = section.settings.button_1_label
  assign btn1_link = section.settings.button_1_link
  assign btn2_label = section.settings.button_2_label
  assign btn2_link = section.settings.button_2_link
  assign image = section.settings.image
  assign image_alt = section.settings.image_alt | default: heading
  assign has_image = false
  if image != blank
    assign has_image = true
  endif
  assign focal_point = 'center'
  if has_image and image.presentation.focal_point != blank
    assign focal_point = image.presentation.focal_point
  endif
-%}

<section
  id="mm-hero-{{ section.id }}"
  class="mm-hero"
  aria-label="{{ heading | escape }}"
  {% if has_image %}style="--mm-hero-focal: {{ focal_point }};"{% endif %}
>
  <div class="mm-hero__inner{% if has_image %} mm-hero__inner--with-image{% endif %}">
    <div class="mm-hero__content">
      {%- if heading != blank -%}
        <h1 class="mm-hero__heading">{{ heading | escape }}</h1>
      {%- endif -%}

      {%- if text != blank -%}
        <p class="mm-hero__text">{{ text | escape }}</p>
      {%- endif -%}

      {%- if btn1_label != blank or btn2_label != blank -%}
        <div class="mm-hero__actions">
          {%- if btn1_label != blank -%}
            {%- if btn1_link != blank -%}
              <a class="mm-hero__btn mm-hero__btn--primary" href="{{ btn1_link }}">
                {{- btn1_label | escape -}}
              </a>
            {%- else -%}
              <span class="mm-hero__btn mm-hero__btn--primary" aria-disabled="true">
                {{- btn1_label | escape -}}
              </span>
            {%- endif -%}
          {%- endif -%}

          {%- if btn2_label != blank -%}
            {%- if btn2_link != blank -%}
              <a class="mm-hero__btn mm-hero__btn--secondary" href="{{ btn2_link }}">
                {{- btn2_label | escape -}}
              </a>
            {%- else -%}
              <span class="mm-hero__btn mm-hero__btn--secondary" aria-disabled="true">
                {{- btn2_label | escape -}}
              </span>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Only real images — never an empty reserved column {%- endcomment -%}
    {%- if has_image -%}
      <div class="mm-hero__media">
        {{
          image
          | image_url: width: 1600
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '480, 720, 960, 1200, 1600',
            sizes: '(min-width: 900px) min(704px, 55vw), calc(100vw - 32px)',
            alt: image_alt,
            class: 'mm-hero__image'
        }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "MM Hero",
  "tag": "section",
  "class": "section-mm-hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ზრუნვა შენზე და შენს პატარაზე"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "აღმოაჩინე გერმანიიდან ჩამოტანილი მოვლისა და ჰიგიენის პროდუქტები."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary button label",
      "default": "ბავშვებისთვის"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary button link",
      "info": "Kids category from the header menu"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary button label",
      "default": "დედებისთვის"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary button link",
      "info": "Mamas category from the header menu"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Desktop: right column. Mobile: below text. Set focal point in media editor. Leave empty for centered text-only layout."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    }
  ],
  "presets": [
    {
      "name": "MM Hero"
    }
  ]
}
{% endschema %}
