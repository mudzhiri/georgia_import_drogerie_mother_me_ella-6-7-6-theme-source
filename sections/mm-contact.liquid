{{ 'mm-contact.css' | asset_url | stylesheet_tag }}

{%- liquid
  if section.settings.heading != blank
    assign heading = section.settings.heading
  else
    assign heading = 'templates.contact.title' | t
  endif

  comment
    Email: same priority as mm-footer — section setting, then shop.email.
    Reject known Ella/demo placeholders. Never invent an address or phone.
  endcomment
  if section.settings.contact_email != blank
    assign contact_email = section.settings.contact_email | strip
  elsif shop.email != blank
    assign contact_email = shop.email | strip
  else
    assign contact_email = ''
  endif

  assign email_down = contact_email | downcase
  if email_down contains 'email@domain.com' or email_down contains 'example@domain.com' or email_down contains '@domain.com'
    assign contact_email = ''
  endif

  assign contact_phone = shop.phone | strip
  assign phone_down = contact_phone | downcase
  if contact_phone != blank
    if phone_down contains 'ella' or phone_down contains '555-5555' or phone_down contains '091-123' or phone_down contains '090-123' or phone_down contains '(090)' or phone_down contains '(415) 555'
      assign contact_phone = ''
    endif
  endif

  assign has_address = false
  assign address_blob = ''
  if shop.address != blank
    if shop.address.address1 != blank or shop.address.address2 != blank or shop.address.city != blank or shop.address.company != blank or shop.address.zip != blank
      assign address_blob = shop.address.company | append: ' ' | append: shop.address.address1 | append: ' ' | append: shop.address.address2 | append: ' ' | append: shop.address.city | append: ' ' | append: shop.address.zip | append: ' ' | append: shop.address.country
      assign address_down = address_blob | downcase
      if address_down contains 'san francisco' or address_down contains 'market street' or address_down contains 'divamus' or address_down contains "ella's garden" or address_down contains 'ellas garden' or address_down contains 'city name'
        assign has_address = false
      else
        assign has_address = true
      endif
    endif
  endif

  assign facebook_url = section.settings.facebook_url | strip
  if facebook_url == blank
    assign facebook_url = 'https://www.facebook.com/profile.php?id=61596296087284'
  endif
  unless facebook_url contains 'facebook.com'
    assign facebook_url = ''
  endunless

  assign has_details = false
  if contact_email != blank or contact_phone != blank or has_address or facebook_url != blank
    assign has_details = true
  endif

  assign form_id = 'mm-ContactForm-' | append: section.id
  assign name_id = 'mm-contact-name-' | append: section.id
  assign email_id = 'mm-contact-email-' | append: section.id
  assign message_id = 'mm-contact-message-' | append: section.id
  assign email_error_id = 'mm-contact-email-error-' | append: section.id
  assign message_error_id = 'mm-contact-message-error-' | append: section.id

  assign about_page = pages['about']
  if about_page == empty
    assign about_page = pages['about-us']
  endif
  if about_page == empty
    assign about_page = pages['uber-uns']
  endif
  assign about_url = ''
  if about_page != empty and about_page.url != blank
    assign about_url = about_page.url
  endif

  assign contact_intro = section.settings.intro
  if contact_intro == blank
    assign contact_intro = 'templates.contact.intro' | t
  endif
-%}

<section
  id="mm-contact-{{ section.id }}"
  class="mm-contact"
  aria-labelledby="mm-contact-heading-{{ section.id }}"
>
  <div class="mm-contact__inner">
    <h1 id="mm-contact-heading-{{ section.id }}" class="mm-contact__heading">
      {{ heading | escape }}
    </h1>
    {%- if contact_intro != blank -%}
      <p class="mm-contact__intro">{{ contact_intro | escape }}</p>
    {%- endif -%}

    <div class="mm-contact__layout{% unless has_details %} mm-contact__layout--form-only{% endunless %}">
      {%- if has_details -%}
        <aside class="mm-contact__details" aria-label="{{ 'templates.contact.info.aside' | t | escape }}">
          <ul class="mm-contact__list">
            {%- if contact_email != blank -%}
              <li class="mm-contact__item">
                <span class="mm-contact__label">{{ 'templates.contact.info.email' | t }}</span>
                <a class="mm-contact__value" href="mailto:{{ contact_email | escape }}">
                  {{ contact_email | escape }}
                </a>
              </li>
            {%- endif -%}
            {%- if facebook_url != blank -%}
              <li class="mm-contact__item">
                <span class="mm-contact__label">{{ 'templates.contact.info.facebook' | t }}</span>
                <a
                  class="mm-contact__value"
                  href="{{ facebook_url }}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Facebook
                </a>
              </li>
            {%- endif -%}
            {%- if contact_phone != blank -%}
              <li class="mm-contact__item">
                <span class="mm-contact__label">{{ 'templates.contact.info.phone' | t }}</span>
                <a class="mm-contact__value" href="tel:{{ contact_phone | replace: ' ', '' | escape }}">
                  {{ contact_phone | escape }}
                </a>
              </li>
            {%- endif -%}
            {%- if has_address -%}
              <li class="mm-contact__item">
                <span class="mm-contact__label">{{ 'templates.contact.info.address' | t }}</span>
                <span class="mm-contact__value mm-contact__value--address">
                  {%- if shop.address.company != blank -%}
                    <span class="mm-contact__address-line">{{ shop.address.company | escape }}</span>
                  {%- endif -%}
                  {%- if shop.address.address1 != blank -%}
                    <span class="mm-contact__address-line">{{ shop.address.address1 | escape }}</span>
                  {%- endif -%}
                  {%- if shop.address.address2 != blank -%}
                    <span class="mm-contact__address-line">{{ shop.address.address2 | escape }}</span>
                  {%- endif -%}
                  {%- if shop.address.city != blank or shop.address.zip != blank -%}
                    <span class="mm-contact__address-line">
                      {%- if shop.address.zip != blank -%}{{ shop.address.zip | escape }} {% endif -%}
                      {%- if shop.address.city != blank -%}{{ shop.address.city | escape }}{%- endif -%}
                    </span>
                  {%- endif -%}
                  {%- if shop.address.country != blank -%}
                    <span class="mm-contact__address-line">{{ shop.address.country | escape }}</span>
                  {%- endif -%}
                </span>
                <p class="mm-contact__hint">{{ 'templates.contact.info.address_note' | t }}</p>
              </li>
            {%- endif -%}
            <li class="mm-contact__item">
              <span class="mm-contact__label">{{ 'templates.contact.info.shipping' | t }}</span>
              <span class="mm-contact__value">{{ 'templates.contact.info.shipping_note' | t }}</span>
            </li>
          </ul>
          <p class="mm-contact__order-hint">{{ 'templates.contact.info.order_hint' | t }}</p>
          {%- if about_url != blank -%}
            <a class="mm-contact__about-link" href="{{ about_url }}">
              {{ 'templates.contact.info.about_link' | t }}
            </a>
          {%- endif -%}
        </aside>
      {%- endif -%}

      <div class="mm-contact__form-wrap">
        {%- form 'contact', id: form_id, class: 'mm-contact__form' -%}
          {%- if form.posted_successfully? -%}
            <div class="mm-contact__alert mm-contact__alert--success" role="status" aria-live="polite">
              <p>{{ 'templates.contact.form.post_success' | t }}</p>
            </div>
          {%- elsif form.errors -%}
            <div
              class="mm-contact__alert mm-contact__alert--error"
              id="mm-contact-errors-{{ section.id }}"
              role="alert"
              aria-live="assertive"
              tabindex="-1"
              autofocus
            >
              <p class="mm-contact__alert-heading">{{ 'templates.contact.form.error_heading' | t }}</p>
              <ul class="mm-contact__error-list">
                {%- for field in form.errors -%}
                  <li>
                    {%- if field == 'form' -%}
                      {{ form.errors.messages[field] }}
                    {%- else -%}
                      {%- liquid
                        assign error_anchor = ''
                        if field == 'email'
                          assign error_anchor = email_id
                        elsif field == 'body'
                          assign error_anchor = message_id
                        elsif field == 'name'
                          assign error_anchor = name_id
                        endif
                      -%}
                      {%- if error_anchor != blank -%}
                        <a href="#{{ error_anchor }}">
                          {{ form.errors.translated_fields[field] | default: field | capitalize }}
                          {{ form.errors.messages[field] }}
                        </a>
                      {%- else -%}
                        {{ form.errors.translated_fields[field] | default: field | capitalize }}
                        {{ form.errors.messages[field] }}
                      {%- endif -%}
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="mm-contact__field{% if form.errors contains 'name' %} mm-contact__field--error{% endif %}">
            <label class="mm-contact__field-label" for="{{ name_id }}">
              {{ 'templates.contact.form.name' | t }}
            </label>
            <input
              class="mm-contact__input"
              type="text"
              id="{{ name_id }}"
              name="contact[name]"
              autocomplete="name"
              autocapitalize="words"
              {% if form.errors contains 'name' %}
                aria-invalid="true"
                aria-describedby="mm-contact-name-error-{{ section.id }}"
              {% endif %}
              value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}"
            >
            {%- if form.errors contains 'name' -%}
              <p id="mm-contact-name-error-{{ section.id }}" class="mm-contact__field-error">
                {{ form.errors.translated_fields.name | capitalize }}
                {{ form.errors.messages.name }}
              </p>
            {%- endif -%}
          </div>

          <div class="mm-contact__field{% if form.errors contains 'email' %} mm-contact__field--error{% endif %}">
            <label class="mm-contact__field-label" for="{{ email_id }}">
              {{ 'templates.contact.form.email' | t }}
              <span class="mm-contact__required" aria-hidden="true">*</span>
              <span class="visually-hidden">{{ 'templates.contact.form.required' | t }}</span>
            </label>
            <input
              class="mm-contact__input"
              type="email"
              id="{{ email_id }}"
              name="contact[email]"
              autocomplete="email"
              autocapitalize="off"
              autocorrect="off"
              spellcheck="false"
              required
              aria-required="true"
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="{{ email_error_id }}"
              {% endif %}
              value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"
            >
            {%- if form.errors contains 'email' -%}
              <p id="{{ email_error_id }}" class="mm-contact__field-error">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
          </div>

          <div class="mm-contact__field{% if form.errors contains 'body' %} mm-contact__field--error{% endif %}">
            <label class="mm-contact__field-label" for="{{ message_id }}">
              {{ 'templates.contact.form.message' | t }}
              <span class="mm-contact__required" aria-hidden="true">*</span>
              <span class="visually-hidden">{{ 'templates.contact.form.required' | t }}</span>
            </label>
            <textarea
              class="mm-contact__input mm-contact__textarea"
              id="{{ message_id }}"
              name="contact[body]"
              rows="6"
              required
              aria-required="true"
              {% if form.errors contains 'body' %}
                aria-invalid="true"
                aria-describedby="{{ message_error_id }}"
              {% endif %}
            >{% if form.body %}{{ form.body }}{% endif %}</textarea>
            {%- if form.errors contains 'body' -%}
              <p id="{{ message_error_id }}" class="mm-contact__field-error">
                {{ form.errors.translated_fields.body | capitalize }}
                {{ form.errors.messages.body }}
              </p>
            {%- endif -%}
          </div>

          <div class="mm-contact__actions">
            <button type="submit" class="mm-contact__submit">
              {{ 'templates.contact.form.send' | t }}
            </button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MM Contact",
  "tag": "section",
  "class": "section-mm-contact",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override",
      "info": "Leave blank for Georgian default დაგვიკავშირდით."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro override",
      "info": "Leave blank for locale intro. Only confirmed contact facts."
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Public contact email",
      "default": "info@motherandme.ge",
      "info": "Same public email as footer. Falls back to Shopify shop email when empty. Demo placeholders are hidden."
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook page URL",
      "info": "Confirmed public page: https://www.facebook.com/profile.php?id=61596296087284 — used as fallback when empty."
    },
    {
      "type": "paragraph",
      "content": "Phone and address come only from Shopify Settings → Store details. Ella demo values are hidden. Address is labeled as pickup location (not a walk-in retail store). No map embed. No invented opening hours or response times."
    }
  ],
  "presets": [
    {
      "name": "MM Contact"
    }
  ]
}
{% endschema %}
