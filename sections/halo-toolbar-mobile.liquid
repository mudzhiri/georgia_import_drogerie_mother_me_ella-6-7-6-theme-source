{%- if section.settings.display_section -%}
{{ 'component-toolbar-mobile.css' | asset_url | stylesheet_tag }}
{%- capture mm_wishlist_url -%}{% render 'mm-wishlist-url' %}{%- endcapture -%}
{%- assign mm_wishlist_url = mm_wishlist_url | strip -%}
<div class="halo-sticky-toolbar-mobile">
    <div class="bottom-bar">
        <ul class="bottom-bar--list">
            {%- liquid 
                assign font_size = section.settings.font_size | append: 'px'
                assign font_weight = section.settings.font_weight
                assign icon_size = section.settings.icon_size | append: 'px'
            -%}

            {% if routes.account_login_url contains '/account/login' %}
                {% assign is_contained = true %}
            {% else %}
                {% assign is_contained = false %}
            {% endif %}

            {%- for block in section.blocks -%}
                {%- liquid
                    assign icon = block.settings.icon
                    assign text = block.settings.text
                    assign action_icon = block.settings.action_to
                    if block.type == 'link'
                        assign link = block.settings.link
                    else
                        assign link = blank
                    endif
                    # Prefer locale labels for known English leftovers / blanks (theme settings stay editable).
                    if text == blank or text == 'Home' or text == 'Search' or text == 'Cart' or text == 'Account' or text == 'Collection' or text == 'Wishlist'
                      if action_icon == 'search'
                        assign text = 'general.toolbar_mobile.search' | t
                      elsif action_icon == 'cart'
                        assign text = 'general.toolbar_mobile.cart' | t
                      elsif action_icon == 'account'
                        assign text = 'general.toolbar_mobile.account' | t
                      elsif action_icon == 'wishlist'
                        assign text = 'general.toolbar_mobile.wishlist' | t
                      elsif text == 'Home' or link == '/' or link == routes.root_url
                        assign text = 'general.toolbar_mobile.home' | t
                      elsif text == 'Collection' or text == blank
                        assign text = 'general.toolbar_mobile.collections' | t
                      endif
                    endif
                    assign show_toolbar_item = true
                    if action_icon == 'wishlist'
                      unless settings.show_wishlist and mm_wishlist_url != blank
                        assign show_toolbar_item = false
                      endunless
                    endif
                -%}
                {%- if show_toolbar_item and icon != blank or show_toolbar_item and text != blank -%}
                    <li class="list-item{% if action_icon == 'account' %}{% unless shop.customer_accounts_enabled %} customer_accounts_disable{% endunless %}{% endif %}{% if action_icon == 'wishlist' or action_icon == 'cart' %} list-item--badge{% endif %}" style="--font-size: {{ font_size }}; --font-weight: {{ font_weight }}; --icon-size: {{ icon_size }}">
                        <a
                          {%- if action_icon == 'wishlist' and mm_wishlist_url != blank -%}
                            href="{{ mm_wishlist_url }}"
                            class="list-item-wishlist"
                          {%- elsif action_icon == 'account' -%}
                            {%- unless is_contained %} href="{{ routes.account_login_url }}"{% endunless -%}
                            {%- if is_contained %} role="link" aria-disabled="true" data-open-auth-sidebar{% endif -%}
                          {%- elsif link != blank -%}
                            href="{{ link }}"
                          {%- elsif action_icon == 'cart' -%}
                            {%- if settings.show_quick_cart -%}
                              role="link" aria-disabled="true" data-cart-sidebar
                            {%- else -%}
                              href="{{ routes.cart_url }}" class="list-item-cart"
                            {%- endif -%}
                          {%- elsif action_icon == 'search' -%}
                            role="link" aria-disabled="true" data-search-mobile
                          {%- elsif block.type == 'content' -%}
                            role="link" aria-disabled="true" data-bar-content
                          {%- else -%}
                            role="link" aria-disabled="true"
                          {%- endif -%}
                        >
                            <span class="icon">
                              {%- if icon != blank -%}
                                {{ icon }}
                              {%- elsif action_icon == 'wishlist' -%}
                                {% render 'icon-heart' %}
                              {%- endif -%}
                            </span>
                            <span class="text">{{ text | escape }}</span>
                            {%- if action_icon == 'cart' -%}
                                <div
                                  class="cart-count-bubble mm-toolbar-cart-bubble{% if cart.item_count == 0 %} is-empty{% endif %}"
                                  aria-hidden="true"
                                  {% if cart.item_count == 0 %}hidden{% endif %}
                                >
                                    <span class="mm-toolbar-cart-count" data-cart-count>{%- if cart.item_count < 100 -%}{{ cart.item_count }}{%- else -%}{{ 'sections.cart.item_99' | t }}{%- endif -%}</span>
                                </div>
                                <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
                            {%- endif -%}
                            {%- if action_icon == 'wishlist' -%}
                                <div class="wishlist-count-bubble mm-toolbar-wishlist-bubble" aria-hidden="true" hidden>
                                    <span class="mm-toolbar-wishlist-count" data-wishlist-count></span>
                                </div>
                            {%- endif -%}
                        </a>
                        {%- if block.type == 'content' -%}
                            <div class="block-content bottom-bar--content" id="{{ block.id }}">
                                <button type="button" class="bottom-bar--close halo-sidebar-close clearfix" data-close-content-sidebar aria-label="{{ 'general.common.close' | t }}">{% render 'icon-close' %}{{ 'general.common.close' | t }}</button>
                                <div class="rte">{{ block.settings.content }}</div>
                            </div>
                        {% endif %}
                    </li>
                {%- endif -%}
            {%- endfor -%}
        </ul>
    </div>
</div>
<style>
    {%- liquid
        assign color_icon = section.settings.color_icon
        assign bg_color = section.settings.bg_color
        assign bg_color_gradient = section.settings.bg_color_gradient
        assign border_color = section.settings.border_color
        if color_icon == blank or color_icon == 'rgba(0,0,0,0)'
          assign color_icon = '#214d43'
        endif
    -%}
    .halo-sticky-toolbar-mobile {background: {% if bg_color_gradient != blank %}{{bg_color_gradient}}{% else %}{{bg_color}}{% endif %};border: 1px solid {{border_color}}}
    .halo-sticky-toolbar-mobile .bottom-bar--list li > a > .text,
    .halo-sticky-toolbar-mobile .bottom-bar--list li > a > .icon {color: {{ color_icon }}}
    .halo-sticky-toolbar-mobile span.icon svg {fill: {{ color_icon }}}

    /* Cart badge: forced circle + centered digit (beats base/toolbar span rules) */
    .halo-sticky-toolbar-mobile .mm-toolbar-cart-bubble.cart-count-bubble {
      position: absolute !important;
      top: 0 !important;
      right: 4px !important;
      left: auto !important;
      bottom: auto !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      box-sizing: border-box !important;
      width: 18px !important;
      height: 18px !important;
      min-width: 18px !important;
      min-height: 18px !important;
      max-width: none !important;
      max-height: 18px !important;
      padding: 0 !important;
      margin: 0 !important;
      border: 0 !important;
      border-radius: 50% !important;
      overflow: hidden !important;
      background: {{ color_icon }} !important;
      color: #ffffff !important;
      font-size: 10px !important;
      font-weight: 700 !important;
      line-height: 18px !important;
      letter-spacing: 0 !important;
      text-align: center !important;
      transform: none !important;
    }
    .halo-sticky-toolbar-mobile .mm-toolbar-cart-bubble.is-empty,
    .halo-sticky-toolbar-mobile .mm-toolbar-cart-bubble[hidden] {
      display: none !important;
    }
    .halo-sticky-toolbar-mobile .mm-toolbar-cart-bubble .mm-toolbar-cart-count,
    .halo-sticky-toolbar-mobile .mm-toolbar-cart-bubble .text,
    .halo-sticky-toolbar-mobile .mm-toolbar-cart-bubble [data-cart-count] {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 100% !important;
      height: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
      border: 0 !important;
      color: #ffffff !important;
      background: transparent !important;
      font-size: 10px !important;
      font-weight: 700 !important;
      line-height: 1 !important;
      letter-spacing: 0 !important;
      text-align: center !important;
      white-space: nowrap !important;
      max-width: none !important;
      overflow: visible !important;
      text-overflow: clip !important;
    }

    .halo-sticky-toolbar-mobile .list-item--badge > a,
    .halo-sticky-toolbar-mobile a.list-item-wishlist,
    .halo-sticky-toolbar-mobile a[data-cart-sidebar],
    .halo-sticky-toolbar-mobile a.list-item-cart {
      position: relative;
    }

    .halo-sticky-toolbar-mobile .mm-toolbar-wishlist-bubble.wishlist-count-bubble {
      position: absolute !important;
      top: 0 !important;
      right: 4px !important;
      left: auto !important;
      bottom: auto !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      box-sizing: border-box !important;
      width: 18px !important;
      height: 18px !important;
      min-width: 18px !important;
      min-height: 18px !important;
      padding: 0 !important;
      margin: 0 !important;
      border: 0 !important;
      border-radius: 50% !important;
      overflow: hidden !important;
      background: {{ color_icon }} !important;
      color: #ffffff !important;
      font-size: 10px !important;
      font-weight: 700 !important;
      line-height: 18px !important;
      text-align: center !important;
      transform: none !important;
    }
    .halo-sticky-toolbar-mobile .mm-toolbar-wishlist-bubble[hidden] {
      display: none !important;
    }
    .halo-sticky-toolbar-mobile .mm-toolbar-wishlist-bubble .mm-toolbar-wishlist-count,
    .halo-sticky-toolbar-mobile .mm-toolbar-wishlist-bubble [data-wishlist-count] {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 100% !important;
      height: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
      color: #ffffff !important;
      font-size: 10px !important;
      font-weight: 700 !important;
      line-height: 1 !important;
    }
</style>
<script>
    const buttons = document.querySelectorAll('[data-bar-content]');
    if (buttons.length) {
        buttons.forEach((button) => {
            button.addEventListener('click', (event) => {
                event.preventDefault();
                if (event.target.nextSibling.classList.contains('show')) {
                    event.target.nextSibling.classList.remove('show');
                    document.querySelector('body').classList.remove('show-sidebar-content');
                } else {
                    event.target.nextSibling.classList.add('show');
                    document.querySelector('body').classList.add('show-sidebar-content');
                }
            })
        });
        document.querySelectorAll('[data-close-content-sidebar]').forEach((button) => {
            button.addEventListener('click', (event) => {
                event.target.closest('.bottom-bar--content').classList.remove('show');
            });
        })
    }
    $('body').addClass('sticky-toolbar-mobile');
</script>
{%- endif -%}

{% schema %}
{
    "name": "t:sections.sticky_toolbar_mobile.name",
    "tag": "section",
    "max_blocks": 5,
    "settings": [
    {
        "type": "checkbox",
        "id": "display_section",
        "label": "t:sections.layout.display_block",
        "default": true
    },
    {
        "type": "paragraph",
        "content": "t:sections.sticky_toolbar_mobile.settings.paragraph"
    },
    {
        "type": "range",
        "id": "font_size",
        "label": "t:settings_schema.typography.settings.font_size.label",
        "min": 8,
        "max": 20,
        "step": 1,
        "unit": "t:settings_schema.typography.settings.font_size.unit",
        "default": 12
    },
    {
        "type": "select",
        "id": "font_weight",
        "label": "t:settings_schema.typography.settings.font_weight.label",
        "default": "500",
        "options": [
        {
            "value": "400",
            "label": "t:settings_schema.typography.settings.font_weight.options__1"
        },
        {
            "value": "500",
            "label": "t:settings_schema.typography.settings.font_weight.options__2"
        },
        {
            "value": "600",
            "label": "t:settings_schema.typography.settings.font_weight.options__3"
        },
        {
            "value": "700",
            "label": "t:settings_schema.typography.settings.font_weight.options__4"
        },
        {
            "value": "800",
            "label": "t:settings_schema.typography.settings.font_weight.options__5"
        },
        {
            "value": "900",
            "label": "t:settings_schema.typography.settings.font_weight.options__6"
        }]
    },
    {
        "type": "range",
        "id": "icon_size",
        "label": "t:settings_schema.typography.settings.typography.icon_size",
        "min": 10,
        "max": 30,
        "step": 1,
        "unit": "t:settings_schema.typography.settings.font_size.unit",
        "default": 20
    },
    {
        "type": "header",
        "content": "t:settings_schema.general.name"
    },
    {
        "type" : "color",
        "id" : "color_icon",
        "label": "t:sections.sticky_toolbar_mobile.settings.color_icon",
        "default" : "#232323"
    },
    {
        "type" : "color",
        "id" : "border_color",
        "label": "t:settings_schema.colors.settings.colors_name.border_color",
        "default" : "#fff"
    },
    {
        "type" : "color",
        "id" : "bg_color",
        "label": "t:settings_schema.colors.settings.colors_name.background_color_2",
        "default" : "#fff"
    },
    {
        "type" : "color_background",
        "id" : "bg_color_gradient",
        "label": "t:settings_schema.colors.settings.colors_name.background_color_gradient"
    }
    ],
    "blocks": [
        {
            "type": "link",
            "name": "t:sections.sticky_toolbar_mobile.blocks.link.name",
            "settings": [
                {
                    "type": "liquid",
                    "id": "icon",
                    "label": "t:sections.image-banner.blocks.image.settings.content.label__17_1"
                },
                {
                    "type": "text",
                    "id": "text",
                    "label": "t:sections.image-banner.blocks.image.settings.content.label__16"
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "t:sections.image-banner.blocks.image.settings.content.label__5"
                }
            ]
        },
        {
            "type": "content",
            "name": "t:sections.sticky_toolbar_mobile.blocks.content.name",
            "settings": [
                {
                    "type": "liquid",
                    "id": "icon",
                    "label": "t:sections.image-banner.blocks.image.settings.content.label__17_1"
                },
                {
                    "type": "text",
                    "id": "text",
                    "label": "t:sections.image-banner.blocks.image.settings.content.label__16"
                },
                {
                    "type": "liquid",
                    "id": "content",
                    "label": "t:sections.image-banner.blocks.image.settings.content.label__18"
                }
            ]
        },
        {
            "type": "action",
            "name": "t:sections.sticky_toolbar_mobile.blocks.action.name",
            "settings": [
                {
                    "type": "liquid",
                    "id": "icon",
                    "label": "t:sections.image-banner.blocks.image.settings.content.label__17_1"
                },
                {
                    "type": "text",
                    "id": "text",
                    "label": "t:sections.image-banner.blocks.image.settings.content.label__16"
                },
                {
                    "type" : "select",
                    "id" : "action_to",
                    "label" : "t:sections.sticky_toolbar_mobile.blocks.action.action_to.option",
                    "options": [
                        {
                            "value": "cart",
                            "label": "t:sections.sticky_toolbar_mobile.blocks.action.action_to.option1"
                        },
                        {
                            "value": "account",
                            "label": "t:sections.sticky_toolbar_mobile.blocks.action.action_to.option2"
                        },
                        {
                            "value": "search",
                            "label": "t:sections.sticky_toolbar_mobile.blocks.action.action_to.option3"
                        },
                        {
                            "value": "wishlist",
                            "label": "Wishlist"
                        }
                    ],
                    "default": "cart"
                }
            ]
        }
    ]
}
{% endschema %}