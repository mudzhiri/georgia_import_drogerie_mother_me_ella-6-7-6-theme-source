{%- if section.settings.display_product_recently_viewed -%}
    {{ 'mm-pdp-reco-cards.css' | asset_url | stylesheet_tag }}
    {%- liquid
        assign as_grid_gap = section.settings.grid_gap
        assign grid_gap = section.settings.grid_gap | times: 0.5 | append: 'px'
        assign container = section.settings.product_recently_viewed_container
        assign limit = section.settings.product_recently_viewed_limit | at_most: 4
        assign layout = 'grid'
        assign block_title = 'products.product.recently_viewed_products' | t
        if block_title == blank or block_title == 'products.product.recently_viewed_products'
          assign block_title = section.settings.product_recently_viewed_title
        endif
        if block_title == blank
          assign block_title = 'ბოლოს ნანახი პროდუქტები'
        endif
        assign block_title_align = section.settings.product_recently_viewed_title_align
        assign image_ratio = 'square'
        assign swipe = false
        assign padding_top = section.settings.padding_top | append: 'px'
        assign padding_bottom = section.settings.padding_bottom | append: 'px'
    -%}
    <style type="text/css" media="screen">
        {%- liquid
            assign product_bg = section.settings.product_bg
            assign product_bg_gradient = section.settings.product_bg_gradient
            assign color_title = section.settings.color_title
            assign border_color_title = section.settings.border_color_title
            assign fontsize_title = section.settings.fontsize_title
            assign fontsize_title_mb = section.settings.fontsize_title_mb

            assign mg_top_title = section.settings.mg_top_title
            assign mg_bottom_title = section.settings.mg_bottom_title

            assign mg_top_desktop = section.settings.mg_top_desktop
            assign mg_top_tablet = section.settings.mg_top_tablet
            assign mg_top_mobile = section.settings.mg_top_mobile

            assign mg_bottom_desktop = section.settings.mg_bottom_desktop
            assign mg_bottom_tablet = section.settings.mg_bottom_tablet
            assign mg_bottom_mobile = section.settings.mg_bottom_mobile

            assign padding_full_width = section.settings.padding_full_width

            assign enable_border_top = section.settings.enable_border_top
            assign enable_border_bottom = section.settings.enable_border_bottom
            assign color_border_bottom = section.settings.color_border_bottom
            assign border_style = section.settings.border_style

            if section.settings.enable_layout_special
                assign bg_card = section.settings.bg_card
                assign padding_card = section.settings.padding_card
                assign border_radius_card = section.settings.border_radius_card
                assign border_width_card = section.settings.border_width_card
                assign border_color_card = section.settings.border_color_card
            endif
        -%}

        .section-block-{{section.id}},
        .section-block-{{section.id}} .halo-block-header .title .text {
            background: {% if product_bg_gradient != blank %}{{ product_bg_gradient }}{% else %}{{ product_bg }}{% endif %};
        }

        {% if enable_border_top and border_style == 'container' %}
            .section-block-{{section.id}} .halo-block-header {
                border-top: 1px solid {{ color_border_bottom }};
            }
        {% endif %} 

        {% if enable_border_bottom and border_style == 'container' %}
            .section-block-{{section.id}} .halo-block-header {
                border-bottom: 1px solid {{ color_border_bottom }};
            }
        {% endif %}

        {% if enable_border_top and border_style == 'full' %}
            .section-block-{{section.id}} {
                border-top: 1px solid {{ color_border_bottom }};
            }
        {% endif %} 

        {% if enable_border_bottom and border_style == 'full' %}
            .section-block-{{section.id}} {
                border-bottom: 1px solid {{ color_border_bottom }};
            }
        {% endif %}

        .section-block-{{section.id}} .halo-block-header .title {
            color: {{ color_title }};
            font-size: {{ fontsize_title | append: 'px'  }};
            margin-top: {{ mg_top_title | append: 'px' }};
            margin-bottom: {{ mg_bottom_title | append: 'px' }};
            /*text-transform: unset;*/
        }

        .section-block-{{section.id}} .halo-block-header .title:before {
            background-color: {{ border_color_title }};
            {% unless section.settings.enable_border_title %}
                display: none;
            {% endunless %}
        }

        {% if section.settings.enable_border_title %}
        .section-block-{{section.id}} .block-title--style2 {
            border-bottom: 1px solid {{ border_color_title }};
        }
        {% endif %}

        .section-block-{{section.id}} .block-title--style2 .title {
            padding-bottom: {{ mg_bottom_title | append: 'px' }};
        }

        {%- if section.settings.enable_layout_special -%}
            .section-block-{{section.id}} .product-item {
                background-color: {{ bg_card }};
                padding: {{ padding_card | append: 'px' }};
                border-radius: {{ border_radius_card | append: 'px' }};
                border{% unless section.settings.border_layout_card == 'full' %}-bottom{% endunless %}: {{ border_width_card | append: 'px' }} solid {{ border_color_card }}
            }
        {%- endif -%}

        /* Start: Scroll Layout */
        .section-block-{{section.id}} .products-flex {
            display: flex;
            flex-direction: row;
            flex-wrap: nowrap;
            user-select: none;
            padding-bottom: 45px;
            overflow: auto;
            overflow-y: clip;
            gap: 30px;
            padding-right: 60px;
        }

        body.layout_rtl .section-block-{{section.id}} .products-flex {
            padding-left: 60px;
            padding-right: 0;
        }

        .section-block-{{section.id}} .products-flex .product {
            flex-shrink: 0;
            flex-grow: 0;
            padding: 0;
        }

        .section-block-{{section.id}} .halo-block-content.is-scroll {
            overflow: hidden;
        }

        .section-block-{{ section.id }} .products-flex::-webkit-scrollbar {
            height: var(--scrollbar-height, 3px);
            cursor: pointer;
        }

        .section-block-{{section.id}} .products-flex::-webkit-scrollbar-track {
            background: var(--scrollbar-track-color, #dadada);
        }

        .section-block-{{section.id}} .products-flex::-webkit-scrollbar-thumb {
            background: var(--scrollbar-thumb-color, #000);
        }

        .section-block-{{section.id}} .products-flex::-webkit-scrollbar-thumb:hover {
            background: var(--scrollbar-thumb-hover-color, #333);
        }

        .section-block-{{ section.id }} .products-flex.active .product {
            pointer-events: none;
        }

        /* End: Scroll Layout */

        @media (max-width: 1024px) {
            .section-block-{{ section.id }} .products-flex {
                --count: 2!important;
                gap: 15px;
            }
            
            .section-block-{{ section.id }} .products-flex .product {
                padding: 0 7px;
            }

            .section-block-{{section.id}} .products-flex {
                scroll-snap-type: x mandatory;
                padding-bottom: 0;
                margin-left: -7px;
                margin-right: -7px;
            }
        
            .section-block-{{section.id}} .halo-product-block .products-flex .product {
                scroll-snap-align: start;
            }

            {% if container == 'fullwidth' %}
                .section-block-{{section.id}} .container-full {
                    padding-left: 15px;
                    padding-right: 15px;
                    display: block;
                }
                {% if layout == 'scroll' %}
                    .section-block-{{section.id}} .container-full {
                        padding-right: 0;
                    }
                {% endif %}
            {% endif %}
        }

        @media (max-width: 767px) {
            .section-block-{{section.id}} {
                padding-top: {{ mg_top_mobile | append: 'px' }};
                padding-bottom: {{ mg_bottom_mobile | append: 'px' }};
            }

            .section-block-{{section.id}} .halo-block-header .title {
                font-size: {{ fontsize_title_mb | append: 'px'  }};
            }

            .section-block-{{ section.id }} .products-flex .product {
                {% if show_half %}
                    flex-basis: calc(100% / calc(var(--count) - 0.3));
                    width: calc(100% / calc(var(--count) - 0.3));
                {% else %}
                    flex-basis: calc(100% / var(--count));
                    width: calc(100% / var(--count));
                {% endif %}
            }

            {% if container == 'fullwidth' %}
                .section-block-{{section.id}} .container-full {
                    padding-left: 10px;
                    padding-right: 10px;
                }
                .section-block-{{ section.id }} .products-flex {
                    --count: 1!important;
                    gap: 0px;
                    margin-left: -5px;
                    margin-right: -5px;
                }
                .section-block-{{ section.id }} .products-flex .product {
                    padding: 0 5px;
                }
                {% if layout == 'scroll' %}
                    .section-block-{{section.id}} .container-full {
                        padding-right: 0;
                    }
                {% endif %}
            {% endif %}
        }

        @media (min-width: 551px){
            .section-block-{{section.id}} .products-grid {
                margin-left: calc(var(--grid-gap) * (-1));
                margin-right: calc(var(--grid-gap) * (-1));
            }

            .section-block-{{section.id}} .products-grid .product {
                padding-right: var(--grid-gap);
                padding-left: var(--grid-gap);
                margin: 0 0 calc(var(--grid-gap) * 2) !important;
            }
        }

        @media (min-width: 1025px) {
            .section-block-{{section.id}} .products-carousel .product {
                padding-right: var(--grid-gap);
                padding-left: var(--grid-gap);
            }

            {% if container == 'fullwidth' %}
                .section-block-{{section.id}} .container-full {
                    padding-left: {{ padding_full_width | append: 'px' }};
                    padding-right: {{ padding_full_width | append: 'px' }};
                    display: block;
                }

                .section-block-{{section.id}} .products-flex {
                    padding-right: 200px;
                }
                {% if layout == 'scroll' %}
                    .section-block-{{section.id}} .container-full {
                        padding-right: 0;
                    }
                {% endif %}
            {% endif %}
        }

        @media (min-width: 768px) and (max-width: 1199px) {
            .section-block-{{section.id}} {
                padding-top: {{ mg_top_tablet | append: 'px' }};
                padding-bottom: {{ mg_bottom_tablet | append: 'px' }};
            }
        }

        @media (min-width: 768px) {
            .section-block-{{ section.id }} .products-flex .product  {
                {% if show_half %}
                    flex-basis: calc(100% / calc(var(--count) + 0.5));
                    width: calc(100% / calc(var(--count) + 0.5));
                {% else %}
                    flex-basis: calc(100% / var(--count));
                    width: calc(100% / var(--count));
                {% endif %}
            }
        }

        @media (min-width: 1200px) {
            .section-block-{{section.id}} {
                padding-top: {{ mg_top_desktop | append: 'px' }};
                padding-bottom: {{ mg_bottom_desktop | append: 'px' }};
            }
        }
    </style>
    <div
      class="halo-block halo-product-block halo-recently-viewed-block mm-pdp-reco section-block-{{ section.id }} mm-pdp-reco--pending{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}"
      id="halo-recently-viewed-block-{{ section.id }}"
      data-recently-viewed-block
      data-limit="{{ limit }}"
      data-layout="grid"
      sectionId="{{ section.id }}"
      data-image-ratio="square"
      data-swipe="false"
      data-current-handle="{{ product.handle | escape }}"
      style="--grid-gap: {{ grid_gap }}; --mm-reco-gap: {{ as_grid_gap | append: 'px' }};"
      hidden
    >
        <div class="{% if container == '1170' %}container-1170{% elsif container == '1770' %}container-1770{% elsif container == 'fullwidth'%}container-full{% else %}container{% endif %}">
            {%- if block_title != blank -%}
                <div class="halo-block-header text-{{ block_title_align }} block-title--{{ section.settings.style_block_header }}">
                    <h3 class="title">
                        <span class="text">{{ block_title | escape }}</span>
                    </h3>
                </div>
            {%- endif -%}
            <div class="halo-block-content">
                <div
                  class="recentlyViewed-row products-grid mm-pdp-reco-grid column-{{ limit }}"
                  data-products-to-show="{{ limit }}"
                  data-mm-reco-count="0"
                  id="recently-viewed-products-list-2"
                  aria-busy="false"
                  aria-live="polite"
                ></div>
            </div>
        </div>
    </div>
    <script src="{{ 'recently-viewed-product.js' | asset_url }}" defer></script>
    <script type="text/javascript">
        (function () {
            var sectionEl = document.getElementById('halo-recently-viewed-block-{{ section.id }}');
            if (!sectionEl) return;

            var limit = {{ limit }};
            var expireDay = {{ settings.recently_viewed_expire | default: 90 }};
            var currentHandle = sectionEl.getAttribute('data-current-handle') || '';
            var started = false;

            function revealOrHide(hasItems) {
                sectionEl.classList.remove('mm-pdp-reco--loading', 'mm-pdp-reco--pending');
                if (hasItems) {
                    sectionEl.classList.remove('mm-pdp-reco--empty');
                    sectionEl.removeAttribute('hidden');
                } else {
                    sectionEl.classList.add('mm-pdp-reco--empty');
                    sectionEl.setAttribute('hidden', 'hidden');
                }
            }

            function normalizeHandle(handle) {
                try {
                    handle = decodeURIComponent(String(handle || ''));
                } catch (e) {}
                return String(handle).split('?')[0].split('#')[0].replace(/^\/+|\/+$/g, '');
            }

            function startWhenReady(attempt) {
                if (!window.Shopify || !Shopify.Products || typeof Shopify.Products.recordRecentlyViewed !== 'function') {
                    if ((attempt || 0) > 120) {
                        revealOrHide(false);
                        return;
                    }
                    window.setTimeout(function () { startWhenReady((attempt || 0) + 1); }, 50);
                    return;
                }

                try {
                    Shopify.Products.recordRecentlyViewed({ howManyToStoreInMemory: 12 });
                } catch (e) {}

                var queue = [];
                try {
                    queue = typeof Shopify.Products.readHandles === 'function'
                        ? Shopify.Products.readHandles()
                        : [];
                } catch (err) {
                    revealOrHide(false);
                    return;
                }

                var seen = {};
                queue = queue.filter(function (handle) {
                    var normalized = normalizeHandle(handle);
                    if (!normalized || normalized === normalizeHandle(currentHandle)) return false;
                    if (seen[normalized]) return false;
                    seen[normalized] = true;
                    return true;
                });

                if (!queue.length) {
                    revealOrHide(false);
                    return;
                }

                if (started) return;
                started = true;

                sectionEl.classList.add('mm-pdp-reco--loading', 'ajax-loaded');
                sectionEl.classList.remove('mm-pdp-reco--empty', 'mm-pdp-reco--pending');
                sectionEl.removeAttribute('hidden');

                var list = document.getElementById('recently-viewed-products-list-2');
                var showCount = Math.min(limit, queue.length);
                if (list) {
                    list.setAttribute('aria-busy', 'true');
                    list.setAttribute('data-mm-reco-count', String(showCount));
                    list.innerHTML = '';
                    for (var i = 0; i < showCount; i++) {
                        var ph = document.createElement('div');
                        ph.className = 'product mm-pdp-reco-grid__item';
                        ph.innerHTML = '<div class="product-item product-item--loadingNoInfo" aria-hidden="true"><span class="visually-hidden">{{ 'accessibility.loading' | t }}</span></div>';
                        list.appendChild(ph);
                    }
                }

                var timeoutId = window.setTimeout(function () {
                    var ready = list && list.querySelectorAll('[data-mm-product-card]').length > 0;
                    revealOrHide(!!ready);
                }, 8000);

                Shopify.Products.showRecentlyViewed({
                    howManyToShow: showCount,
                    howManyToStoreInMemory: 12,
                    wrapperId: 'recently-viewed-products-list-2',
                    templateId: 'recently-viewed-product-block',
                    layout: 'grid',
                    swipe: false,
                    media: 'square',
                    excludeHandle: currentHandle,
                    handles: queue,
                    onComplete: function (count) {
                        window.clearTimeout(timeoutId);
                        if (list) list.setAttribute('aria-busy', 'false');
                        revealOrHide(count > 0);
                        try {
                            var cookieValue = jQuery.cookie('shopify_recently_viewed');
                            if (cookieValue) {
                                jQuery.cookie('shopify_recently_viewed', cookieValue, {
                                    expires: expireDay,
                                    path: '/'
                                });
                            }
                        } catch (e) {}
                    }
                });
            }

            document.addEventListener('mm:recently-viewed-ready', function () { startWhenReady(0); }, { once: true });
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', function () { startWhenReady(0); }, { once: true });
            } else {
                startWhenReady(0);
            }
        })();
    </script>
{%- endif -%}
{% schema %}
    {
        "name": "t:sections.product-recently-viewed.name",
        "class": "halo-recently-viewed-block-sections",
        "settings": [
            {
                "type": "header",
                "content": "t:settings_schema.general.name"
            },
            {
                "type": "checkbox",
                "id": "display_product_recently_viewed",
                "label": "t:sections.product-recently-viewed.settings.general.label__1",
                "default": true
            },
            {
                "type": "select",
                "id": "product_recently_viewed_container",
                "label": "t:sections.layout.container.option",
                "default": "container",
                "options": [
                    {
                        "value": "container",
                        "label": "t:sections.layout.container.option1"
                    },
                    {
                        "value": "1170",
                        "label": "t:sections.layout.container.option4"
                    },
                    {
                        "value": "1770",
                        "label": "t:sections.layout.container.option3"
                    },
                    {
                        "value": "fullwidth",
                        "label": "t:sections.layout.container.option2"
                    }
                ]
            },
            {
                "type": "range",
                "id": "padding_full_width",
                "label": "t:sections.layout.container.padding_full_width",
                "min": 0,
                "max": 100,
                "step": 5,
                "unit": "t:sections.layout.fontsize.fontsize_title.unit",
                "default": 0
            },
            {
                "type": "checkbox",
                "id": "enable_border_top",
                "label": "t:sections.layout.container.enable_border_top",
                "default": true
            },
            {
                "type": "checkbox",
                "id": "enable_border_bottom",
                "label": "t:sections.layout.container.enable_border_bottom",
                "default": false,
                "info": "t:sections.product_block.settings.info_banner"
            },
            {
                "type": "color",
                "id": "color_border_bottom",
                "label": "t:settings_schema.colors.settings.colors_name.border_color",
                "default": "#e8e8e8"
            },
            {
                "type": "select",
                "id": "border_style",
                "label": "t:sections.product_block.settings.layout_card.border_layout_card.option",
                "default": "container",
                "options": [
                {
                    "value": "container",
                    "label": "t:sections.layout.container.option1"
                },
                {
                    "value": "full",
                    "label": "t:settings_schema.product_card.settings.product_title.options__13"
                }]
            },
            {
                "type": "header",
                "content": "t:sections.layout.margin_top"
            },
            {
                "type": "range",
                "id": "mg_top_desktop",
                "label": "t:sections.layout.mg_desktop.label",
                "min": 0,
                "max": 100,
                "step": 5,
                "unit": "t:sections.layout.mg_desktop.unit",
                "default": 80
            },
            {
                "type": "range",
                "id": "mg_top_tablet",
                "label": "t:sections.layout.mg_tablet.label",
                "min": 0,
                "max": 100,
                "step": 5,
                "unit": "t:sections.layout.mg_desktop.unit",
                "default": 50
            },
            {
                "type": "range",
                "id": "mg_top_mobile",
                "label": "t:sections.layout.mg_mobile.label",
                "min": 0,
                "max": 100,
                "step": 5,
                "unit": "t:sections.layout.mg_desktop.unit",
                "default": 30
            },
            {
                "type": "header",
                "content": "t:sections.layout.margin_bottom"
            },
            {
                "type": "range",
                "id": "mg_bottom_desktop",
                "label": "t:sections.layout.mg_desktop.label",
                "min": 0,
                "max": 100,
                "step": 5,
                "unit": "t:sections.layout.mg_desktop.unit",
                "default": 80
            },
            {
                "type": "range",
                "id": "mg_bottom_tablet",
                "label": "t:sections.layout.mg_tablet.label",
                "min": 0,
                "max": 100,
                "step": 5,
                "unit": "t:sections.layout.mg_desktop.unit",
                "default": 50
            },
            {
                "type": "range",
                "id": "mg_bottom_mobile",
                "label": "t:sections.layout.mg_mobile.label",
                "min": 0,
                "max": 100,
                "step": 5,
                "unit": "t:sections.layout.mg_desktop.unit",
                "default": 30
            },
            {
                "type": "select",
                "id": "product_recently_viewed_layout",
                "label": "t:sections.product-recently-viewed.settings.general.label__5",
                "options": [
                {
                    "value": "grid",
                    "label": "t:sections.product_block.settings.general.options__5"
                },
                {
                    "value": "slider",
                    "label": "t:sections.product_block.settings.general.options__6"
                },
                {
                    "value": "scroll",
                    "label": "t:sections.product_block.settings.product_block_layout.option3"
                }],
                "default": "slider"
            },
            {
                "type" : "color",
                "id" : "product_bg",
                "label": "t:settings_schema.colors.settings.colors_name.background_color",
                "default" : "#fff"
            },
            {
                "type" : "color_background",
                "id" : "product_bg_gradient",
                "label": "t:settings_schema.colors.settings.colors_name.background_color_gradient"
            },
            {
                "type": "select",
                "id": "style_block_header",
                "label": "t:settings_schema.typography.settings.typography.select_style",
                "options": [
                {
                    "value": "style1",
                    "label": "t:settings_schema.typography.settings.typography.style_1"
                },
                {
                    "value": "style2",
                    "label": "t:settings_schema.typography.settings.typography.style_2"
                },
                {
                    "value": "style3",
                    "label": "t:settings_schema.typography.settings.typography.style_3"
                }],
                "default": "style1"
            },
            {
                "type": "text",
                "id": "product_recently_viewed_title",
                "label": "t:sections.product-recently-viewed.settings.general.label__6",
                "default": "ბოლოს ნანახი პროდუქტები"
            },
            {
                "type": "checkbox",
                "id": "enable_border_title",
                "label": "t:settings_schema.typography.settings.typography.title_enable_border",
                "default": false
            },
            {
                "type": "range",
                "id": "mg_top_title",
                "label": "t:settings_schema.typography.settings.typography.title_margin_top",
                "min": 0,
                "max": 50,
                "step": 1,
                "unit": "t:sections.layout.mg_desktop.unit",
                "default": 22
            },
            {
                "type": "range",
                "id": "mg_bottom_title",
                "label": "t:settings_schema.typography.settings.typography.title_margin_bottom",
                "min": 0,
                "max": 50,
                "step": 1,
                "unit": "t:sections.layout.mg_desktop.unit",
                "default": 12
            },
            {
                "type": "range",
                "id": "fontsize_title",
                "label": "t:settings_schema.typography.settings.typography.title_font_size",
                "min": 10,
                "max": 100,
                "step": 1,
                "unit": "t:sections.layout.fontsize.fontsize_title.unit",
                "default": 16
            },
            {
                "type": "range",
                "id": "fontsize_title_mb",
                "label": "t:settings_schema.typography.settings.typography.title_font_size_mb",
                "min": 10,
