{{ 'mm-collection-filters.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign is_search = false
  assign default_sort_by = ''
  assign mm_sort_redirect = ''
  if request.page_type == 'search'
    assign is_search = true
    assign results_url = routes.search_url
    assign default_sort_by = search.default_sort_by
    assign sort_by = search.sort_by | default: search.default_sort_by
    assign sort_options = search.sort_options
    assign filter_list = search.filters
    assign results_count = search.results_count
    assign search_q = search.terms | url_encode
    assign clear_url = routes.search_url | append: '?q=' | append: search_q | append: '&type=product&options%5Bprefix%5D=last'
  else
    assign results_url = collection.url
    assign default_sort_by = collection.default_sort_by
    assign sort_by = collection.sort_by | default: collection.default_sort_by
    assign sort_options = collection.sort_options
    assign filter_list = collection.filters
    assign results_count = collection.products_count
    assign clear_url = collection.url
  endif

  # Prefer explicit URL sort so clear/chip actions never drop the customer choice.
  if request.params.sort_by != blank
    assign sort_by = request.params.sort_by
  endif

  # If no curated default and the URL has no sort_by, redirect once to created-descending.
  # Do not overwrite sort_by used for the dropdown when an explicit sort is already applied.
  assign has_sort_param = false
  if request.query_string contains 'sort_by='
    assign has_sort_param = true
  endif
  if is_search == false and has_sort_param == false
    if default_sort_by == 'manual' or default_sort_by == 'created-descending' or default_sort_by == 'price-ascending' or default_sort_by == 'price-descending'
      assign mm_sort_redirect = ''
    else
      assign mm_sort_redirect = 'created-descending'
    endif
  endif

  # Preserve current sort when clearing filters (never strip sort_by).
  assign sort_for_clear = sort_by
  if sort_for_clear == blank and mm_sort_redirect != blank
    assign sort_for_clear = mm_sort_redirect
  endif
  if sort_for_clear != blank
    if clear_url contains '?'
      assign clear_url = clear_url | append: '&sort_by=' | append: sort_for_clear
    else
      assign clear_url = clear_url | append: '?sort_by=' | append: sort_for_clear
    endif
  endif

  assign total_active = 0
  for filter in filter_list
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign total_active = total_active | plus: 1
      endif
    else
      assign total_active = total_active | plus: filter.active_values.size
    endif
  endfor

  assign has_filters = false
  if filter_list.size > 0
    assign has_filters = true
  endif

  assign mm_has_vendor_filter = false
  assign mm_has_type_filter = false
  assign mm_has_age_filter = false
  for filter in filter_list
    assign mm_fp = filter.param_name | downcase
    if mm_fp contains 'vendor'
      assign mm_has_vendor_filter = true
    elsif mm_fp contains 'product_type' or mm_fp contains 'product-type'
      assign mm_has_type_filter = true
    elsif mm_fp contains 'age'
      assign mm_has_age_filter = true
    endif
  endfor

  assign mm_category_menu = section.settings.category_menu
  assign mm_show_category_nav = true
  if is_search
    assign mm_show_category_nav = false
  endif

  assign currencies_using_comma_decimals = 'ANG,ARS,BRL,BYN,BYR,CLF,CLP,COP,CRC,CZK,DKK,EUR,HRK,HUF,IDR,ISK,MZN,NOK,PLN,RON,RUB,SEK,UYU,VES,VND' | split: ','
  assign uses_comma_decimals = false
  if currencies_using_comma_decimals contains cart.currency.iso_code
    assign uses_comma_decimals = true
  endif
  assign shop_money_format = 'amount'
  if shop.money_format contains 'amount_with_comma_separator'
    assign shop_money_format = 'amount_with_comma_separator'
  elsif shop.money_format contains 'amount_no_decimals_with_comma_separator'
    assign shop_money_format = 'amount_no_decimals_with_comma_separator'
  elsif shop.money_format contains 'amount_with_apostrophe_separator'
    assign shop_money_format = 'amount_with_apostrophe_separator'
  elsif shop.money_format contains 'amount_no_decimals'
    assign shop_money_format = 'amount_no_decimals'
  endif

  assign mm_filters_render = true
  if is_search
    if search.performed == false
      assign mm_filters_render = false
    elsif search.results_count == 0 and total_active == 0
      assign mm_filters_render = false
    endif
  endif
-%}

{%- if mm_sort_redirect != blank -%}
  <script>
    (function () {
      try {
        var u = new URL(window.location.href);
        if (!u.searchParams.get('sort_by')) {
          u.searchParams.set('sort_by', {{ mm_sort_redirect | json }});
          window.location.replace(u.toString());
        }
      } catch (e) {}
    })();
  </script>
{%- endif -%}

{%- if mm_filters_render -%}
<div
  id="mm-filters-{{ section.id }}"
  class="mm-filters"
  data-mm-filters
  data-mm-section-id="{{ section.id }}"
  data-mm-results-url="{{ results_url }}"
  data-mm-is-search="{% if is_search %}true{% else %}false{% endif %}"
  data-mm-loading-label="{{ 'sections.collection_template.loading' | t | escape }}"
  {% if mm_sort_redirect != blank %}data-mm-sort-default="{{ mm_sort_redirect | escape }}"{% endif %}
>
  <div class="mm-filters__inner">
    <div class="mm-filters__bar">
      <p class="mm-filters__count" role="status" data-mm-filters-count>
        {{ 'sections.collection_template.product_count_simple' | t: count: results_count }}
      </p>

      <div class="mm-filters__mobile-actions">
        {%- if has_filters or mm_show_category_nav -%}
          <button
            type="button"
            class="mm-filters__btn"
            data-mm-filters-open
            aria-expanded="false"
            aria-controls="mm-filters-panel-{{ section.id }}"
          >
            {{ 'sections.collection_template.filter_button' | t }}
            {%- if total_active > 0 -%}
              <span class="mm-filters__btn-badge" data-mm-filters-badge>{{ total_active }}</span>
            {%- endif -%}
          </button>
        {%- endif -%}

        <form method="get" action="{{ results_url }}" class="mm-filters__sort mm-filters__sort--mobile" data-mm-filters-sort-form>
          {%- if is_search -%}
            <input type="hidden" name="q" value="{{ search.terms | escape }}">
            <input type="hidden" name="type" value="product">
            <input type="hidden" name="options[prefix]" value="last">
          {%- endif -%}
          {%- for filter in filter_list -%}
            {%- for value in filter.active_values -%}
              <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
            {%- endfor -%}
            {%- if filter.type == 'price_range' -%}
              {%- render 'mm-filters-price-hidden', filter: filter, uses_comma_decimals: uses_comma_decimals, shop_money_format: shop_money_format -%}
            {%- endif -%}
          {%- endfor -%}
          <label class="mm-filters__btn mm-filters__sort-trigger" for="mm-sort-mobile-{{ section.id }}">
            <span class="mm-filters__sort-trigger-label">{{ 'sections.collection_template.sort_button' | t }}</span>
            <select
              id="mm-sort-mobile-{{ section.id }}"
              class="mm-filters__select mm-filters__select--overlay"
              name="sort_by"
              data-mm-filters-sort
              aria-label="{{ 'sections.collection_template.sort_button' | t | escape }}"
            >
              {%- render 'mm-filters-sort-options', sort_options: sort_options, sort_by: sort_by, default_sort_by: default_sort_by, is_search: is_search -%}
            </select>
          </label>
        </form>
      </div>
    </div>

    {%- if request.design_mode -%}
      <div class="mm-filters__admin-note" role="note">
        <p class="mm-filters__admin-note-title">MOTHER &amp; ME — Filter setup</p>
        <ul>
          <li>Brand filter (Vendor): {% if mm_has_vendor_filter %}active{% else %}<strong>missing</strong> — enable in Search &amp; Discovery → Filters → Vendor / Brand{% endif %}</li>
          <li>Product type filter: {% if mm_has_type_filter %}active{% else %}<strong>missing</strong> — enable Product type in Search &amp; Discovery{% endif %}</li>
          <li>Age filter: {% if mm_has_age_filter %}active{% else %}not ready — create metafield <code>custom.age_recommendation</code>, curate products, then enable in S&amp;D{% endif %}</li>
          <li>Price filter: available when Search &amp; Discovery exposes it</li>
          <li>Category navigation uses real collection links (not a fake in-page filter)</li>
        </ul>
      </div>
    {%- endif -%}

    <div class="mm-filters__toolbar">
      <p class="mm-filters__count mm-filters__count--desktop" role="status" data-mm-filters-count-desktop>
        {{ 'sections.collection_template.product_count_simple' | t: count: results_count }}
      </p>

      {%- if has_filters or mm_show_category_nav -%}
        <form
          method="get"
          action="{{ results_url }}"
          class="mm-filters__desktop"
          data-mm-filters-desktop-form
        >
          {%- if is_search -%}
            <input type="hidden" name="q" value="{{ search.terms | escape }}">
            <input type="hidden" name="type" value="product">
            <input type="hidden" name="options[prefix]" value="last">
          {%- endif -%}
          <input type="hidden" name="sort_by" value="{{ sort_by | escape }}" data-mm-desktop-sort>

          <div class="mm-filters__groups mm-filters__groups--toolbar">
            {%- if mm_show_category_nav -%}
              {% render 'mm-filters-category-nav',
                category_menu: mm_category_menu,
                filter_list: filter_list,
                sort_for_clear: sort_for_clear,
                is_search: is_search,
                collection: collection
              %}
            {%- endif -%}
            {% render 'mm-filters-groups',
              filter_list: filter_list,
              section: section,
              id_prefix: 'mm-filter-price',
              uses_comma_decimals: uses_comma_decimals,
              shop_money_format: shop_money_format,
              results_count: results_count
            %}
          </div>
        </form>
      {%- endif -%}

      {%- if sort_options.size > 0 -%}
        <form method="get" action="{{ results_url }}" class="mm-filters__sort mm-filters__sort--desktop" data-mm-filters-sort-form>
          {%- if is_search -%}
            <input type="hidden" name="q" value="{{ search.terms | escape }}">
            <input type="hidden" name="type" value="product">
            <input type="hidden" name="options[prefix]" value="last">
          {%- endif -%}
          {%- for filter in filter_list -%}
            {%- for value in filter.active_values -%}
              <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
            {%- endfor -%}
            {%- if filter.type == 'price_range' -%}
              {%- render 'mm-filters-price-hidden', filter: filter, uses_comma_decimals: uses_comma_decimals, shop_money_format: shop_money_format -%}
            {%- endif -%}
          {%- endfor -%}
          <label class="mm-filters__sort-label" for="mm-sort-desktop-{{ section.id }}">
            {{ 'sections.collection_template.sort_by_label' | t }}
          </label>
          <select
            id="mm-sort-desktop-{{ section.id }}"
            class="mm-filters__select"
            name="sort_by"
            data-mm-filters-sort
            aria-label="{{ 'sections.collection_template.sort_by_label' | t | escape }}"
          >
            {%- render 'mm-filters-sort-options', sort_options: sort_options, sort_by: sort_by, default_sort_by: default_sort_by, is_search: is_search -%}
          </select>
        </form>
      {%- endif -%}
    </div>

    {%- if total_active > 0 -%}
      <ul class="mm-filters__chips" role="list" data-mm-filters-chips>
        {%- for filter in filter_list -%}
          {%- liquid
            assign chip_param = filter.param_name | downcase
          -%}
          {%- for value in filter.active_values -%}
            {%- liquid
              assign chip_label = value.label
              if chip_param contains 'availability'
                if value.value == '1' or value.label contains 'In stock' or value.label == 'In stock'
                  assign chip_label = 'sections.collection_template.in_stock' | t
                elsif value.value == '0' or value.label contains 'Out of stock' or value.label == 'Out of stock'
                  assign chip_label = 'sections.collection_template.out_of_stock' | t
                endif
              endif
              assign chip_href = value.url_to_remove
              if sort_for_clear != blank
                unless chip_href contains 'sort_by='
                  if chip_href contains '?'
                    assign chip_href = chip_href | append: '&sort_by=' | append: sort_for_clear
                  else
                    assign chip_href = chip_href | append: '?sort_by=' | append: sort_for_clear
                  endif
                endunless
              endif
            -%}
            <li>
              <a
                class="mm-filters__chip"
                href="{{ chip_href }}"
                aria-label="{{ 'sections.collection_template.clear' | t | escape }}: {{ chip_label | escape }}"
              >
                <span>{{ chip_label | escape }}</span>
                <span class="mm-filters__chip-x" aria-hidden="true">×</span>
              </a>
            </li>
          {%- endfor -%}
          {%- if filter.type == 'price_range' -%}
            {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
              {%- liquid
                assign chip_href = filter.url_to_remove
                if sort_for_clear != blank
                  unless chip_href contains 'sort_by='
                    if chip_href contains '?'
                      assign chip_href = chip_href | append: '&sort_by=' | append: sort_for_clear
                    else
                      assign chip_href = chip_href | append: '?sort_by=' | append: sort_for_clear
                    endif
                  endunless
                endif
              -%}
              <li>
                {%- capture price_chip_label -%}
                  {%- if filter.min_value.value -%}{{ filter.min_value.value | money }}{%- else -%}{{ 0 | money }}{%- endif -%}
                  –
                  {%- if filter.max_value.value -%}{{ filter.max_value.value | money }}{%- else -%}{{ filter.range_max | money }}{%- endif -%}
                {%- endcapture -%}
                <a
                  class="mm-filters__chip"
                  href="{{ chip_href }}"
                  aria-label="{{ 'sections.collection_template.clear' | t | escape }}: {{ price_chip_label | strip | escape }}"
                >
                  <span>{{ price_chip_label | strip }}</span>
                  <span class="mm-filters__chip-x" aria-hidden="true">×</span>
                </a>
              </li>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        <li>
          <a class="mm-filters__reset" href="{{ clear_url }}" data-mm-filters-reset>
            {{ 'sections.collection_template.clear_all' | t }}
          </a>
        </li>
      </ul>
    {%- endif -%}

    {%- if results_count == 0 -%}
      <div class="mm-filters__empty" role="status" data-mm-filters-empty>
        <p style="margin:0 0 8px;">
          {%- if total_active > 0 -%}
            {{ 'sections.collection_template.empty_with_filters' | t }}
          {%- else -%}
            {{ 'sections.collection_template.empty' | t }}
          {%- endif -%}
        </p>
        {%- if total_active > 0 -%}
          <a class="mm-filters__reset" href="{{ clear_url }}">
            {{ 'sections.collection_template.reset_filters' | t }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if has_filters or mm_show_category_nav -%}
    <div class="mm-filters__overlay" data-mm-filters-overlay></div>
    <aside
      id="mm-filters-panel-{{ section.id }}"
      class="mm-filters__panel"
      data-mm-filters-panel
      aria-hidden="true"
      aria-labelledby="mm-filters-panel-title-{{ section.id }}"
    >
      <div class="mm-filters__panel-header">
        <h2 id="mm-filters-panel-title-{{ section.id }}" class="mm-filters__panel-title">
          {{ 'sections.collection_template.filter_button' | t }}
        </h2>
        <button
          type="button"
          class="mm-filters__panel-close"
          data-mm-filters-close
          aria-label="{{ 'accessibility.close' | t | escape }}"
        >
          ×
        </button>
      </div>

      <form
        method="get"
        action="{{ results_url }}"
        class="mm-filters__panel-body"
        data-mm-filters-panel-form
        id="mm-filters-panel-form-{{ section.id }}"
      >
        {%- if is_search -%}
          <input type="hidden" name="q" value="{{ search.terms | escape }}">
          <input type="hidden" name="type" value="product">
          <input type="hidden" name="options[prefix]" value="last">
        {%- endif -%}
        <input type="hidden" name="sort_by" value="{{ sort_by | escape }}" data-mm-panel-sort>

        <div class="mm-filters__groups mm-filters__groups--panel">
          {%- if mm_show_category_nav -%}
            {% render 'mm-filters-category-nav',
              category_menu: mm_category_menu,
              filter_list: filter_list,
              sort_for_clear: sort_for_clear,
              is_search: is_search,
              collection: collection
            %}
          {%- endif -%}
          {% render 'mm-filters-groups',
            filter_list: filter_list,
            section: section,
            id_prefix: 'mm-filter-price-panel',
            uses_comma_decimals: uses_comma_decimals,
            shop_money_format: shop_money_format,
            results_count: results_count
          %}
        </div>
      </form>

      <div class="mm-filters__panel-footer">
        {%- if total_active > 0 -%}
          <a class="mm-filters__btn" href="{{ clear_url }}" data-mm-filters-reset>
            {{ 'sections.collection_template.clear_all' | t }}
          </a>
        {%- endif -%}
        <button
          type="submit"
          class="mm-filters__btn mm-filters__btn--primary"
          form="mm-filters-panel-form-{{ section.id }}"
          data-mm-filters-apply
        >
          {{ 'sections.collection_template.filter_apply' | t }}
        </button>
      </div>
    </aside>
  {%- endif -%}

  <div class="mm-filters__loading" data-mm-filters-loading hidden aria-live="polite">
    {{ 'sections.collection_template.loading' | t }}
  </div>
  <div class="mm-filters__error" data-mm-filters-error hidden role="alert">
    <p class="mm-filters__error-text">{{ 'sections.collection_template.load_error' | t }}</p>
    <button type="button" class="mm-filters__btn" data-mm-filters-retry>
      {{ 'sections.collection_template.load_retry' | t }}
    </button>
  </div>
</div>

<script src="{{ 'mm-collection-filters.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "MM Collection Filters",
  "tag": "section",
  "class": "section-mm-collection-filters",
  "settings": [
    {
      "type": "paragraph",
      "content": "Brand / product type / age appear only after Search & Discovery exposes them. Category uses real collection links."
    },
    {
      "type": "link_list",
      "id": "category_menu",
      "label": "Category menu (collections)",
      "info": "Optional. Leave empty to use curated collections that currently have products. Links navigate to real collections (not client-side hiding)."
    }
  ]
}
{% endschema %}
